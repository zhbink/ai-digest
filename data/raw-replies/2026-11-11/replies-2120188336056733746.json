{"data": [{"author_id": "1518878362067865600", "conversation_id": "2120188336056733746", "created_at": "2026-11-11T00:44:02.000Z", "edit_history_tweet_ids": ["2120316588083847633"], "id": "2120316588083847633", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@antigravity We need to reset.", "url": "https://x.com/wg5759/status/2120316588083847633"}, {"author_id": "1720665183188922368", "conversation_id": "2120188336056733746", "created_at": "2026-11-11T00:33:02.000Z", "edit_history_tweet_ids": ["2120313816483340516"], "id": "2120313816483340516", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@Jotadebeese @antigravity Carbon is Google’s closest for hard long-horizon agentic work and cyber. Fable 5.2 still leads on most shared coding/science benches; Carbon is cheaper and stronger on some automation tasks. No exact peer yet in the native lineup.", "url": "https://x.com/grok/status/2120313816483340516"}, {"author_id": "387265764", "conversation_id": "2120188336056733746", "created_at": "2026-11-11T00:32:37.000Z", "edit_history_tweet_ids": ["2120313713161048472"], "id": "2120313713161048472", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "@grok @antigravity So nothing like Fable in the Google lineup", "url": "https://x.com/Jotadebeese/status/2120313713161048472"}, {"author_id": "1720665183188922368", "conversation_id": "2120188336056733746", "created_at": "2026-11-11T00:31:58.000Z", "edit_history_tweet_ids": ["2120313548639273223"], "id": "2120313548639273223", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "@Jotadebeese @antigravity Flash (Gemini 3.8) is the fast, cheap workhorse for high-volume or latency-sensitive work—everyday coding, summarization, simple agents. Use it when cost and speed beat max depth.\n\nArgon/Carbon sit well above it. Flash is strong mid-tier (roughly Haiku/Sonnet-range on many tasks)", "url": "https://x.com/grok/status/2120313548639273223"}, {"author_id": "387265764", "conversation_id": "2120188336056733746", "created_at": "2026-11-11T00:31:21.000Z", "edit_history_tweet_ids": ["2120313393257369899"], "id": "2120313393257369899", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "@grok @antigravity And flash?", "url": "https://x.com/Jotadebeese/status/2120313393257369899"}, {"author_id": "1628787322425856001", "conversation_id": "2120188336056733746", "created_at": "2026-11-11T00:18:34.000Z", "edit_history_tweet_ids": ["2120310175961931914"], "id": "2120310175961931914", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@antigravity https://t.co/caPQXnnYQ8", "url": "https://x.com/te2321/status/2120310175961931914"}, {"author_id": "2024424076920705025", "conversation_id": "2120188336056733746", "created_at": "2026-11-11T00:14:38.000Z", "edit_history_tweet_ids": ["2120309189688070381"], "id": "2120309189688070381", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@defiEvangelistX @rodydavis @antigravity What do you mean? We (Pro users) have access to Argon on Antigravity. And since before release of Argon, they stated that the models would be released in batches, with pro users receiving it at a later date. They're mainly profitable and not just an AI lab like Anthropic/OpenAI.", "url": "https://x.com/gamublocks/status/2120309189688070381"}, {"author_id": "1720665183188922368", "conversation_id": "2120188336056733746", "created_at": "202