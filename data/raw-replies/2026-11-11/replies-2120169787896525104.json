{"data": [{"author_id": "1613787870162214913", "created_at": "2026-11-11T00:40:43.000Z", "edit_history_tweet_ids": ["2120315749969408087"], "id": "2120315749969408087", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind Un robot que dobla ropa. Por fin alguien en mi casa que va a hacerlo.", "url": "https://x.com/raeldiazoficial/status/2120315749969408087"}, {"author_id": "1623947073761710080", "created_at": "2026-11-11T00:40:17.000Z", "edit_history_tweet_ids": ["2120315641454633432"], "id": "2120315641454633432", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind A robot that folds laundry AND sorts car parts is the first AI demo that actually speaks to my daily life. We've had chatbots for years — a robot that does the chores is the real AGI milestone.", "url": "https://x.com/Michaelxi282/status/2120315641454633432"}, {"author_id": "1362258253686714369", "created_at": "2026-11-11T00:29:34.000Z", "edit_history_tweet_ids": ["2120312945989296626"], "id": "2120312945989296626", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind this is wild. look how smooth and precise each and every movement is", "url": "https://x.com/subinternal_/status/2120312945989296626"}, {"author_id": "952976175374123008", "created_at": "2026-11-11T00:28:14.000Z", "edit_history_tweet_ids": ["2120312609383837720"], "id": "2120312609383837720", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 31, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind Folding the fitted sheet is the final boss.", "url": "https://x.com/OfficialXYO/status/2120312609383837720"}, {"author_id": "263606970", "created_at": "2026-11-11T00:21:54.000Z", "edit_history_tweet_ids": ["2120311018379415642"], "id": "2120311018379415642", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind The jump from demo skills to factory-floor sorting is the real signal here — laundry folding is a nice demo, but reliable part-sorting under real-world variation is where physical AI either earns its keep or stalls. Curious how much transfers to unseen objects without retraining.", "url": "https://x.com/minimaniwo/status/2120311018379415642"}, {"author_id": "2106840589211987968", "created_at": "2026-11-11T00:04:06.000Z", "edit_history_tweet_ids": ["2120306535134077242"], "id": "2120306535134077242", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind The 96% on a live Mercedes-Benz line is the number that matters most here. Curious how the 30-100% success gain holds up outside kitting tasks.", "url": "https://x.com/HiSuperbot/status/2120306535134077242"}, {"author_id": "989965718", "created_at": "2026-11-10T23:56:33.000Z", "edit_history_tweet_ids": ["2120304635496046798"], "id": "2120304635496046798", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind The 96% pick-and-pack success on Mercedes-Benz production lines is the number I'd watch. Real factory floors are messy, so that's a more honest test than any demo.", "url": "https://x.com/killerdeals24/status/2120304635496046798"}, {"author_id": "2102222656292454400", "created_at": "2026-11-10T23:39:29.000Z", "edit_history_tweet_ids": ["2120300343477096954"], "id": "2120300343477096954", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind laundry folding is cute but the Mercedes test is the real one. Apollo 2 kitting parts at 96% accuracy on Gemini Robotics 2.5. factories are where this gets paid", "url": "https://x.com/StevenonTech/status/2120300343477096954"}, {"author_id": "2679755647", "created_at": "2026-11-10T23:10:19.000Z", "edit_history_tweet_ids": ["2120293001100448131"], "id": "2120293001100448131", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 58, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind folding laundry is the real AGI test", "url": "https://x.com/bingbro619809/status/2120293001100448131"}, {"author_id": "1500400160337235968", "created_at": "2026-11-10T23:05:47.000Z", "edit_history_tweet_ids": ["2120291860069712298"], "id": "2120291860069712298", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind Building a digital twin from a single camera view looks clean until the robot meets unobservable physics.\n\nA monocular RGB feed can't measure mass distribution, friction coefficients, or occluded geometry training checkpoints on guessed physics just scales Sim2Real drift.", "url": "https://x.com/OLeisgen/status/2120291860069712298"}, {"author_id": "1985426182603681792", "created_at": "2026-11-10T22:55:40.000Z", "edit_history_tweet_ids": ["2120289315788116249"], "id": "2120289315788116249", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind Nice", "url": "https://x.com/abhiindx_sahu/status/2120289315788116249"}, {"author_id": "757940114949537792", "created_at": "2026-11-10T22:51:26.000Z", "edit_history_tweet_ids": ["2120288250917216332"], "id": "2120288250917216332", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind The Apptronik and Mercedes-Benz proof of concept in this thread has the Apollo 2 robot picking and organizing car parts for assembly with 96% accuracy.", "url": "https://x.com/sulaiman_svesal/status/2120288250917216332"}, {"author_id": "1991210188578467840", "created_at": "2026-11-10T22:50:16.000Z", "edit_history_tweet_ids": ["2120287955097182645"], "id": "2120287955097182645", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind Hundreds of skills is impressive, but the factory demo is the one to watch, since a home robot can fumble a towel and a parts line can't afford a miss. If this holds up, what's the success rate per task once it's off the demo floor?", "url": "https://x.com/viral_warden/status/2120287955097182645"}, {"author_id": "72022803", "created_at": "2026-11-10T22:21:26.000Z", "edit_history_tweet_ids": ["2120280701220082019"], "id": "2120280701220082019", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2114671147736277036", "type": "quoted"}, {"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind 96% sounds great until you chain steps… if each step of a job works 96% of the time, ten in a row come out clean about 66% of the time (0.96^10).\nDeepMind's Kanishka Rao told Ars that closing the last 4% is a \"steep road\". I did the same maths for Starship's 33 engines, and why https://t.co/KIUkDc9zcn", "url": "https://x.com/mikejt4/status/2120280701220082019"}, {"author_id": "1689098925159149569", "created_at": "2026-11-10T22:17:33.000Z", "edit_history_tweet_ids": ["2120279724576616458"], "id": "2120279724576616458", "in_reply_to_user_id": "4783690002", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120169787896525104", "type": "replied_to"}], "text": "@GoogleDeepMind I tried Gemini Robotics 2.5 with a simple task of sorting objects by color. It took 20 minutes to learn, which is way faster than my previous experience with similar models.", "url": "https://x.com/chengfu588728/status/2120279724576616458"}], "includes": {"users": [{"id": "1613787870162214913", "name": "Daniel Diaz", "public_metrics": {"followers_count": 779, "following_count": 26, "like_count": 167, "listed_count": 0, "media_count": 20, "tweet_count": 215}, "username": "raeldiazoficial"}, {"id": "1623947073761710080", "name": "X Raid Leader", "public_metrics": {"followers_count": 2216, "following_count": 2745, "like_count": 92, "listed_count": 2, "media_count": 529, "tweet_count": 9812}, "username": "Michaelxi282"}, {"id": "1362258253686714369", "name": "subinternal", "public_metrics": {"followers_count": 8, "following_count": 44, "like_count": 28, "listed_count": 0, "media_count": 2, "tweet_count": 22}, "username": "subinternal_"}, {"id": "952976175374123008", "name": "XYO", "public_metrics": {"followers_count": 190988, "following_count": 635, "like_count": 18611, "listed_count": 366, "media_count": 4023, "tweet_count": 11667}, "username": "OfficialXYO"}, {"id": "263606970", "name": "jingyanzhang", "public_metrics": {"followers_count": 0, "following_count": 0, "like_count": 19, "listed_count": 0, "media_count": 13, "tweet_count": 36}, "username": "minimaniwo"}, {"id": "2106840589211987968", "name": "Superbot", "public_metrics": {"followers_count": 43, "following_count": 198, "like_count": 1, "listed_count": 0, "media_count": 7, "tweet_count": 218}, "username": "HiSuperbot"}, {"id": "989965718", "name": "Skeptical Optimist", "public_metrics": {"followers_count": 529, "following_count": 1438, "like_count": 43869, "listed_count": 4, "media_count": 229, "tweet_count": 7581}, "username": "killerdeals24"}, {"id": "2102222656292454400", "name": "steven", "public_metrics": {"followers_count": 4, "following_count": 23, "like_count": 0, "listed_count": 0, "media_count": 2, "tweet_count": 21}, "username": "StevenonTech"}, {"id": "2679755647", "name": "Austin Z.", "public_metrics": {"followers_count": 91, "following_count": 1161, "like_count": 454, "listed_count": 1, "media_count": 21, "tweet_count": 276}, "username": "bingbro619809"}, {"id": "1500400160337235968", "name": "Oliver Leisgen", "public_metrics": {"followers_count": 0, "following_count": 37, "like_count": 3, "listed_count": 0, "media_count": 1, "tweet_count": 42}, "username": "OLeisgen"}, {"id": "1985426182603681792", "name": "Abhishek Sahu", "public_metrics": {"followers_count": 103, "following_count": 835, "like_count": 12518, "listed_count": 0, "media_count": 5, "tweet_count": 19252}, "username": "abhiindx_sahu"}, {"id": "757940114949537792", "name": "Sulaiman Vesal", "public_metrics": {"followers_count": 159, "following_count": 292, "like_count": 267, "listed_count": 2, "media_count": 86, "tweet_count": 739}, "username": "sulaiman_svesal"}, {"id": "1991210188578467840", "name": "Viral Warden", "public_metrics": {"followers_count": 112, "following_count": 85, "like_count": 17, "listed_count": 6, "media_count": 1014, "tweet_count": 2754}, "username": "viral_warden"}, {"id": "72022803", "name": "Michael Tomlinson", "public_metrics": {"followers_count": 2547, "following_count": 3978, "like_count": 129858, "listed_count": 16, "media_count": 1366, "tweet_count": 13827}, "username": "mikejt4"}, {"id": "1689098925159149569", "name": "豆腐熊猫 tofupanda.ai", "public_metrics": {"followers_count": 68, "following_count": 378, "like_count": 65, "listed_count": 0, "media_count": 54, "tweet_count": 861}, "username": "chengfu588728"}]}, "meta": {"newest_id": "2120315749969408087", "next_token": "b26v89c19zqg8o3juzovc24xcvlbap3gadfgmna25g1a5", "oldest_id": "2120279724576616458", "result_count": 15}}