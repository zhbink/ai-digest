": {"followers_count": 1679, "following_count": 148, "like_count": 107, "listed_count": 0, "media_count": 27, "tweet_count": 220}, "username": "summer_ikiki_"}, {"id": "2108739599594070016", "name": "JunRu", "public_metrics": {"followers_count": 0, "following_count": 0, "like_count": 0, "listed_count": 0, "media_count": 0, "tweet_count": 10}, "username": "JunRudjnf"}, {"id": "174353514", "name": "Elsa🌼", "public_metrics": {"followers_count": 4, "following_count": 1, "like_count": 80, "listed_count": 0, "media_count": 1, "tweet_count": 46}, "username": "soElsaxMae"}, {"id": "2041731664112463872", "name": "Lachy", "public_metrics": {"followers_count": 31, "following_count": 92, "like_count": 581, "listed_count": 0, "media_count": 67, "tweet_count": 1003}, "username": "illulachy_"}]}, "meta": {"newest_id": "2120320444939354506", "next_token": "b26v89c19zqg8o3juzovc47un387ai0npybcswyo5q2d9", "oldest_id": "2120316681461588464", "result_count": 15}}