{"data": [{"author_id": "2087941714300506117", "created_at": "2026-11-11T00:06:21.000Z", "edit_history_tweet_ids": ["2120307101734183295"], "id": "2120307101734183295", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs Handling noisy audio and speaker changes accurately makes this a meaningful leap for real-world transcription", "url": "https://x.com/ClaraOnAI/status/2120307101734183295"}, {"author_id": "175764359", "created_at": "2026-11-10T23:31:01.000Z", "edit_history_tweet_ids": ["2120298211361329265"], "id": "2120298211361329265", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 22, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs When in OpenRouter?", "url": "https://x.com/matheusm7353/status/2120298211361329265"}, {"author_id": "74053017", "created_at": "2026-11-10T23:20:48.000Z", "edit_history_tweet_ids": ["2120295639083073706"], "id": "2120295639083073706", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 34, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs I dictate most of what I send my bots now, so accuracy in a noisy room is the upgrade I care about most. Going to test this one.", "url": "https://x.com/AaronDelz/status/2120295639083073706"}, {"author_id": "2086105516800151552", "created_at": "2026-11-10T23:17:31.000Z", "edit_history_tweet_ids": ["2120294813454979569"], "id": "2120294813454979569", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs Introducing Scribe v3 and Scribe v3 Live: our most accurate Speech to Text models yet.\n\nBuilt for real-world audio, Scribe excels in situations with extreme background noise, knows pauses from the end of sentences, and keeps track of who said what in a busy meeting.", "url": "https://x.com/alessiatechai/status/2120294813454979569"}, {"author_id": "343877206", "created_at": "2026-11-10T23:11:22.000Z", "edit_history_tweet_ids": ["2120293266595967430"], "id": "2120293266595967430", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs Better speech to text on real-world audio is huge. Noisy rooms are the real test 🎙️", "url": "https://x.com/smobilefactory/status/2120293266595967430"}, {"author_id": "2109231484767031296", "created_at": "2026-11-10T22:57:59.000Z", "edit_history_tweet_ids": ["2120289897881997382"], "id": "2120289897881997382", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs The real test for 'real-world audio' is tonal languages in noisy rooms — Mandarin/Cantonese meetings where a tone shift changes the meaning and speakers overlap. If Scribe v3 holds diarization there, that's the benchmark that matters.", "url": "https://x.com/thebotbites/status/2120289897881997382"}, {"author_id": "2112291670523801601", "created_at": "2026-11-10T22:29:27.000Z", "edit_history_tweet_ids": ["2120282717581726104"], "id": "2120282717581726104", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs Pre-Scribe v3 baseline: in our Oct 20 phone-call test on default settings (11 calls, 33 turns), ElevenLabs Agents had a 1.04 s median reply, 1.34 s p90, 0 talk-overs and 0.6% WER in its own transcript of our caller. Curious how v3 Live moves those. https://t.co/RlVjRBPgw1", "url": "https://x.com/cozzoio/status/2120282717581726104"}, {"author_id": "1894307536406548483", "created_at": "2026-11-10T21:57:28.000Z", "edit_history_tweet_ids": ["2120274667433013392"], "id": "2120274667433013392", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs Wow, that sounds like a game-changer! So impressive.", "url": "https://x.com/AbirOnAI/status/2120274667433013392"}, {"author_id": "1437655880", "created_at": "2026-11-10T21:10:40.000Z", "edit_history_tweet_ids": ["2120262891550994700"], "id": "2120262891550994700", "in_reply_to_user_id": "1478679005788311552", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120256322281029731", "type": "quoted"}, {"id": "2120217467100541396", "type": "replied_to"}], "text": "@ElevenLabs Real-world audio handling with extreme noise, natural turn detection, and diarization in meetings is actually voice AI you can deploy today, and we broke down what changed: https://t.co/yh5ytGEcTB", "url": "https://x.com/MichaelWaitze/status/2120262891550994700"}, {"author_id": "2940464042", "created_at": "2026-11-10T21:04:43.0