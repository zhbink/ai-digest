{"data": [{"author_id": "2084353809661214721", "created_at": "2026-11-11T00:47:00.000Z", "edit_history_tweet_ids": ["2120317333088473108"], "id": "2120317333088473108", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey https://t.co/XrTgDFDrPs #mdapi", "url": "https://x.com/mdapiio/status/2120317333088473108"}, {"author_id": "2054415115613806592", "created_at": "2026-11-11T00:39:45.000Z", "edit_history_tweet_ids": ["2120315507630833732"], "id": "2120315507630833732", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 以后界面不是给人干活的，是给人验收的。", "url": "https://x.com/Johnb4zb/status/2120315507630833732"}, {"author_id": "2113256414688997376", "created_at": "2026-11-11T00:28:54.000Z", "edit_history_tweet_ids": ["2120312778741207166"], "id": "2120312778741207166", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey Manus 那步确实多余，Timeline 留着是给人看的，不是给 Agent 跑的。", "url": "https://x.com/Zane_Sang/status/2120312778741207166"}, {"author_id": "187213358", "created_at": "2026-11-11T00:22:45.000Z", "edit_history_tweet_ids": ["2120311229545845022"], "id": "2120311229545845022", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 做出来越来越快，找到愿意为它付钱的人，还是另一回事", "url": "https://x.com/sunruichao/status/2120311229545845022"}, {"author_id": "1724989707052867585", "created_at": "2026-11-11T00:18:43.000Z", "edit_history_tweet_ids": ["2120310217262973000"], "id": "2120310217262973000", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120254102097526953", "type": "replied_to"}], "text": "@dotey 这思路我太有共鸣了。最崩溃的不是生成慢，是辛辛苦苦等到最后才发现方向错了，还得全部重来。", "url": "https://x.com/XiTalking/status/2120310217262973000"}, {"author_id": "919189040", "created_at": "2026-11-11T00:12:49.000Z", "edit_history_tweet_ids": ["2120308728801210484"], "id": "2120308728801210484", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 严重同意，现在限制的是一）没有开放足够多让agent操作的方式，二）对于非文字结果，没有很便捷的方式与agent互动进行修改", "url": "https://x.com/VictorJing001/status/2120308728801210484"}, {"author_id": "1661994214996197377", "created_at": "2026-11-11T00:08:11.000Z", "edit_history_tweet_ids": ["2120307563313123783"], "id": "2120307563313123783", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 怎么说呢，只留播放器加批注这个有点狠。那批注怎么回到 agent 那边，是按时间点挂评论，还是你说一句它自己去找位置？", "url": "https://x.com/stansKoya/status/2120307563313123783"}, {"author_id": "1874284517839822848", "created_at": "2026-11-10T23:58:29.000Z", "edit_history_tweet_ids": ["2120305122391752805"], "id": "2120305122391752805", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 28, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 认同 可能是我们想象力在限制 AI \n当好质检员比编辑员更重要", "url": "https://x.com/wenjzsxx/status/2120305122391752805"}, {"author_id": "2102064626099699713", "created_at": "2026-11-10T22:57:11.000Z", "edit_history_tweet_ids": ["2120289698971021790"], "id": "2120289698971021790", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 11, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 这个判断我很认同\n给 Agent 去做视频剪辑时最有用的不是更复杂的时间轴 而是它能读能改的代码和命令\n人只要看结果并标出哪一镜不对\n做炫技视频时也是一样 先把时长和高潮锁死 再让模型去填运动", "url": "https://x.com/Ian18858863/status/2120289698971021790"}, {"author_id": "2076550235707650048", "created_at": "2026-11-10T22:15:26.000Z", "edit_history_tweet_ids": ["2120279189693821006"], "id": "2120279189693821006", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 人人自己动手做软件这点倒是真的，需求越怪越适合自己写一个，反正成本下来了，通用软件反而越来越难做了。", "url": "https://x.com/jiagws/status/2120279189693821006"}, {"author_id": "1891833767519715329", "created_at": "2026-11-10T22:13:18.000Z", "edit_history_tweet_ids": ["2120278652579402050"], "id": "2120278652579402050", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 28, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 以前写软件是逼人类去适应反人类的 UI，现在是逼软件倒退回最干净的 API 让 Agent 嚼碎。说白了，GUI 是人类的妥协，API 才是 AI 的母语。", "url": "https://x.com/YunTechX/status/2120278652579402050"}, {"author_id": "955232320063090693", "created_at": "2026-11-10T21:20:08.000Z", "edit_history_tweet_ids": ["2120265274909983052"], "id": "2120265274909983052", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey Fable 的那个提示词实验正好说明了这点：同样模型，一句“代码库是你的”，重复代码合并率从不到十分之一升到一半。瓶颈不在模型能力，而在怎么给 Agent 目标和验收标准。", "url": "https://x.com/TheEaglegon/status/2120265274909983052"}, {"author_id": "167216032", "created_at": "2026-11-10T21:11:14.000Z", "edit_history_tweet_ids": ["2120263034744807685"], "id": "2120263034744807685", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 50, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 人类退居到甲方的角色了", "url": "https://x.com/asuan_ai/status/2120263034744807685"}, {"author_id": "3178231", "created_at": "2026-11-10T20:35:45.000Z", "edit_history_tweet_ids": ["2120254102097526953"], "id": "2120254102097526953", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 4, "impression_count": 1814, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120250168025170181", "type": "quoted"}, {"id": "2120237447963415014", "type": "replied_to"}], "text": "关于如何尽早让人可以评估确认视频结果，我在做 BaoCut 时的经验是：\n\n1. 第一级确认是脚本（可选）\n\n先写Script，确认 Script 是否满足要求，不过文本的 Script 这个不太直观，而且需要人有耐心。\n\n其实有改进优化的余地，就是生成可视化的 HTML https://t.co/U3VTuCNFcS", "url": "https://x.com/dotey/status/2120254102097526953"}, {"author_id": "2119150629360676864", "created_at": "2026-11-10T20:32:32.000Z", "edit_history_tweet_ids": ["2120253295872692659"], "id": "2120253295872692659", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2120237447963415014", "type": "replied_to"}], "text": "@dotey 同意。以后软件可能要有两套界面：一套给人看，一套给 Agent 调。像剪辑这种复杂 GUI，先被绕开的大概不是功能，而是那一层层菜单。好奇你现在剪视频，是让 Agent 直接调 ffmpeg，还是调剪辑软件的接口？", "url": "https://x.com/NotaCold7723/status/2120253295872692659"}], "includes": {"users": [{"id": "2084353809661214721", "name": "mdapiio", "public_metrics": {"followers_count": 3, "following_count": 162, "like_count": 3, "listed_count": 0, "media_count": 0, "tweet_count": 1193}, "username": "mdapiio"}, {"id": "2054415115613806592", "name": "John", "public_metrics": {"followers_count": 1, "following_count": 15, "like_count": 6, "listed_count": 0, "media_count": 4, "tweet_count": 136}, "username": "Johnb4zb"}, {"id": "2113256414688997376", "name": "sanza_o", "public_metrics": {"followers_count": 3, "following_count": 126, "like_count": 0, "listed_count": 0, "media_count": 75, "tweet_count": 443}, "username": "Zane_Sang"}, {"id": "187213358", "name": "Richard", "public_metrics": {"followers_count": 3003, "following_count": 2706, "like_count": 402, "listed_count": 1, "media_count": 82, "tweet_count": 5471}, "username": "sunruichao"}, {"id": "1724989707052867585", "name": "一席", "public_metrics": {"followers_count": 3745, "following_count": 2904, "like_count": 7333, "listed_count": 6, "media_count": 711, "tweet_count": 15176}, "username": "XiTalking"}, {"id": "919189040", "name": "Wallace Jing", "public_metrics": {"followers_count": 9, "following_count": 287, "like_count": 20, "listed_count": 0, "media_count": 0, "tweet_count": 27}, "username": "VictorJing001"}, {"id": "1661994214996197377", "name": "Stans", "public_metrics": {"followers_count": 45, "following_count": 187, "like_count": 241, "listed_count": 0, "media_count": 22, "tweet_count": 724}, "username": "stansKoya"}, {"id": "1874284517839822848", "name": "Wen j", "public_metrics": {"followers_count": 37, "following_count": 614, "like_count": 719, "listed_count": 0, "media_count": 32, "tweet_count": 283}, "username": "wenjzsxx"}, {"id": "21020646260996