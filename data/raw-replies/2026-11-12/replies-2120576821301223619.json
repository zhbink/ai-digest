      },
      "referenced_tweets": [
        {
          "id": "2120579979079778814",
          "type": "replied_to"
        }
      ],
      "text": "We also experimented with different actors without reshooting.\n\nUsing fal Recast through the fal ChatGPT plugin, we created three versions of the same scene with different characters, while preserving the passengers, environment, and overall composition. https://t.co/nAAClYp2sp",
      "url": "https://x.com/fal/status/2120580096608419847"
    },
