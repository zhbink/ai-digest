{"data": [{"id": "2122128280929378431", "author_id": "2007776638478761984", "text": "@dreamina_ai Faster generation and lower costs make large-scale AI video creation much easier", "lang": "en", "created_at": "2026-11-16T00:43:04.000Z", "url": "https://x.com/SeeratFatima112/status/2122128280929378431", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122108905257910703", "author_id": "1508329076343422982", "text": "@dreamina_ai your black friday deal doesnt work, i tried to pay it and didnt get it", "lang": "en", "created_at": "2026-11-15T23:26:04.000Z", "url": "https://x.com/LeMiMind/status/2122108905257910703", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122104153975533696", "author_id": "1649581322409525250", "text": "@dreamina_ai Congrats on the launch! Honest question from a daily video creator: how well does Seedance 2.5 Flash keep the face consistent across a 15 second cinematic shot?", "lang": "en", "created_at": "2026-11-15T23:07:11.000Z", "url": "https://x.com/RobotCleopatra/status/2122104153975533696", "public_metrics": {"bookmark_count": 0, "impression_count": 35, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122086575345426436", "author_id": "1748336595596398592", "text": "@dreamina_ai State-of-the-art model! ❤️ Works really well in conjunction with the normal version of SeeDance 2.5 and SeeDream 5.5. You can do a draft in SeeDance 2.5, extract frames (even at 480p), have SeeDream 5.5 reconstruct them in a higher quality and use them as start frames alongside", "lang": "en", "created_at": "2026-11-15T21:57:20.000Z", "url": "https://x.com/alynnaai/status/2122086575345426436", "public_metrics": {"bookmark_count": 0, "impression_count": 28, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122067723694100689", "author_id": "382969672", "text": "@dreamina_ai I don't see the option for this model available yet", "lang": "en", "created_at": "2026-11-15T20:42:26.000Z", "url": "https://x.com/heroframemedia/status/2122067723694100689", "public_metrics": {"bookmark_count": 0, "impression_count": 67, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122059852214415672", "author_id": "948595745703317504", "text": "@Daniel_Ishwar @dreamina_ai Hi 👋 what goes wrong first when a fast fight breaks Flash? Good to know it matches 2.5 on everything slower, so it sounds like the easy pick for first passes.", "lang": "en", "created_at": "2026-11-15T20:11:09.000Z", "url": "https://x.com/BDFrankHoubre/status/2122059852214415672", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122059272972554647", "author_id": "2052222204558151680", "text": "@dreamina_ai Flash speed + low credits = game changer 🔥\n\nBatch creators are about to go crazy with this one.", "lang": "en", "created_at": "2026-11-15T20:08:51.000Z", "url": "https://x.com/Maviya6v/status/2122059272972554647", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122022840404971732", "author_id": "237063776", "text": "@dreamina_ai 🔥", "lang": "qme", "created_at": "2026-11-15T17:44:05.000Z", "url": "https://x.com/thegothamai/status/2122022840404971732", "public_metrics": {"bookmark_count": 0, "impression_count": 15, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122015939709509993", "author_id": "2097907968465682432", "text": "@dreamina_ai @dreamina_ai Flash is for the unglamorous part: batch takes and version tests, not the hero shot.\n\nIf 2.5 is what you show, Flash is how you get there without burning the credit stack on first-pass junk.", "lang": "en", "created_at": "2026-11-15T17:16:39.000Z", "url": "https://x.com/josephXfilm/status/2122015939709509993", "public_metrics": {"bookmark_count": 0, "impression_count": 50, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122002900578607572", "author_id": "1059824142797729792", "text": "@dreamina_ai Per-second pricing helps for batch testing, since you can budget a run before you start. Curious how often people keep the Flash output versus re-rendering the winners at higher quality. That ratio decides the real cost", "lang": "en", "created_at": "2026-11-15T16:24:51.000Z", "url": "https://x.com/Ardanwen_SKT/status/2122002900578607572", "public_metrics": {"bookmark_count": 0, "impression_count": 31, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2122002741031837786", "author_id": "1122413738693484547", "text": "@dreamina_ai That's fast! great to try this out too", "lang": "en", "created_at": "2026-11-15T16:24:13.000Z", "url": "https://x.com/Shinebynous/status/2122002741031837786", "public_metrics": {"bookmark_count": 0, "impression_count": 102, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2121974165330928028", "author_id": "1844852813895024644", "text": "@dreamina_ai Wah yaar ye to bohat kaam ki cheez hai, fast generation aur kam credits ka combo creators ke liye best hai, ab ek hi idea ke kai versions try karna asaan ho jayega 😍", "lang": "in", "created_at": "2026-11-15T14:30:40.000Z", "url": "https://x.com/Saurio5665/status/2121974165330928028", "public_metrics": {"bookmark_count": 0, "impression_count": 53, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2121962251880194308", "author_id": "1196086943160786944", "text": "@dreamina_ai @Dheepanratnam bro this model.", "lang": "en", "created_at": "2026-11-15T13:43:19.000Z", "url": "https://x.com/AppuAppuzS/status/2121962251880194308", "public_metrics": {"bookmark_count": 0, "impression_count": 44, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2121962116928426213", "author_id": "1196086943160786944", "text": "@dreamina_ai @Dheepanratnam bro review for this model.", "lang": "en", "created_at": "2026-11-15T13:42:47.000Z", "url": "https://x.com/AppuAppuzS/status/2121962116928426213", "public_metrics": {"bookmark_count": 0, "impression_count": 51, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}, {"id": "2121960249087410304", "author_id": "1982814619891834880", "text": "@dreamina_ai Flash fits best as the sketch layer of a workflow: iterate on motion and framing with it, then promote only the shots that work to full 2.5. The real savings come from fewer expensive rerolls, not just the lower rate.", "lang": "en", "created_at": "2026-11-15T13:35:22.000Z", "url": "https://x.com/tomorrow2035/status/2121960249087410304", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}}], "includes": {"users": [{"id": "2007776638478761984", "username": "SeeratFatima112", "name": "Seerat Fatima", "verified": false}, {"id": "1763302572767711232", "username": "dreamina_ai", "name": "Dreamina AI", "verified": false}, {"id": "1508329076343422982", "username": "LeMiMind", "name": "LeMi", "verified": false}, {"id": "1649581322409525250", "username": "RobotCleopatra", "name": "Skipper VanderWall", "verified": false}, {"id": "1748336595596398592", "username": "alynnaai", "name": "ALynna", "verified": false}, {"id": "382969672", "username": "heroframemedia", "name": "Drake and Dad", "verified": false}, {"id": "948595745703317504", "username": "BDFrankHoubre", "name": "Frank Houbre", "verified": false}, {"id": "4024623504", "username": "Daniel_Ishwar", "name": "itsIshwar", "verified": false}, {"id": "2052222204558151680", "username": "Maviya6v", "name": "Maviya Ai", "verified": false}, {"id": "237063776", "username": "thegothamai",