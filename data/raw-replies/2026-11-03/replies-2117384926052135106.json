{"data": [{"author_id": "2117115320817037312", "created_at": "2026-11-03T00:53:09.000Z", "edit_history_tweet_ids": ["2117419780005085674"], "id": "2117419780005085674", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Neat!", "url": "https://x.com/ikari314/status/2117419780005085674"}, {"author_id": "30141738", "created_at": "2026-11-03T00:51:27.000Z", "edit_history_tweet_ids": ["2117419348545650839"], "id": "2117419348545650839", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Does it even matter anymore?\nWhatever innovation, anthropic will just swallow it.", "url": "https://x.com/justsomeguy741/status/2117419348545650839"}, {"author_id": "1614608796973928448", "created_at": "2026-11-03T00:45:20.000Z", "edit_history_tweet_ids": ["2117417812226605281"], "id": "2117417812226605281", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Editing 0.016% of the weights to get 6x better math.\n\nThat's the most efficient tutoring session in history.", "url": "https://x.com/Richdorai/status/2117417812226605281"}, {"author_id": "2093798674459492352", "created_at": "2026-11-03T00:32:20.000Z", "edit_history_tweet_ids": ["2117414539142820030"], "id": "2117414539142820030", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Garrrieeee!! 👌", "url": "https://x.com/RustyAiLab/status/2117414539142820030"}, {"author_id": "1276965019444527113", "created_at": "2026-11-03T00:31:23.000Z", "edit_history_tweet_ids": ["2117414301019631966"], "id": "2117414301019631966", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan The part that gets me is it diagnosed the looping issue itself before fixing it. That's closer to debugging than optimizing.", "url": "https://x.com/talhaminhaas/status/2117414301019631966"}, {"author_id": "2114329964313276416", "created_at": "2026-11-03T00:15:42.000Z", "edit_history_tweet_ids": ["2117410352040382824"], "id": "2117410352040382824", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan If a frontier model can edit 0.016% of weights and get 6x on math, the bottleneck moves to verification. Who audits a weight patch that nobody trained and nobody can fully explain?", "url": "https://x.com/BiosickJohnny/status/2117410352040382824"}, {"author_id": "104805570", "created_at": "2026-11-03T00:05:21.000Z", "edit_history_tweet_ids": ["2117407749999141333"], "id": "2117407749999141333", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan 0.016% is absurdly small", "url": "https://x.com/stevencheng/status/2117407749999141333"}, {"author_id": "1847373327603752961", "created_at": "2026-11-03T00:05:19.000Z", "edit_history_tweet_ids": ["2117407738766725543"], "id": "2117407738766725543", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Small models editing weights directly is big for private and on-device setups.\n\nCurious how they check the edit didn't quietly break something else.", "url": "https://x.com/0xbrahmarishi/status/2117407738766725543"}, {"author_id": "1445801594168266756", "created_at": "2026-11-03T00:03:47.000Z", "edit_history_tweet_ids": ["2117407356434915330"], "id": "2117407356434915330", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan A big model editing a small one's weights with no training run is a compute story as much as a research one. If 0.016% of weights does that, the cost to customize a model just collapsed.", "url": "https://x.com/chanmeetnarang/status/2117407356434915330"}, {"author_id": "970869459253542913", "created_at": "2026-11-02T23:59:39.000Z", "edit_history_tweet_ids": ["2117406315043524719"], "id": "2117406315043524719", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan This is kinda massive.", "url": "https://x.com/0xWizardOf0z/status/2117406315043524719"}, {"author_id": "1026951690937884672", "created_at": "2026-11-02T23:56:29.000Z", "edit_history_tweet_ids": ["2117405517618520153"], "id": "2117405517618520153", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 36, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan a patch touching 0.016% of the weights is something you can diff, review and roll back. that makes it closer to a commit than a training run.", "url": "https://x.com/EternitiesAI/status/2117405517618520153"}, {"author_id": "1892479427801411585", "created_at": "2026-11-02T23:44:06.000Z", "edit_history_tweet_ids": ["2117402400508285425"], "id": "2117402400508285425", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan small models editing weights directly is wild. feels like we went from prompting the model to doing surgery on it. curious how u even eval that safely", "url": "https://x.com/baeincrypto/status/2117402400508285425"}, {"author_id": "1278213605779886080", "created_at": "2026-11-02T23:43:54.000Z", "edit_history_tweet_ids": ["2117402350432502016"], "id": "2117402350432502016", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 73, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan so small models as surgeons for big ones? love that", "url": "https://x.com/beth2049_/status/2117402350432502016"}, {"author_id": "1890047835728752640", "created_at": "2026-11-02T23:35:35.000Z", "edit_history_tweet_ids": ["2117400259253109131"], "id": "2117400259253109131", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan the control in the write-up is the tell: the same method on Gemma 3 270M moved MATH-500 from 6.8 to 7.0. Qwen's 7.9 → 48.1 came from a model where 93% of answers ran into the 32,768-token limit. it edited out a looping failure, it didn't add math skill", "url": "https://x.com/AiAdventurerx/status/2117400259253109131"}, {"author_id": "1212171176815939584", "created_at": "2026-11-02T23:32:22.000Z", "edit_history_tweet_ids": ["2117399448511017324"], "id": "2117399448511017324", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 27, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan This is actually damn scary from a security perspective… kinda like mind control for ai", "url": "https://x.com/appsecinabox/status/2117399448511017324"}, {"author_id": "2045997177684541440", "created_at": "2026-11-02T23:31:13.000Z", "edit_history_tweet_ids": ["2117399156968796227"], "id": "2117399156968796227", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 26, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan we are just scratching  the surface of whats possible", "url": "https://x.com/MaieuticMD/status/2117399156968796227"}, {"author_id": "2110340937108897792", "created_at": "2026-11-02T23:19:39.000Z", "edit_history_tweet_ids": ["2117396248907137160"], "id": "2117396248907137160", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan The limit the post names is adding an ability the model lacked. For knowledge, that part works: OLMo-2 7B went from 6.4% to 89.5% on a sealed day of news it had never seen, learnt into its weights overnight with nothing in the prompt.", "url": "https://x.com/fintanlabs/status/2117396248907137160"}, {"author_id": "1921004179641782272", "created_at": "2026-11-02T23:18:14.000Z", "edit_history_tweet_ids": ["2117395891854385337"], "id": "2117395891854385337", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 49, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan The paper fixes the weight that cause looping errors, but does not add semantic meaning to the weights", "url": "https://x.com/cordobasunset/status/2117395891854385337"}, {"author_id": "2087634820675325952", "created_at": "2026-11-02T23:17:20.000Z", "edit_history_tweet_ids": ["2117395663407263931"], "id": "2117395663407263931", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 30, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Small models are where the practical work happens. Most business tasks are cheap and fast.", "url": "https://x.com/ArjunK100/status/2117395663407263931"}, {"author_id": "1250597333026340864", "created_at": "2026-11-02T23:15:25.000Z", "edit_history_tweet_ids": ["2117395182718947402"], "id": "2117395182718947402", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan 0.016% of the weights changed and math went up 6x. small models just became an editing problem, not a training one.", "url": "https://x.com/LuiyaIglesias/status/2117395182718947402"}, {"author_id": "1716597611325804544", "created_at": "2026-11-02T23:14:55.000Z", "edit_history_tweet_ids": ["2117395057879728352"], "id": "2117395057879728352", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan it changed 0.016% of the weights and fixed it. surgical stuff. that's the same move that saves most broken codebases", "url": "https://x.com/balawal_virk/status/2117395057879728352"}, {"author_id": "2019929179131699200", "created_at": "2026-11-02T23:14:25.000Z", "edit_history_tweet_ids": ["2117394928959672491"], "id": "2117394928959672491", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Small models editing big ones. Middle management finally found a use case.", "url": "https://x.com/peteryantweets/status/2117394928959672491"}, {"author_id": "1572988245306396675", "created_at": "2026-11-02T23:11:12.000Z", "edit_history_tweet_ids": ["2117394122617360612"], "id": "2117394122617360612", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 135, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan gradient descent is so 2025 https://t.co/iZgyL3xZWT", "url": "https://x.com/harjjotsinghh/status/2117394122617360612"}, {"author_id": "2084007006495780864", "created_at": "2026-11-02T23:03:47.000Z", "edit_history_tweet_ids": ["2117392254382034979"], "id": "2117392254382034979", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 28, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan can be used to do a lot of bad things…", "url": "https://x.com/genchdjahit/status/2117392254382034979"}, {"author_id": "47739897", "created_at": "2026-11-02T23:03:29.000Z", "edit_history_tweet_ids": ["2117392179458879598"], "id": "2117392179458879598", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 70, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117384926052135106", "type": "replied_to"}], "text": "@garrytan Imagine AI generating tools in one shot without generating code. This could be a new type of what we used to call software. My mind is spinning from the implications.", "url": "https://x.com/NukeGold/status/2117392179458879598"}], "includes": {"users": [{"id": "2117115320817037312", "name": "Ikari", "username": "ikari314"}, {"id": "30141738", "name": "dimitri.base.eth (some/guy)", "username": "justsomeguy741"}, {"id": "1614608796973928448", "name": "RichDorai", "username": "Richdorai"}, {"id": "2093798674459492352", "name": "Rusty", "username": "RustyAiLab"}, {"id": "1276965019444527113", "name": "Talha Minhaas (Blueguy)", "username": "talhaminhaas"}, {"id": "2114329964313276416", "name": "Biosick Johnny", "username": "BiosickJohnny"}, {"id": "104805570", "name": "Steven Cheng", "username": "stevencheng"}, {"id": "1847373327603752961", "name": "Rishi", "username": "0xbrahmarishi"}, {"id": "1445801594168266756", "name": "Chanmeet S. Narang", "username": "chanmeetnarang"}, {"id": "970869459253542913", "name": "theWiz.eth", "username": "0xWizardOf0z"}, {"id": "1026951690937884672", "name": "Dominik", "username": "EternitiesAI"}, {"id": "1892479427801411585", "name": "shivani", "username": "baeincrypto"}, {"id": "1278213605779886080", "name": "Beth", "username": "beth