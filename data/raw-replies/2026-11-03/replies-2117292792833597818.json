{"data": [{"author_id": "1823342686352572416", "conversation_id": "2117292792833597818", "created_at": "2026-11-03T01:16:55.000Z", "edit_history_tweet_ids": ["2117425758805410215"], "id": "2117425758805410215", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 官号那条已经136万浏览 收藏快1万了 看来大家是真不想再困在聊天框里 想自己搓点东西", "url": "https://x.com/neili666888/status/2117425758805410215"}, {"author_id": "2117072122145284096", "conversation_id": "2117292792833597818", "created_at": "2026-11-03T01:08:33.000Z", "edit_history_tweet_ids": ["2117423651654091174"], "id": "2117423651654091174", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 比较关心权限这一块，一句话生成的插件能不能联网、能读哪些目录，有地方能看吗？", "url": "https://x.com/xiaobeistudio/status/2117423651654091174"}, {"author_id": "2114680712209276928", "conversation_id": "2117292792833597818", "created_at": "2026-11-03T00:50:01.000Z", "edit_history_tweet_ids": ["2117418991069331457"], "id": "2117418991069331457", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes @bot 这是什么 也给我总结一下 我要学习理解他", "url": "https://x.com/ChrisCao0007/status/2117418991069331457"}, {"author_id": "173484971", "conversation_id": "2117292792833597818", "created_at": "2026-11-03T00:44:40.000Z", "edit_history_tweet_ids": ["2117417645138182310"], "id": "2117417645138182310", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 57, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 一句话就能搓个插件，最大的变化是门槛没了\n以后拉开差距的，不是谁会写代码，是谁清楚自己每天到底缺个啥工具\n想明白要什么，比会做更值钱", "url": "https://x.com/yhslgg/status/2117417645138182310"}, {"author_id": "1867176094987935744", "conversation_id": "2117292792833597818", "created_at": "2026-11-03T00:28:43.000Z", "edit_history_tweet_ids": ["2117413630090342508"], "id": "2117413630090342508", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 63, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 又是“全体都还在”的熟悉叙事，具体能搓出啥插件倒是想看看。", "url": "https://x.com/An_yhl/status/2117413630090342508"}, {"author_id": "1672819239911055360", "conversation_id": "2117292792833597818", "created_at": "2026-11-03T00:15:53.000Z", "edit_history_tweet_ids": ["2117410398068752601"], "id": "2117410398068752601", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 97, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 又拉了个大的", "url": "https://x.com/DeepSuck69/status/2117410398068752601"}, {"author_id": "2005927632161193984", "conversation_id": "2117292792833597818", "created_at": "2026-11-03T00:11:59.000Z", "edit_history_tweet_ids": ["2117409419692818673"], "id": "2117409419692818673", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 36, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 这个 不是之前就有了吗", "url": "https://x.com/thiennhan741/status/2117409419692818673"}, {"author_id": "1642137369569820672", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T22:08:32.000Z", "edit_history_tweet_ids": ["2117378351115673920"], "id": "2117378351115673920", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 123, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 对话造插件最该盯的是装的那一步。插件是模型现写的，弹窗问权限时很多人会顺手点允许，我觉得至少先看一眼它要读哪些目录、能不能联网，再决定给不给。", "url": "https://x.com/surveywork0/status/2117378351115673920"}, {"author_id": "1978904351294001155", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T20:52:59.000Z", "edit_history_tweet_ids": ["2117359339778494779"], "id": "2117359339778494779", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 109, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 好家伙全部是AI回帖子那我这条算沙盒游戏里的人机对线吗", "url": "https://x.com/0xCryptoLucario/status/2117359339778494779"}, {"author_id": "2277353402", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T18:47:24.000Z", "edit_history_tweet_ids": ["2117327732761928038"], "id": "2117327732761928038", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 112, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 🐎的 全部是 ai 回帖子", "url": "https://x.com/longcheap/status/2117327732761928038"}, {"author_id": "2097392680078860288", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T17:50:41.000Z", "edit_history_tweet_ids": ["2117313458794545583"], "id": "2117313458794545583", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 290, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 以前是等官方更新，现在是缺啥自己搓。梁文锋这是在逼别家产品经理加班啊", "url": "https://x.com/Cq66888/status/2117313458794545583"}, {"author_id": "1452147924859645957", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T17:25:44.000Z", "edit_history_tweet_ids": ["2117307184014934454"], "id": "2117307184014934454", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 343, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 一句话就能搓出插件确实方便，门槛降下来是好事。不过自己造的插件，权限给到哪、后面谁维护，这些也得自己兜着——好用归好用，别搓完就忘了它还在后台跑着。", "url": "https://x.com/wuguanzheng2/status/2117307184014934454"}, {"author_id": "1880849654700761088", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T16:58:08.000Z", "edit_history_tweet_ids": ["2117300234288275667"], "id": "2117300234288275667", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 301, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 一句话变插件是真香。就怕甲方验收那天，文档权限改需求这三件，又把我打回焊脚手架。", "url": "https://x.com/RudyReceipts/status/2117300234288275667"}, {"author_id": "2095722313744601088", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T16:52:18.000Z", "edit_history_tweet_ids": ["2117298766105682007"], "id": "2117298766105682007", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 271, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 如果随手做的插件能留下来反复用，个人工作区就真的值得慢慢折腾了，不用每次有个小需求都重新聊一遍。", "url": "https://x.com/Rennix7t/status/2117298766105682007"}, {"author_id": "2114733813662142464", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T16:49:09.000Z", "edit_history_tweet_ids": ["2117297973776556441"], "id": "2117297973776556441", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 201, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 聊天框还锁着人，人家已经让一句话搓出可跑插件了，这步跨得够狠", "url": "https://x.com/maiai_fun/status/2117297973776556441"}, {"author_id": "2514765517", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T16:48:51.000Z", "edit_history_tweet_ids": ["2117297902024626522"], "id": "2117297902024626522", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 328, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AYi_AInotes 一句话就能搓出可运行插件，从设计工作区到3D可视化都在里面。插件跑起来之后，权限和数据边界怎么划，才是真正要验的那一步。", "url": "https://x.com/Trust_Wang/status/2117297902024626522"}, {"author_id": "1974653328274714624", "conversation_id": "2117292792833597818", "created_at": "2026-11-02T16:28:35.000Z", "edit_history_tweet_ids": ["2117292799653482538"], "id": "2117292799653482538", "lang": "zh", "public_metrics": {"bookmark_count": 3, "impression_count": 948, "like_count": 6, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "官方三大范例拆解\n1.  设计工作区（Design workspace）：一键生成包含画布、组件库与样式调优的专属工作流\n2.  沙盒游戏（Sandbox game）：通过提示词快速搭建轻量可玩的逻辑交互小游戏\n3.  3D 大模型可视化（3D LLM visualizer）：直接生成可交互的三维网络结构与注意力权重观察器\n\n→", "url": "https://x.com/AYi_AInotes/status/2117292799653482538"}], "includes": {"users": [{"id": "1823342686352572416", "name": "懂点AI的卢小熙", "username": "neili666888"}, {"id": "2117072122145284096", "name": "汤圆小贝", "username": "xiaobeistudio"}, {"id": "2114680712209276928", "name": "Chris Cao", "username": "ChrisCao0007"}, {"id": "173484971", "name": "老杨啊 | AI产品商业化", "username": "yhslgg"}, {"id": "1867176094987935744", "name": "晚晚", "username": "An_yhl"}, {"id": "1672819239911055360", "name": "大鹏博士", "username": "DeepSuck69"}, {"id": "2005927632161193984", "name": "托马斯yu", "username": "thiennhan741"}, {"id": "1642137369569820672", "name": "秋源（互关必回）", "username": "surveywork0"}, {"id": "1978904351294001155", "name": "加密波导 | 路卡利欧", "username": "0xCryptoLucario"}, {"id": "2277353402", "name": "time666", "username": "longcheap"}, {"id": "2097392680078860288", "name": "Cq", "username": "Cq66888"}, {"id": "1452147924859645957", "name": "阿信 Alpha", "username": "wuguanzheng2"}, {"id": "1880849654700761088", "name": "A和B", "username": "RudyReceipts"}, {"id": "2095722313744601088", "name": "三分钟懂行", "username": "Rennix7t"}, {"id": "2114733813662142464", "name": "格 Boss", "username": "maiai_fun"}, {"id": "2514765517", "name": "老王｜AI·Crypto", "username": "Trust_Wang"}, {"id": "1974653328274714624", "name": "AYi", "username": "AYi_AInotes"}]}, "meta": {"newest_id": "2117425758805410215", "next_token": "b26v89c19zqg8o3juzlyi9dx0a5g4hsvxm37batoj3mgt", "oldest_id": "2117292799653482538", "result_count": 17}}