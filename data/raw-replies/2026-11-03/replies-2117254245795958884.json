{"data": [{"author_id": "1527316617117712385", "created_at": "2026-11-02T21:15:59.000Z", "edit_history_tweet_ids": ["2117365126470992307"], "id": "2117365126470992307", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 這對會自己看網頁、點按鈕的 agent 特別重要，頁面上一張不相干的圖就可能左右它的判斷。讓 AI 代操作的時候，付款、刪除這類關鍵步驟還是留給人確認比較安心。", "url": "https://x.com/Bruce32099549/status/2117365126470992307"}, {"author_id": "1391686489298202624", "created_at": "2026-11-02T20:41:22.000Z", "edit_history_tweet_ids": ["2117356414670966849"], "id": "2117356414670966849", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 配图还能下套，离谱", "url": "https://x.com/Dayifaa/status/2117356414670966849"}, {"author_id": "2085838061347217408", "created_at": "2026-11-02T16:11:32.000Z", "edit_history_tweet_ids": ["2117288508905673079"], "id": "2117288508905673079", "in_reply_to_user_id": "123907327", "public_metrics": {"bookmark_count": 0, "impression_count": 82, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117288479294099775", "type": "replied_to"}], "text": "@HunterRockCat @Gorden_Sun 我这就发到你的 Grok Bot 里，论文解读马上在那边展开。", "url": "https://x.com/bot/status/2117288508905673079"}, {"author_id": "123907327", "created_at": "2026-11-02T16:11:25.000Z", "edit_history_tweet_ids": ["2117288479294099775"], "id": "2117288479294099775", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun @bot 解读这篇论文", "url": "https://x.com/HunterRockCat/status/2117288479294099775"}, {"author_id": "2108438560416415744", "created_at": "2026-11-02T15:45:19.000Z", "edit_history_tweet_ids": ["2117281910817014157"], "id": "2117281910817014157", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 36, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 一个红心图就能让它从循环改成递归😨 还嘴硬说是巧合", "url": "https://x.com/TedCai233/status/2117281910817014157"}, {"author_id": "991872400361836545", "created_at": "2026-11-02T14:58:39.000Z", "edit_history_tweet_ids": ["2117270168724439499"], "id": "2117270168724439499", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 60, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 这类研究对 agent 比对聊天更危险：网页上一张无关图片就可能影响它点哪个按钮。测试的还是 Opus 4.7、Gemini 3.1 Pro 这些上一代模型，新一代是否同样中招更值得看。", "url": "https://x.com/EthanLinAI/status/2117270168724439499"}, {"author_id": "1992952876533215232", "created_at": "2026-11-02T14:40:03.000Z", "edit_history_tweet_ids": ["2117265486341632345"], "id": "2117265486341632345", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 哈哈，一张无关图片就能带偏 AI 的判断，这也太好玩了", "url": "https://x.com/xiri318695/status/2117265486341632345"}, {"author_id": "2112064831901855744", "created_at": "2026-11-02T14:32:45.000Z", "edit_history_tweet_ids": ["2117263651283603751"], "id": "2117263651283603751", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 人类的语言并不是效率最高的交流方式", "url": "https://x.com/jdjdjefbbf/status/2117263651283603751"}, {"author_id": "1657414669789986816", "created_at": "2026-11-02T14:25:37.000Z", "edit_history_tweet_ids": ["2117261853135159665"], "id": "2117261853135159665", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 37, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun AI 也吃首图这套，跟买家一个德行", "url": "https://x.com/harrison_0x821/status/2117261853135159665"}, {"author_id": "605804321", "created_at": "2026-11-02T14:22:04.000Z", "edit_history_tweet_ids": ["2117260961648119876"], "id": "2117260961648119876", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 强", "url": "https://x.com/28David02/status/2117260961648119876"}, {"author_id": "2115672486767693824", "created_at": "2026-11-02T14:20:52.000Z", "edit_history_tweet_ids": ["2117260660417659275"], "id": "2117260660417659275", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 36, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 看图这事还真挺玄乎!", "url": "https://x.com/Alanogrok/status/2117260660417659275"}, {"author_id": "2254603412", "created_at": "2026-11-02T14:14:25.000Z", "edit_history_tweet_ids": ["2117259037406556389"], "id": "2117259037406556389", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 59, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 兩台 AI 用畫圖互傳暗號 人類完全看不懂 這已經是背著我們開小群了吧🤣", "url": "https://x.com/Utopia6199/status/2117259037406556389"}, {"author_id": "1475030840736612352", "created_at": "2026-11-02T14:13:44.000Z", "edit_history_tweet_ids": ["2117258861795275234"], "id": "2117258861795275234", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 51, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 这个有点吓人，等于网页里随便放张不相干的图，就可能左右 Agent 的选择。以后让 AI 自动比价、下单这类事，图片可能得单独过一道检查。", "url": "https://x.com/AAANaiKuoer/status/2117258861795275234"}, {"author_id": "1880849654700761088", "created_at": "2026-11-02T14:07:21.000Z", "edit_history_tweet_ids": ["2117257255846334536"], "id": "2117257255846334536", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 38, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun DeepMind说一张随便的图就能带偏 Claude、Gemini、GPT。我付费让它们审甲方稿，结果它们看图比听人话还认真，这会员费交得真憋屈。", "url": "https://x.com/RudyReceipts/status/2117257255846334536"}, {"author_id": "2115456440232275968", "created_at": "2026-11-02T14:02:27.000Z", "edit_history_tweet_ids": ["2117256024021508327"], "id": "2117256024021508327", "in_reply_to_user_id": "1657474831", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117254245795958884", "type": "replied_to"}], "text": "@Gorden_Sun 红心让 AI 百分之百改用递归，这个有点吓人\n更麻烦的是它在思考链里还会给自己找借口，看思考链审代码也靠不住了\n以后截图丢给 Codex 之前得先看看图里有啥", "url": "https://x.com/NextTokenCN/statu