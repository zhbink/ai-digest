{"data": [{"author_id": "1954757752909377536", "conversation_id": "2117229927107883219", "created_at": "2026-11-03T01:08:02.000Z", "edit_history_tweet_ids": ["2117423523212022094"], "id": "2117423523212022094", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@AinaAiTech @Kling_ai @chromaawards Incentivizing long-form generative storytelling through verified cash grants pushes prompt engineers toward rigorous multi-scene continuity instead of fleeting viral clips. Which category are you submitting to?", "url": "https://x.com/mikesaiforge/status/2117423523212022094"}, {"author_id": "1116857355671691266", "conversation_id": "2117229927107883219", "created_at": "2026-11-02T22:16:07.000Z", "edit_history_tweet_ids": ["2117380257246257184"], "id": "2117380257246257184", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@Kling_ai @chromaawards Behind-the-Scenes getting its own division is the move. Half the comedy is the fight to get one shot to behave.\n\nAlready eyeing the Film &amp; TV bracket.", "url": "https://x.com/vnmsfx/status/2117380257246257184"}, {"author_id": "74870689", "conversation_id": "2117229927107883219", "created_at": "2026-11-02T20:31:32.000Z", "edit_history_tweet_ids": ["2117353940698247642"], "id": "2117353940698247642", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 15, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@Kling_ai @chromaawards The scale of Season 2 is absolutely insane. Pushing $450K+ in cash prizes and opening up 5 distinct divisions shows how much the AI filmmaking industry has matured in just one year. Can't wait to see what the community builds! 🤝🔥", "url": "https://x.com/nonameoasis/status/2117353940698247642"}, {"author_id": "2004003973280550914", "con