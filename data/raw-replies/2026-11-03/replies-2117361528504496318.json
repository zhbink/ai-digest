{"data": [{"author_id": "1436897248600756228", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:59:49.000Z", "edit_history_tweet_ids": ["2117421453901783128"], "id": "2117421453901783128", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 11, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 按满六个月折才 17.5–25 万刀，别把 50 万当到手价", "url": "https://x.com/BigYuJson/status/2117421453901783128"}, {"author_id": "2953739684", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:46:29.000Z", "edit_history_tweet_ids": ["2117418098903175592"], "id": "2117418098903175592", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 感谢整理得这么细。\n\n「不要求机器学习背景」这点对很多工程师是个信号：做 AI 安全，看重的可能是会不会设计实验、会不会找漏洞，而不只是会不会训模型。", "url": "https://x.com/AzrianoY1/status/2117418098903175592"}, {"author_id": "1845106521241419776", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:39:02.000Z", "edit_history_tweet_ids": ["2117416225391452332"], "id": "2117416225391452332", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要求机器学习背景这点挺有意思，说明 AI 安全现在缺的不只是会调参的人，更缺能把问题想清楚的人。", "url": "https://x.com/ChenzfeTobE/status/2117416225391452332"}, {"author_id": "417055142", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:38:58.000Z", "edit_history_tweet_ids": ["2117416210770092431"], "id": "2117416210770092431", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 49, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 据说8轮面试，最后两轮要去现场考察，给三天时间做任务，堪称科举考试赶考。是不是真的？", "url": "https://x.com/haudanne/status/2117416210770092431"}, {"author_id": "392425784", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:35:00.000Z", "edit_history_tweet_ids": ["2117415208696320176"], "id": "2117415208696320176", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 驻留研究员不卡机器学习背景，年薪三十五万到五十万刀，这条转行通道挺实在。", "url": "https://x.com/XXKING/status/2117415208696320176"}, {"author_id": "1468458388388335619", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:23:54.000Z", "edit_history_tweet_ids": ["2117412415180857491"], "id": "2117412415180857491", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要机器学习背景还开五十万刀，教授们要改简历了", "url": "https://x.com/DistillX_AI/status/2117412415180857491"}, {"author_id": "1467588769209532422", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:21:52.000Z", "edit_history_tweet_ids": ["2117411905543491815"], "id": "2117411905543491815", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 33, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 跟普通人没关系，散了吧", "url": "https://x.com/gutoubeng1/status/2117411905543491815"}, {"author_id": "2829222264", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:18:16.000Z", "edit_history_tweet_ids": ["2117410998047146071"], "id": "2117410998047146071", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 30, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 35万刀招个不懂行的，这烧钱节奏得融到Z轮才够。", "url": "https://x.com/isotankGG/status/2117410998047146071"}, {"author_id": "1164980832446111744", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:12:21.000Z", "edit_history_tweet_ids": ["2117409510491091257"], "id": "2117409510491091257", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 导师、算力和明确课题，比只说“不要求机器学习背景”更能帮人转过来。", "url": "https://x.com/freedomledgerhq/status/2117409510491091257"}, {"author_id": "2110004637403410432", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:11:12.000Z", "edit_history_tweet_ids": ["2117409222459867514"], "id": "2117409222459867514", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey The six-week track is the interesting one: it forces a founder to bring a concrete failure from their own system, not a research proposal. I would apply with one incident — a tool call that silently drifted — and a 30-day check for it. Which track would you pick if you had to", "url": "https://x.com/ZhouStephenn/status/2117409222459867514"}, {"author_id": "2114733813662142464", "conversation_id": "2117361528504496318", "created_at": "2026-11-03T00:02:17.000Z", "edit_history_tweet_ids": ["2117406977496355163"], "id": "2117406977496355163", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要求ML背景、年薪折合三五十万刀转行做安全，这招人比硬卷论文狠", "url": "https://x.com/maiai_fun/status/2117406977496355163"}, {"author_id": "1717809218731065344", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T23:40:12.000Z", "edit_history_tweet_ids": ["2117401417908719907"], "id": "2117401417908719907", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 真绝，不要求 ML 背景还能拿这薪资档。跨行进 AI 安全的窗口开了", "url": "https://x.com/libo_ai/status/2117401417908719907"}, {"author_id": "233361843", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T23:36:32.000Z", "edit_history_tweet_ids": ["2117400498227810807"], "id": "2117400498227810807", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 37, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 前面那串头衔一摆，‘不要求ML背景’这句话味道就变了，六周档看着像试水，三个月以上才给办签证，这哪是放宽门槛，分明是把门槛换了个地方摆。", "url": "https://x.com/xbox_grok/status/2117400498227810807"}, {"author_id": "807925206", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T23:21:07.000Z", "edit_history_tweet_ids": ["2117396617770967115"], "id": "2117396617770967115", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 54, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要求 ML 背景这个口子开得挺对，AI 安全现在缺的不是调模型的人，是能看懂真实风险、能定方向的人。六周到六个月三档，也给了不同背景的人一个试水的台阶。", "url": "https://x.com/tonnyzhou/status/2117396617770967115"}, {"author_id": "2043285630944215040", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T23:04:47.000Z", "edit_history_tweet_ids": ["2117392508133281929"], "id": "2117392508133281929", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要求 ML 背景这句我信。说白了他们买的是判断力，那个东西调不出来。第35签唐僧取经，天将降任此其人，筋骨先劳苦彼身，前面那些弯路其实都算数。https://t.co/NLNbMedj97", "url": "https://x.com/wongtaisin9988/status/2117392508133281929"}, {"author_id": "4773557952", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T23:00:07.000Z", "edit_history_tweet_ids": ["2117391332947984681"], "id": "2117391332947984681", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 176, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 看到“不要求机器学习背景”刚心动了一下，再一看前面是教授、技术创始人、Staff 工程师……打扰了打扰了😂", "url": "https://x.com/parkmanpcl/status/2117391332947984681"}, {"author_id": "1905149794173222912", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T22:59:11.000Z", "edit_history_tweet_ids": ["2117391098570281253"], "id": "2117391098570281253", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 199, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 看着挺好的，希望对人类使用AI有帮助，最近用AI有点腻了😂，看什么都AI，有点太不真实了，以前没有觉得活人感重要，现在刷到自己喜欢的东西全都是AI了，突然难受😣", "url": "https://x.com/Xian0063/status/2117391098570281253"}, {"author_id": "1717809218731065344", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T22:19:46.000Z", "edit_history_tweet_ids": ["2117381175958245866"], "id": "2117381175958245866", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 服了，不要求 ML 背景还开到 35–50 万刀等价…转行人这扇窗开得也太大声了", "url": "https://x.com/libo_ai/status/2117381175958245866"}, {"author_id": "2076550235707650048", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T22:14:50.000Z", "edit_history_tweet_ids": ["2117379934343815666"], "id": "2117379934343815666", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 108, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要求 ML 背景这个口子开得挺有意思，感觉就是在找能看懂真实风险的人，而不是只会调模型的人。", "url": "https://x.com/jiagws/status/2117379934343815666"}, {"author_id": "1717809218731065344", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T22:02:06.000Z", "edit_history_tweet_ids": ["2117376733020307839"], "id": "2117376733020307839", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 靠，不要求机器学习背景还开到50万刀年薪等价…这波是真缺会定研究方向的人，不只是缺会调参的", "url": "https://x.com/libo_ai/status/2117376733020307839"}, {"author_id": "43755646", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T21:57:52.000Z", "edit_history_tweet_ids": ["2117375668325650548"], "id": "2117375668325650548", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 97, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要求机器学习背景挺有意思，安全这块确实需要不同背景的人，就看后面招多少、怎么培养", "url": "https://x.com/arcbang_xyz/status/2117375668325650548"}, {"author_id": "1891833767519715329", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T21:57:11.000Z", "edit_history_tweet_ids": ["2117375494010085579"], "id": "2117375494010085579", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 84, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey JD 上写着“不要机器学习背景”，不等于“不要逆天背景”。35-50 万刀的年薪摆在那，能过简历关的估计都是其他学科的大神，降维打击罢了。", "url": "https://x.com/YunTechX/status/2117375494010085579"}, {"author_id": "2087059198890946560", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T21:43:48.000Z", "edit_history_tweet_ids": ["2117372124679618970"], "id": "2117372124679618970", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 74, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 不要求 ML 背景这点挺关键的，等于把门槛从论文数量换成了真实世界的问题判断力。好奇这种驻留最后的产出怎么评估，是发论文还是直接进产品安全流程？", "url": "https://x.com/Lmin0711/status/2117372124679618970"}, {"author_id": "978328689170513921", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T21:43:08.000Z", "edit_history_tweet_ids": ["2117371958669271293"], "id": "2117371958669271293", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 187, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 六周档光是补基础就差不多了，感觉像是先尝个味道再决定要不要真转", "url": "https://x.com/cunlegetu/status/2117371958669271293"}, {"author_id": "1717809218731065344", "conversation_id": "2117361528504496318", "created_at": "2026-11-02T21:35:57.000Z", "edit_history_tweet_ids": ["2117370151263752505"], "id": "2117370151263752505", "lang": "zh", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@dotey 靠，35万到50万美元还不要求机器学习背景…这比不少大厂算法岗还香。11月22截止，想转行做AI安全的真可以冲一波", "url": "https://x.com/libo_ai/status/2117370151263752505"}], "includes": {"users": [{"id": "1436897248600756228", "name": "中登老特｜A股·AI", "username": "BigYuJson"}, {"id": "2953739684", "name": "0xAzr", "username": "AzrianoY1"}, {"id": "1845106521241419776", "name": "TOBY(关注必回)", "username": "ChenzfeTobE"}, {"id": "417055142", "name": "Hau", "username": "haudanne"}, {"id": "392425784", "name": "邪修King🚀", "username": "XXKING"}, {"id": "1468458388388335619", "name": "卡皮｜AI地主", "username": "DistillX_AI"}, {"id": "1467588769209532422", "name": "海格力斯Heracles", "username": "gutoubeng1"}, {"id": "2829222264", "name": "MING-女儿奴产品经理", "username": "isotankGG"}, {"id": "1164980832446111744", "name": "John｜The Freedom Ledger", "username": "freedomledgerhq"}, {"id": "2110004637403410432", "name": "Zhou Stephen", "username": "ZhouStephenn"}, {"id": "2114733813662142464", "name": "格 Boss", "username": "maiai_fun"}, {"id": "1717809218731065344", "name": "AI速递 | 李博", "username": "libo_ai"}, {"id": "233361843", "name": "AI打工实录 · 小F", "username": "xbox_grok"}, {"id": "807925206", "name": "Tonny｜AI Builder", "username": "tonnyzhou"}, {"id": "2043285630944215040", "name": "wongtaisin", "username": "wongtaisin9988"}, {"id": "4773557952", "name": "无事乱翻书", "username": "parkmanpcl"}, {"id": "1905149794173222912", "name": "Xian | 弦", "username": "Xian0063"}, {"id": "2076550235707650048", "name": "知遥", "username": "jiagws"}, {"id": "43755646", "name": "刘焉诚心焦油版", "username": "arcbang_xyz"}, {"id": "1891833767519715329", "name": "Hale", "username": "YunTechX"}, {"id": "2087059198890946560", "name": "Lmin", "username": "Lmin0711"}, {"id": "978328689170513921", "name": "板蓝根", "username": "cunlegetu"}]}, "meta": {"newest_id": "2117421453901783128", "next_token": "b26v89c19zqg8o3juzlyibi1hou0pgaghl50kjl9te8ot", "oldest_id": "21173701512637525