5064004", "created_at": "2026-11-02T22:32:45.000Z", "edit_history_tweet_ids": ["2117384446575862084"], "entities": {"mentions": [{"end": 12, "id": "1573399256836309009", "start": 0, "username": "kimmonismus"}]}, "id": "2117384446575862084", "lang": "en", "note_tweet": {"text": "Arguing over the 48.1% is a distraction. Test the weight edit against standard SGD, throw Argon and Carbon on the exact same task. If everything passes, it's just another benchmark people figured out how to game. If it's literally just Astra, maybe start taking self-improvement seriously."}, "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117343192245064004", "type": "replied_to"}], "text": "@kimmonismus Arguing over the 48.1% is a distraction. Test the weight edit against standard SGD, throw Argon and Carbon on the exact same task. If everything passes, it's just another benchmark people figured out how to game. If it's literally just Astra, maybe start taking self-improvement", "url": "https://x.com/sitalump/status/2117384446575862084"}, {"author_id": "802225", "conversation_id": "2117343192245064004", "created_at": "2026-11-02T22:31:11.000Z", "edit_history_tweet_ids": ["2117384049237111136"], "entities": {"mentions": [{"end": 12, "id": "1573399256836309009", "start": 0, "username": "kimmonismus"}, {"end": 119, "id": "1285703391260184576", "start": 104, "username": "FaulknerPearce"}]}, "id": "2117384049237111136", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 15, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117343192245064004", "type": "replied_to"}], "text": "@kimmonismus Who needs distillation when you can have a model do \"Weight Surgery\" on your own model\n\nCC @FaulknerPearce", "url": "https://x.com/gubatron/status/2117384049237111136"}], "includes": {"media": [{"height": 920, "media_key": "3_2117343045393747968", "type": "photo", "url": "https://pbs.twimg.com/media/HWJQSBhWkAAMahP.jpg", "width": 1578}], "tweets": [{"attachments": {"media_keys": ["3_2117343045393747968"]}, "author_id": "1573399256836309009", "conversation_id": "2117343192245064004", "created_at": "2026-11-02T19:48:50.000Z", "edit_history_tweet_ids": ["2117343192245064004"], "entities": {"urls": [{"display_url": "pic.x.com/5xCbARrqnj", "end": 299, "expanded_url": "https://x.com/kimmonismus/status/2117343192245064004/photo/1", "media_key": "3_2117343045393747968", "start": 276, "url": "https://t.co/5xCbARrqnj"}, {"display_url": "x.com/rikiyatakehi/s…", "end": 323, "expanded_url": "https://twitter.com/rikiyatakehi/status/2117313742891327994", "start": 300, "url": "https://t.co/Xur29hFIhM"}]}, "id": "2117343192245064004", "lang": "en", "note_tweet": {"text": "Absolutely incredible: MIT researchers say GPT-6 Astra improved a small Qwen model’s math score from 7.9% to 48.1% by directly editing just 0.016% of its weights, without gradient-based training.\n\nThe result points toward AI systems that can diagnose and improve other models directly, a potential step toward self-improving AI."}, "public_metrics": {"bookmark_count": 1095, "impression_count": 134837, "like_count": 4232, "quote_count": 45, "reply_count": 144, "retweet_count": 281}, "referenced_tweets": [{"id": "2117313742891327994", "type": "quoted"}], "text": "Absolutely incredible: MIT researchers say GPT-6 Astra improved a small Qwen model’s math score from 7.9% to 48.1% by directly editing just 0.016% of its weights, without gradient-based training.\n\nThe result points toward AI systems that can diagnose and improve other models https://t.co/5xCbARrqnj https://t.co/Xur29hFIhM"}, {"author_id": "835970218966986753", "conversation_id": "2117343192245064004", "created_at": "2026-11-02T20:31:34.000Z", "edit_history_tweet_ids": ["2117353949359378576"], "entities": {"mentions": [{"end": 12, "id": "1573399256836309009", "start": 0, "username": "kimmonismus"}]}, "id": "2117353949359378576", "lang": "en", "note_tweet": {"text": "I'm skeptical with the true effectiveness of this in future applications given how small the model in this experiment is. Admittedly, I don't know the specific details of their metrics and benchmarking methods, but assuming the model is fairly weak (which I would think it is), this really doesn't mean much. (Ex: \"Great, the model went from thinking 1 + 1 = 3 to 1 + 1 = 2! that's like... a 100% improvement!\")\n\nNot to mention it's likely just easier to edit the weights of smaller models in general, given that there's just less to work with. When we scale this up to the tens and hundreds of billions, and then trillions of parameters, things may be drastically different, and this may no longer be practical. It's a cool finding, but likely nothing revolutionary. Had this been the key to RSI, frontier labs would've already found it and employed it a long while ago."}, "public_metrics": {"bookmark_count": 0, "impression_count": 471, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "referenced_tweets": [{"id": "2117343192245064004", "type": "replied_to"}], "text": "@kimmonismus I'm skeptical with the true effectiveness of this in future applications given how small the model in this experiment is. Admittedly, I don't know the specific details of their metrics and benchmarking methods, but assuming the model is fairly weak (which I would think it is),"}, {"author_id": "1650604841813549057", "conversation_id": "2117343192245064004", "created_at": "2026-11-02T22:51:06.000Z", "edit_history_tweet_ids": ["2117389063241994313"], "entities": {"mentions": [{"end": 16, "id": "2116324596626370560", "start": 0, "username": "JohnRoberts3000"}, {"end": 29, "id": "1573399256836309009", "start": 17, "username": "kimmonismus"}]}, "id": "2117389063241994313", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_co