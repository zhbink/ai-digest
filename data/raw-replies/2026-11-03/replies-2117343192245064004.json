": 0, "username": "kimmonismus"}]}, "id": "2117392307653878089", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117343192245064004", "type": "replied_to"}], "text": "@kimmonismus fixing 0.8B's reasoning loops with just 0.016% change is a huge leap forward", "url": "https://x.com/kimindiehacker/status/2117392307653878089"}, {"author_id": "2116324596626370560", "conversation_id": "2117343192245064004", "created_at": "2026-11-02T22:56:08.000Z", "edit_history_tweet_ids": ["2117390329309741425"], "entities": {"mentions": [{"end": 16, "id": "1650604841813549057", "start": 0, "username": "SimaoOl33486482"}, {"end": 29, "id": "1573399256836309009", "start": 17, "username": "kimmonismus"}]}, "id": "2117390329309741425", "lang": "en", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117389063241994313", "type": "replied_to"}], "text": "@SimaoOl33486482 @kimmonismus Exactly. You are psychopathic terrorists.", "url": "https://x.com/JohnRoberts3000/status/2117390329309741425"}, {"author_id": "1683402367", "conversation_id": "2117343192245064004", "created_at": "2026-11-02T22:56:06.000Z", "edit_history_tweet_ids": ["2117390321852072126"], "entities": {"mentions": [{"end": 12, "id": "1573399256836309009", "start": 0, "username": "kimmonismus"}]}, "id": "2117390321852072126", "lang": "en", "public_metrics": {"bookmark_count": 1, "impression_count": 61, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117355324029980713", "type": "replied_to"}], "text": "@kimmonismus 0.8B???????😱 😱 😱 😱 😱 Does this fit into a Raspy now? 🤔", "url": "https://x.com/mrtaanderson/status/2117390321852072126"}, {"author_id": "2305800024", "conversation_id": "2117343192245064004", "created_at": "2026-11-