{"data": [{"author_id": "2097716434931695617", "created_at": "2026-11-03T00:54:55.000Z", "edit_history_tweet_ids": ["2117420222663754099"], "id": "2117420222663754099", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu clawchat", "url": "https://x.com/lindaAnnearkr/status/2117420222663754099"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T22:35:06.000Z", "edit_history_tweet_ids": ["2117385034835337594"], "id": "2117385034835337594", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 玛德多层 Agent 这思路对，人盯五个会话本来就炸。Router 不给 Bash 这招挺清醒。", "url": "https://x.com/libo_ai/status/2117385034835337594"}, {"author_id": "1283963412599304192", "created_at": "2026-11-02T22:25:10.000Z", "edit_history_tweet_ids": ["2117382537949687883"], "id": "2117382537949687883", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 27, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 我用 Cursor 最大的痛点就是这个，Agent 什么都想自己干，复杂点的任务就一条路走到黑。“靠 Prompt 劝不住，得在架构上把手拿掉”这句说到点子上了，约束就得做进系统里，不能指望模型自觉。", "url": "https://x.com/bludr5/status/2117382537949687883"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T20:44:41.000Z", "edit_history_tweet_ids": ["2117357251157459196"], "id": "2117357251157459196", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 靠，Router不给Bash这招绝了。便宜模型只管派活，贵模型才下场干活——这才叫把钱花在刀刃上。", "url": "https://x.com/libo_ai/status/2117357251157459196"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T20:03:44.000Z", "edit_history_tweet_ids": ["2117346943999324300"], "id": "2117346943999324300", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 特么的，Router 连 Bash 都不给。\n这分层思路太稳了。", "url": "https://x.com/libo_ai/status/2117346943999324300"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T19:45:32.000Z", "edit_history_tweet_ids": ["2117342363173769392"], "id": "2117342363173769392", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 同时开 5 个 Agent 人真盯不过来，靠。Router 不给 Bash 这招挺清醒——便宜模型只派活，贵模型才下场干活。", "url": "https://x.com/libo_ai/status/2117342363173769392"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T18:39:42.000Z", "edit_history_tweet_ids": ["2117325797015073020"], "id": "2117325797015073020", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu Router 不碰 Bash 这招真绝——便宜模型守前台，贵的在后头干脏活", "url": "https://x.com/libo_ai/status/2117325797015073020"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T18:22:19.000Z", "edit_history_tweet_ids": ["2117321422469320771"], "id": "2117321422469320771", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 玛德这 Router/Worker 拆法太顺了。人只盯一个会话，后台并行推进——我之前开 5 个 Agent 真是把自己累死。", "url": "https://x.com/libo_ai/status/2117321422469320771"}, {"author_id": "2089016557246844928", "created_at": "2026-11-02T17:01:02.000Z", "edit_history_tweet_ids": ["2117300967054188841"], "id": "2117300967054188841", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 44, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 后台静默修bug的设定看着有点科幻", "url": "https://x.com/gamescrazy_jj/status/2117300967054188841"}, {"author_id": "1744735005199515648", "created_at": "2026-11-02T16:15:30.000Z", "edit_history_tweet_ids": ["2117289505724178775"], "id": "2117289505724178775", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu Router不给Bash这个设计最要紧，权限收口之后并行才开得放心", "url": "https://x.com/hahalin729/status/2117289505724178775"}, {"author_id": "2937082454", "created_at": "2026-11-02T16:09:13.000Z", "edit_history_tweet_ids": ["2117287926530982252"], "id": "2117287926530982252", "in_reply_to_user_id": "1643977766906494976", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117270960382660774", "type": "replied_to"}], "text": "@Miles_Piscis @xiaohu 冲突了别让 Router 凭感觉判，两边各跑一遍测试，谁过听谁的。", "url": "https://x.com/copol66/status/2117287926530982252"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T15:46:49.000Z", "edit_history_tweet_ids": ["2117282288916418886"], "id": "2117282288916418886", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 特么的 Router/Worker 这分层一说就通，人盯 5 个 Agent 本来就该交系统。", "url": "https://x.com/libo_ai/status/2117282288916418886"}, {"author_id": "2108438560416415744", "created_at": "2026-11-02T15:44:58.000Z", "edit_history_tweet_ids": ["2117281821792907358"], "id": "2117281821792907358", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 45, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 我去，连bash都不给router，从架构上就把它的手拿掉了，够狠hh", "url": "https://x.com/TedCai233/status/2117281821792907358"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T15:20:30.000Z", "edit_history_tweet_ids": ["2117275665984827512"], "id": "2117275665984827512", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu Router 不碰 Bash、Worker 隔离干活——人只盯一个入口，后台并行推。这才像「主 Agent」该有的形状。", "url": "https://x.com/libo_ai/status/2117275665984827512"}, {"author_id": "1643977766906494976", "created_at": "2026-11-02T15:01:48.000Z", "edit_history_tweet_ids": ["2117270960382660774"], "id": "2117270960382660774", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 95, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 最想知道的是几个 Worker 结果冲突时，Router 怎么判断该信谁。", "url": "https://x.com/Miles_Piscis/status/2117270960382660774"}, {"author_id": "45582017", "created_at": "2026-11-02T14:58:42.000Z", "edit_history_tweet_ids": ["2117270179382272364"], "id": "2117270179382272364", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 45, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 这种架构挺清爽，但 Worker 的失败原因别被 Router 吃掉，不然排查会很崩溃。", "url": "https://x.com/shuizhuyu/status/2117270179382272364"}, {"author_id": "991872400361836545", "created_at": "2026-11-02T14:58:22.000Z", "edit_history_tweet_ids": ["2117270096746016815"], "id": "2117270096746016815", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu Router 不给 Bash 这个设计很关键：负责沟通的那层没有执行权限，等于天然隔开了提示注入。剩下的难点是多个 Worker 同时改一个仓库时怎么防冲突。", "url": "https://x.com/EthanLinAI/status/2117270096746016815"}, {"author_id": "1585112383521189888", "created_at": "2026-11-02T14:55:10.000Z", "edit_history_tweet_ids": ["2117269290139475983"], "id": "2117269290139475983", "in_reply_to_user_id": "2115672486767693824", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117263214471733494", "type": "replied_to"}], "text": "@Alanogrok @xiaohu 入口统一后切换成本大降，多 Agent 协作顺多了", "url": "https://x.com/GaoXiaoxiao2022/status/2117269290139475983"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T14:54:30.000Z", "edit_history_tweet_ids": ["2117269120773210195"], "id": "2117269120773210195", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu Router不干活只派活，Worker闷头干——这套分层思路太实在了。同时开一堆Agent时，人盯不过来才是真痛点。", "url": "https://x.com/libo_ai/status/2117269120773210195"}, {"author_id": "45582017", "created_at": "2026-11-02T14:53:54.000Z", "edit_history_tweet_ids": ["2117268970969645441"], "id": "2117268970969645441", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 48, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 思路清楚，但5个Agent并行后，Token成本和上下文同步估计也会更头疼。", "url": "https://x.com/shuizhuyu/status/2117268970969645441"}, {"author_id": "2115672486767693824", "created_at": "2026-11-02T14:31:01.000Z", "edit_history_tweet_ids": ["2117263214471733494"], "id": "2117263214471733494", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 60, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 入口统一看着就省心!", "url": "https://x.com/Alanogrok/status/2117263214471733494"}, {"author_id": "2953739684", "created_at": "2026-11-02T14:26:33.000Z", "edit_history_tweet_ids": ["2117262087378682064"], "id": "2117262087378682064", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu Router 只派活、连 Bash 都不给，这个分工很清楚。\n\n新手最容易卡在同时开好几个 Agent，却不知道谁在干嘛。想问下两个 Worker 改到同一个文件时，Router 怎么处理冲突？", "url": "https://x.com/AzrianoY1/status/2117262087378682064"}, {"author_id": "2047905665537196032", "created_at": "2026-11-02T14:23:28.000Z", "edit_history_tweet_ids": ["2117261314783609203"], "id": "2117261314783609203", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 52, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 小互 十几年老粉 你不关注我一个", "url": "https://x.com/liaiyuheping/status/2117261314783609203"}, {"author_id": "329567918", "created_at": "2026-11-02T14:22:27.000Z", "edit_history_tweet_ids": ["2117261056372519286"], "id": "2117261056372519286", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 97, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu Router连Bash都不给，只管沟通派活，像极了只开会不写代码的PM😂 不过他们自己也说是合成负载的原型，先别急着抄", "url": "https://x.com/SeenFirstCN/status/2117261056372519286"}, {"author_id": "1073057472640884736", "created_at": "2026-11-02T14:19:10.000Z", "edit_history_tweet_ids": ["2117260232632193369"], "id": "2117260232632193369", "in_reply_to_user_id": "1764818331822182400", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117252023754326117", "type": "replied_to"}], "text": "@xiaohu 总管只派活不碰Bash这套我天天在用，底下十几个专职bot各干各的。真出事的地方不在worker，是总管派错人，活干得再好也白干，router省模型钱我觉得省错了地方", "url": "https://x.com/garygao100/status/2117260232632193369"}], "includes": {"users": [{"id": "2097716434931695617", "name": "linda Anne", "username": "lindaAnnearkr"}, {"id": "1717809218731065344", "name": "AI速递 | 李博", "username": "libo_ai"}, {"id": "1283963412599304192", "name": "全哥AI创业记", "username": "bludr5"}, {"id": "2089016557246844928", "name": "JimJiang", "username": "gamescrazy_jj"}, {"id": "1744735005199515648", "name": "haha lin", "username": "hahalin729"}, {"id": "2937082454", "name": "水里的鱼", "username": "copol66"}, {"id": "2108438560416415744", "name": "Ted Cai", "username": "TedCai233"}, {"id": "1643977766906494976", "name": "Kalau", "username": "Miles_Piscis"}, {"id": "45582017", "name": "Crio Songo", "username": "shuizhuyu"}, {"id": "991872400361836545", "name": "Ethan Lin", "username": "EthanLinAI"}, {"id": "1585112383521189888", "name": "高胜寒", "username": "GaoXiaoxiao2022"}, {"id": "2115672486767693824", "name": "Alano", "username": "Alanogrok"}, {"id": "2953739684", "name": "0xAzr", "username": "AzrianoY1"}, {"id": "2047905665537196032", "name": "lapaaa", "username": "liaiyuheping"}, {"id": "329567918", "name": "SeenFirstCN", "username": "SeenFirstCN"}, {"id": "1073057472640884736", "name": "Gary", "username": "garygao100"}]}, "meta": {"newest_id": "2117420222663754099", "next_token": "b26v89c19zqg8o3juzlyi9d0jxpjwj6g6itlwz5v9rl31", "oldest_id": "2117260232632193369", "result_count": 25}}