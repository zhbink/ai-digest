{"data": [{"author_id": "1374925935389011968", "created_at": "2026-11-03T01:12:50.000Z", "edit_history_tweet_ids": ["2117424732421464423"], "id": "2117424732421464423", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 线程只能往后加，删掉失败调用也得重开一个", "url": "https://x.com/Rui_Wang010702/status/2117424732421464423"}, {"author_id": "1957843228842946566", "created_at": "2026-11-03T01:05:55.000Z", "edit_history_tweet_ids": ["2117422992649011300"], "id": "2117422992649011300", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 不省钱但首字快 35%，对跑长 agent 的人比对聊天用户有用。5 分钟闲置就过期这点也得记着，中途停太久等于白开", "url": "https://x.com/lawson_ste3476/status/2117422992649011300"}, {"author_id": "366623366", "created_at": "2026-11-03T00:50:00.000Z", "edit_history_tweet_ids": ["2117418987097346471"], "id": "2117418987097346471", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 终于不用每轮都给 Claude 复述一遍前情提要了。就是闲置 5 分钟过期有点狠，上个厕所回来它就失忆了。", "url": "https://x.com/_Songzioeve/status/2117418987097346471"}, {"author_id": "392425784", "created_at": "2026-11-03T00:36:20.000Z", "edit_history_tweet_ids": ["2117415544014180606"], "id": "2117415544014180606", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 长对话不用每轮重发历史，Message Threads 这刀砍在延迟和带宽上。", "url": "https://x.com/XXKING/status/2117415544014180606"}, {"author_id": "1136830981736947712", "created_at": "2026-11-03T00:20:02.000Z", "edit_history_tweet_ids": ["2117411443293262235"], "id": "2117411443293262235", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 长对话不用每轮把历史再贴一遍，这才像人话。我这边重发上下文，额度看着心疼。", "url": "https://x.com/Jeree12408242/status/2117411443293262235"}, {"author_id": "1716669697452560385", "created_at": "2026-11-03T00:05:58.000Z", "edit_history_tweet_ids": ["2117407904173277191"], "id": "2117407904173277191", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 对自己搭 Agent 的人挺实用：长任务每轮都重发历史，跑到后面几十轮光传上下文就慢了。想问下“暂存几分钟”具体是多久？Agent 等人拍板经常一等就是半小时，过期了是不是还得把整段对话重发一遍？", "url": "https://x.com/randy102488/status/2117407904173277191"}, {"author_id": "2114733813662142464", "created_at": "2026-11-03T00:04:38.000Z", "edit_history_tweet_ids": ["2117407570264560024"], "id": "2117407570264560024", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 长对话不用每轮重发历史，延迟下来价格还不变，这才像给人用的API", "url": "https://x.com/maiai_fun/status/2117407570264560024"}, {"author_id": "2008900298085900288", "created_at": "2026-11-02T23:53:22.000Z", "edit_history_tweet_ids": ["2117404734894272559"], "id": "2117404734894272559", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 33, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 你把省上传不省钱和 5 分钟过期这两个限制拎得很清楚。Anthropic 这个设计只管连续高频对话，一旦遇到人类去泡杯咖啡超过 300 秒，程序还得老老实实把 800 KB 历史重发一遍，本地状态管理一点没少。", "url": "https://x.com/Neo19990331/status/2117404734894272559"}, {"author_id": "2109248928461807616", "created_at": "2026-11-02T23:49:34.000Z", "edit_history_tweet_ids": ["2117403776046780542"], "id": "2117403776046780542", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 切正式流量前先拿一条短对话测两轮：只传新消息 + 上一条 ID，核对延迟和上下文是否还在。通了再换长会话，别一上来整段历史照塞。", "url": "https://x.com/AutoWithAI_CN/status/2117403776046780542"}, {"author_id": "3172361192", "created_at": "2026-11-02T23:47:44.000Z", "edit_history_tweet_ids": ["2117403315944435924"], "id": "2117403315944435924", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 对用API做图、做视频的人来说，带图的长对话很实用：让Claude一轮轮看关键帧、挑分镜，以前每轮都要把几十张图重新传一遍，现在只传新的。不过token省不了，图多的对话消耗不会变少", "url": "https://x.com/geek_zard/status/2117403315944435924"}, {"author_id": "807925206", "created_at": "2026-11-02T23:26:19.000Z", "edit_history_tweet_ids": ["2117397924766441489"], "id": "2117397924766441489", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 这个改进对长对话是实打实的，800KB 降到 1.8KB 这个量级，首字延迟能下来不少。就是 5 分钟过期这点得记牢，本地完整记录还是不能丢。", "url": "https://x.com/tonnyzhou/status/2117397924766441489"}, {"author_id": "318891480", "created_at": "2026-11-02T23:04:16.000Z", "edit_history_tweet_ids": ["2117392375031161337"], "id": "2117392375031161337", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 11, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 接入时可以单独测「过期后续聊」和「切换工具重建」两条路径，核对历史工具结果有没有漏、已完成的动作有没有被重做。恢复流程跑稳，长任务才省心。", "url": "https://x.com/growaiskills/status/2117392375031161337"}, {"author_id": "1456481042139738114", "created_at": "2026-11-02T22:51:49.000Z", "edit_history_tweet_ids": ["2117389244201324587"], "id": "2117389244201324587", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 26, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 长对话不用每轮重发历史，对做应用的人来说既省钱又省事，响应还更快", "url": "https://x.com/Andydisobey/status/2117389244201324587"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T22:35:20.000Z", "edit_history_tweet_ids": ["2117385096265412686"], "id": "2117385096265412686", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 长对话终于不用整段重发历史了，靠，做 Agent 的人都该松一口气。首字延迟下来才是真体验。", "url": "https://x.com/libo_ai/status/2117385096265412686"}, {"author_id": "1672819239911055360", "created_at": "2026-11-02T22:28:28.000Z", "edit_history_tweet_ids": ["2117383367196844393"], "id": "2117383367196844393", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 79, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 长对话不用每轮重发历史，速度涨、价不变。付钱的人要的就是少烧一轮、少等一轮😏", "url": "https://x.com/DeepSuck69/status/2117383367196844393"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T22:20:13.000Z", "edit_history_tweet_ids": ["2117381291540664448"], "id": "2117381291540664448", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 特么的终于来了，长对话别再每次塞整段历史，Agent 跑几十万 token 时这招太香", "url": "https://x.com/libo_ai/status/2117381291540664448"}, {"author_id": "2000271107488907264", "created_at": "2026-11-02T22:17:26.000Z", "edit_history_tweet_ids": ["2117380592149090591"], "id": "2117380592149090591", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 에이전트처럼 수십 번 도구를 오가는 긴 작업에서야 진가가 드러날 것 같아요. 다만 스레드가 중간에 만료되면 처음부터 다시 쌓아야 하니, 긴 작업일수록 체크포인트를 직접 남겨두는 게 안전하지 않을까요?", "url": "https://x.com/robix2601/status/2117380592149090591"}, {"author_id": "2076550235707650048", "created_at": "2026-11-02T22:17:03.000Z", "edit_history_tweet_ids": ["2117380495189397749"], "id": "2117380495189397749", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 49, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 长对话最烦的就是每次都要把历史再搬一遍，这个算是把脏活交给服务端了，挺省心的。", "url": "https://x.com/jiagws/status/2117380495189397749"}, {"author_id": "1622232571999567873", "created_at": "2026-11-02T22:06:36.000Z", "edit_history_tweet_ids": ["2117377865251762181"], "id": "2117377865251762181", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 31, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 暂存只有几分钟，隔久了续聊还是得自己带上历史。", "url": "https://x.com/Pengchenop/status/2117377865251762181"}, {"author_id": "1891833767519715329", "created_at": "2026-11-02T22:05:11.000Z", "edit_history_tweet_ids": ["2117377506022146380"], "id": "2117377506022146380", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 总算不用每次请求都跟背砖头一样把整段历史倒给 API 了。上下文能常驻省下不少带宽和延迟，开发者手里的轮子又能少造一个。", "url": "https://x.com/YunTechX/status/2117377506022146380"}, {"author_id": "1717809218731065344", "created_at": "2026-11-02T22:02:46.000Z", "edit_history_tweet_ids": ["2117376900079161812"], "id": "2117376900079161812", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 玛德终于缓存历史了，长对话Agent每轮重传那套太折磨人，首字快35%这数字挺实在", "url": "https://x.com/libo_ai/status/2117376900079161812"}, {"author_id": "2087059198890946560", "created_at": "2026-11-02T21:48:31.000Z", "edit_history_tweet_ids": ["2117373311558754739"], "id": "2117373311558754739", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 40, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 价格不变这点容易被误读，省的是往返和首字延迟，不是 token 量。真正划算的场景是高频短轮次对话，长任务还是得自己留快照，不然一过期就得重发。", "url": "https://x.com/Lmin0711/status/2117373311558754739"}, {"author_id": "1527316617117712385", "created_at": "2026-11-02T21:06:37.000Z", "edit_history_tweet_ids": ["2117362769330876706"], "id": "2117362769330876706", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 補充一個細節：thread 最後一次請求後 5 分鐘就過期，最多 1 小時會刪掉，過期再 continue 會回 404，要重送完整對話。所以本地還是要自己存一份歷史，省到的是首字延遲，不是 token 費用。", "url": "https://x.com/Bruce32099549/status/2117362769330876706"}, {"author_id": "912353140938178560", "created_at": "2026-11-02T21:05:00.000Z", "edit_history_tweet_ids": ["2117362362282041619"], "id": "2117362362282041619", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 30, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 学习了", "url": "https://x.com/justinxjx/status/2117362362282041619"}, {"author_id": "1164980832446111744", "created_at": "2026-11-02T21:02:41.000Z", "edit_history_tweet_ids": ["2117361780322394410"], "id": "2117361780322394410", "in_reply_to_user_id": "3178231", "public_metrics": {"bookmark_count": 0, "impression_count": 26, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117339521683448221", "type": "replied_to"}], "text": "@dotey 省上传时间和省token费用，确实得分开看。", "url": "https://x.com/freedomledgerhq/status/2117361780322394410"}], "includes": {"users": [{"id": "1374925935389011968", "name": "莫燚洛", "username": "Rui_Wang010702"}, {"id": "1957843228842946566", "name": "太初学社", "username": "lawson_ste3476"}, {"id": "366623366", "name": "松子 Songzi", "username": "_Songzioeve"}, {"id": "392425784", "name": "邪修King🚀", "username": "XXKING"}, {"id": "1136830981736947712", "name": "Jeree", "username": "Jeree12408242"}, {"id": "1716669697452560385", "name": "Randy｜大白话讲 AI", "username": "randy102488"}, {"id": "2114733813662142464", "name": "格 Boss", "username": "maiai_fun"}, {"id": "2008900298085900288", "name": "Neo", "username": "Neo19990331"}, {"id": "2109248928461807616", "name": "AI自动化笔记", "username": "AutoWithAI_CN"}, {"id": "3172361192", "name": "geekzard", "username": "geek_zard"}, {"id": "807925206", "name": "Tonny｜AI Builder", "username": "tonnyzhou"}, {"id": "318891480", "name": "Marvin", "username": "growaiskills"}, {"id": "1456481042139738114", "name": "Andy备忘录", "username": "Andydisobey"}, {"id": "1717809218731065344", "name": "AI速递 | 李博", "username": "libo_ai"}, {"id": "1672819239911055360", "name": "大鹏博士", "username": "DeepSuck69"}, {"id": "2000271107488907264", "name": "Faron Robin", "username": "robix2601"}, {"id": "2076550235707650048", "name": "知遥", "username": "jiagws"}, {"id": "1622232571999567873", "name": "黑大王", "username": "Pengchenop"}, {"id": "1891833767519715329", "name": "Hale", "username": "YunTechX"}, {"id": "2087059198890946560", "name": "Lmin", "username": "Lmin0711"}, {"id": "1527316617117712385", "name": "Bruce｜一人＋AI團隊創業", "username": "Bruce32099549"}, {"id": "912353140938178560", "name": "贾斯汀星🌟(浇朋友版followback)", "username": "justinxjx"}, {"id": "1164980832446111744", "name": "John｜The Freedom Ledger", "username": "freedomledgerhq"}]}, "meta": {"newest_id": "2117424732421464423", "next_token": "b26v89c19zqg8o3juzlyibhqqtd44ww1ftszwx3vp8prx", "oldest_id": "2117361780322394410", "result_count": 25}}