ername": "MichaelTontchev"}, {"id": "43363760", "name": "mash tun", "public_metrics": {"followers_count": 4059, "following_count": 1011, "like_count": 27286, "listed_count": 44, "media_count": 2637, "tweet_count": 24796}, "username": "MashTunTimmy"}, {"id": "46498861", "name": "Raúl Nogales 🇪🇸🇺🇸", "public_metrics": {"followers_count": 14056, "following_count": 167, "like_count": 3791, "listed_count": 99, "media_count": 689, "tweet_count": 12125}, "username": "raulnogales"}, {"id": "1657085783507886094", "name": "rufo.ai 💻", "public_metrics": {"followers_count": 627, "following_count": 1280, "like_count": 2211, "listed_count": 0, "media_count": 133, "tweet_count": 790}, "username": "rufo_ai"}, {"id": "150454415", "name": "Ardent Crayon", "public_metrics": {"followers_count": 727, "following_count": 978, "like_count": 199843, "listed_count": 17, "media_count": 1236, "tweet_count": 26463}, "username": "ArdentCrayon"}, {"id": "1632866302132879362", "name": "AI_Enthused", "public_metrics": {"followers_count": 984, "following_count": 672, "like_count": 3705, "listed_count": 19, "media_count": 77, "tweet_count": 815}, "username": "ai_enthused"}]}, "meta": {"newest_id": "2117425475987656729", "next_token": "b26v89c19zqg8o3juzlyibin5mbloj3gkdoizlaienvr1", "oldest_id": "2117392854498832547", "result_count": 25}}