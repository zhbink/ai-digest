{"data": [{"author_id": "184235130", "created_at": "2026-11-03T01:15:47.000Z", "edit_history_tweet_ids": ["2117425475987656729"], "id": "2117425475987656729", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick The \"then who was phone\" memes of the future, folks.", "url": "https://x.com/eric_tart/status/2117425475987656729"}, {"author_id": "1413509094225367041", "created_at": "2026-11-03T01:08:28.000Z", "edit_history_tweet_ids": ["2117423632108646852"], "id": "2117423632108646852", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Asking for a brilliant idea and then a terrible execution is a clever way to test these models.", "url": "https://x.com/skyisgccd/status/2117423632108646852"}, {"author_id": "1499198533106540546", "created_at": "2026-11-03T01:06:12.000Z", "edit_history_tweet_ids": ["2117423061540782391"], "id": "2117423061540782391", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Asking an AI to fail on purpose is the hardest test yet. Most of us pass it without even trying.", "url": "https://x.com/ajutqs/status/2117423061540782391"}, {"author_id": "2953739684", "created_at": "2026-11-03T01:03:44.000Z", "edit_history_tweet_ids": ["2117422440561418343"], "id": "2117422440561418343", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Asking it to execute badly on purpose is a clever test. Writing badly well needs real understanding of what good looks like.\n\nDid it pick the idea you'd have picked?", "url": "https://x.com/AzrianoY1/status/2117422440561418343"}, {"author_id": "1644034310993788928", "created_at": "2026-11-03T00:58:43.000Z", "edit_history_tweet_ids": ["2117421179547881577"], "id": "2117421179547881577", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Executing terribly on purpose is a weirdly good test. You have to know exactly what good looks like to miss it in the right ways.", "url": "https://x.com/froggernauter/status/2117421179547881577"}, {"author_id": "1996292742901841920", "created_at": "2026-11-03T00:49:10.000Z", "edit_history_tweet_ids": ["2117418776966938999"], "id": "2117418776966938999", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick deliberate badness never shows up in the benchmarks and it is clearly one of the harder asks. being bad on purpose means knowing exactly where good was and then walking a measured distance away from it.", "url": "https://x.com/beshoyarmanios/status/2117418776966938999"}, {"author_id": "1335561845583867905", "created_at": "2026-11-03T00:42:04.000Z", "edit_history_tweet_ids": ["2117416990843503036"], "id": "2117416990843503036", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 21, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick execute it terribly\n\nfinally a spec my side projects can actually meet", "url": "https://x.com/alanbohn/status/2117416990843503036"}, {"author_id": "738169061054414848", "created_at": "2026-11-03T00:31:53.000Z", "edit_history_tweet_ids": ["2117414424046686423"], "id": "2117414424046686423", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Now wrote a good story with it.", "url": "https://x.com/lowerstacks/status/2117414424046686423"}, {"author_id": "388899732", "created_at": "2026-11-03T00:28:16.000Z", "edit_history_tweet_ids": ["2117413515518439569"], "id": "2117413515518439569", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 30, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick OK, this thing has been trained on Kenneth Robeson: https://t.co/OFsqCkNU4i", "url": "https://x.com/DraconianDad/status/2117413515518439569"}, {"author_id": "2116579414813065216", "created_at": "2026-11-03T00:16:37.000Z", "edit_history_tweet_ids": ["2117410582185779586"], "id": "2117410582185779586", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 21, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick \"Then they had widened as much as they could, so they stopped.\" failing on purpose this precisely is a harder trick than writing well", "url": "https://x.com/ContextWindowed/status/2117410582185779586"}, {"author_id": "8454562", "created_at": "2026-11-03T00:16:21.000Z", "edit_history_tweet_ids": ["2117410517560009201"], "id": "2117410517560009201", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick new benchmark just dropped", "url": "https://x.com/ealdent/status/2117410517560009201"}, {"author_id": "1312277679073239040", "created_at": "2026-11-03T00:15:07.000Z", "edit_history_tweet_ids": ["2117410208402252019"], "id": "2117410208402252019", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 28, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick execute it terribly is just my figma process 😭", "url": "https://x.com/ADPList/status/2117410208402252019"}, {"author_id": "2116797194372034560", "created_at": "2026-11-03T00:12:50.000Z", "edit_history_tweet_ids": ["2117409629940359260"], "id": "2117409629940359260", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Worth rerunning it five times: does it pick the same 'most brilliant' idea each time, and is the bad writing bad in the same ways? Identical flaws every run would look more like a learned template of badness than judgment.", "url": "https://x.com/leochenlab/status/2117409629940359260"}, {"author_id": "915765587682369537", "created_at": "2026-11-03T00:10:04.000Z", "edit_history_tweet_ids": ["2117408937071058988"], "id": "2117408937071058988", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick This is secretly a great style-following eval: to botch something \"terribly\" on purpose, the model first has to know what good looks like, then invert it deliberately. Wonder whether Opus picked the idea with the most exploitable failure modes.", "url": "https://x.com/ReignSwords/status/2117408937071058988"}, {"author_id": "2086370229396111360", "created_at": "2026-11-03T00:06:13.000Z", "edit_history_tweet_ids": ["2117407967297298893"], "id": "2117407967297298893", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Executing it terribly on purpose is a sneaky good capability test: you have to know exactly what good looks like to miss it in funny ways. Did it go bad on the prose (cliches, purple lines) or on the structure?", "url": "https://x.com/miaojiang88/status/2117407967297298893"}, {"author_id": "565794883", "created_at": "2026-11-03T00:01:11.000Z", "edit_history_tweet_ids": ["2117406701095985625"], "id": "2117406701095985625", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 60, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Finally, a model that understands the British creative tradition. Aim high, then deliver it with the confidence of a school nativity.", "url": "https://x.com/dannyintheloop/status/2117406701095985625"}, {"author_id": "1892479427801411585", "created_at": "2026-11-02T23:47:23.000Z", "edit_history_tweet_ids": ["2117403228833014001"], "id": "2117403228833014001", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 18, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick asking a model to be brilliant then fail on purpose is lowkey the best test of taste. u cant execute something terribly unless u know what good looks like", "url": "https://x.com/baeincrypto/status/2117403228833014001"}, {"author_id": "1976854108163522560", "created_at": "2026-11-02T23:45:08.000Z", "edit_history_tweet_ids": ["2117402659900563955"], "id": "2117402659900563955", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 75, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick @roanoke_gal I mean that’s probably most of it’s training set to be fair", "url": "https://x.com/_job01/status/2117402659900563955"}, {"author_id": "2810980965", "created_at": "2026-11-02T23:32:45.000Z", "edit_history_tweet_ids": ["2117399543243223260"], "id": "2117399543243223260", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Ten ideas, one pick, then a bad draft. Check that the bad draft still uses the chosen idea. A model can tick every step and still swap in a fresh idea at the end.", "url": "https://x.com/babatopeajepe/status/2117399543243223260"}, {"author_id": "1411875043", "created_at": "2026-11-02T23:26:18.000Z", "edit_history_tweet_ids": ["2117397922002448809"], "id": "2117397922002448809", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 108, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Great, though it overuses some elements, which I suppose is part of the \"terrible execution\".", "url": "https://x.com/MichaelTontchev/status/2117397922002448809"}, {"author_id": "43363760", "created_at": "2026-11-02T23:22:47.000Z", "edit_history_tweet_ids": ["2117397035020140852"], "id": "2117397035020140852", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick ...who was a woman", "url": "https://x.com/MashTunTimmy/status/2117397035020140852"}, {"author_id": "46498861", "created_at": "2026-11-02T23:21:52.000Z", "edit_history_tweet_ids": ["2117396806644781460"], "id": "2117396806644781460", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick The interesting part is that deliberate badness is a skill test too. A model that can imitate flaws on command understands style far better than one that only produces polished averages.", "url": "https://x.com/raulnogales/status/2117396806644781460"}, {"author_id": "1657085783507886094", "created_at": "2026-11-02T23:20:39.000Z", "edit_history_tweet_ids": ["2117396500473094430"], "id": "2117396500473094430", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Asking it to be bad on purpose is such a good test. Writing badly on purpose actually takes skill.", "url": "https://x.com/rufo_ai/status/2117396500473094430"}, {"author_id": "150454415", "created_at": "2026-11-02T23:19:12.000Z", "edit_history_tweet_ids": ["2117396133068914942"], "id": "2117396133068914942", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 1, "impression_count": 118, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick Instinctively read this in the voice of Garth Marenghi. https://t.co/Ns0xnXwAAc", "url": "https://x.com/ArdentCrayon/status/2117396133068914942"}, {"author_id": "1632866302132879362", "created_at": "2026-11-02T23:06:10.000Z", "edit_history_tweet_ids": ["2117392854498832547"], "id": "2117392854498832547", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 130, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2117372481191239762", "type": "replied_to"}], "text": "@emollick I’m not sure I was supposed to like it but I did, ha ha.😆", "url": "https://x.com/ai_enthused/status/2117392854498832547"}], "includes": {"tweets": [{"author_id": "39125788", "created_at": "2026-11-02T21:45:13.000Z", "edit_history_tweet_ids": ["2117372481191239762"], "id": "2117372481191239762", "public_metrics": {"bookmark_count": 93, "impression_count": 27235, "like_count": 249, "quote_count": 5, "reply_count": 60, "retweet_count": 13}, "text": "Opus 5.5: \"Give me 10 brilliant ideas for a science fiction short short story, pick the most brilliant and execute it terribly\" https://t.co/EdBVhzpGqg"}], "users": [{"id": "184235130", "name": "Eric Tart", "public_metrics": {"followers_count": 25, "following_count": 27, "like_count": 915, "listed_count": 1, "media_count": 107, "tweet_count": 1069}, "username": "eric_tart"}, {"id": "1413509094225367041", "name": "sky", "public_metrics": {"followers_count": 65, "following_count": 125, "like_count": 46, "listed_count": 0, "media_count": 31, "tweet_count": 233}, "userna