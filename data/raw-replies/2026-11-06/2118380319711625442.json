{"data": [{"author_id": "134144896", "created_at": "2026-11-05T21:41:40.000Z", "edit_history_tweet_ids": ["2118458751816458369"], "id": "2118458751816458369", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator Impressive growth, but the real test is scaling pilots into fully autonomous ops", "url": "https://x.com/dcsan/status/2118458751816458369"}, {"author_id": "2813056513", "created_at": "2026-11-05T20:02:20.000Z", "edit_history_tweet_ids": ["2118433753626464490"], "id": "2118433753626464490", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator Those first factory visits make a great story. I think creators plant teams follow could explain industrial tools. Creator search, campaign planning, briefs and proposals are free on Chals Channel. Happy to help teams build a first campaign for their audience", "url": "https://x.com/Ignaciosolere/status/2118433753626464490"}, {"author_id": "1765407801445167104", "created_at": "2026-11-05T20:02:18.000Z", "edit_history_tweet_ids": ["2118433745598627946"], "id": "2118433745598627946", "in_reply_to_user_id": "963737004847652864", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118393800901185725", "type": "replied_to"}], "text": "@igmarinelli @ycombinator Interesting. PMF strikes again. Great blueprint to know. Best of luck my man", "url": "https://x.com/jstnsinon/status/2118433745598627946"}, {"author_id": "1931235626", "created_at": "2026-11-05T19:37:49.000Z", "edit_history_tweet_ids": ["2118427584543576163"], "id": "2118427584543576163", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator Shipping their own vibration and ultrasound sensors is why the AI side works here. Most factories lack clean machine logs, so owning the sensor hardware is the only reliable way to capture failure data worth training on.", "url": "https://x.com/MosheshSabelo/status/2118427584543576163"}, {"author_id": "127754327", "created_at": "2026-11-05T19:03:50.000Z", "edit_history_tweet_ids": ["2118419033964089708"], "id": "2118419033964089708", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380320504402364", "type": "replied_to"}], "text": "@ycombinator what’s this about?", "url": "https://x.com/bgv1806/status/2118419033964089708"}, {"author_id": "1856728854934482944", "created_at": "2026-11-05T19:01:19.000Z", "edit_history_tweet_ids": ["2118418401018413353"], "id": "2118418401018413353", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 1465, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118402967808487546", "type": "quoted"}, {"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator physical ai and game ai converge on the same problem: decisions under uncertainty with partial information https://t.co/okqAyofvqS", "url": "https://x.com/notmiramurati/status/2118418401018413353"}, {"author_id": "619784530", "created_at": "2026-11-05T18:47:38.000Z", "edit_history_tweet_ids": ["2118414956005597364"], "id": "2118414956005597364", "in_reply_to_user_id": "963737004847652864", "public_metrics": {"bookmark_count": 0, "impression_count": 26, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118392940250923387", "type": "replied_to"}], "text": "@igmarinelli @ycombinator @harjtaggar @daltonc Good to have those kind of people. Well done", "url": "https://x.com/Tino_Ferreira23/status/2118414956005597364"}, {"author_id": "2040133663023669249", "created_at": "2026-11-05T18:40:48.000Z", "edit_history_tweet_ids": ["2118413235561050363"], "id": "2118413235561050363", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 18, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator downtime's worst nightmare, congrats @tractian", "url": "https://x.com/autonomousevent/status/2118413235561050363"}, {"author_id": "1428641903172591618", "created_at": "2026-11-05T18:35:31.000Z", "edit_history_tweet_ids": ["2118411906666906047"], "id": "2118411906666906047", "in_reply_to_user_id": "9151842", "public_metrics": {"bookmark_count": 0, "impression_count": 23, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118393431596929186", "type": "replied_to"}], "text": "@daltonc @igmarinelli @ycombinator @harjtaggar Still remember our office hours and you talking about our headline - \"Shazam for the industry\", you were right, way more than that! Onward and upward!! Thanks for all the support", "url": "https://x.com/leonardolvieira/status/2118411906666906047"}, {"author_id": "46498861", "created_at": "2026-11-05T18:30:44.000Z", "edit_history_tweet_ids": ["2118410703610712424"], "id": "2118410703610712424", "in_reply_to_user_id": "963737004847652864", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118405615160881621", "type": "replied_to"}], "text": "@igmarinelli @ycombinator At 6x the interesting question is what sits inside that number. Rollout, integration, retraining the team. Where does it usually break for the plants that do not get to 6x?", "url": "https://x.com/raulnogales/status/2118410703610712424"}, {"author_id": "86370467", "created_at": "2026-11-05T18:28:42.000Z", "edit_history_tweet_ids": ["2118410189921505446"], "id": "2118410189921505446", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator @ycombinator The path from plant-floor pain to a paid pilot is the interesting part. In practice, I would want the first metric to be mean time to diagnose a real fault, not only dashboard coverage. How early did operators trust the alerts enough to change a maintenance schedule?", "url": "https://x.com/benyprof/status/2118410189921505446"}, {"author_id": "21316283", "created_at": "2026-11-05T18:24:55.000Z", "edit_history_tweet_ids": ["2118409239995539645"], "id": "2118409239995539645", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator Predicting failure before the line stops is where the money is.\n\nDowntime costs more than most people want to admit.", "url": "https://x.com/lostwillee/status/2118409239995539645"}, {"author_id": "1507653715158659076", "created_at": "2026-11-05T18:17:22.000Z", "edit_history_tweet_ids": ["2118407340190036208"], "id": "2118407340190036208", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator Software ate the world. Now it is quietly learning to listen to the machines in it.", "url": "https://x.com/iamayushrawat/status/2118407340190036208"}, {"author_id": "963737004847652864", "created_at": "2026-11-05T18:10:31.000Z", "edit_history_tweet_ids": ["2118405615160881621"], "id": "2118405615160881621", "in_reply_to_user_id": "46498861", "public_metrics": {"bookmark_count": 0, "impression_count": 21, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118405356972077423", "type": "replied_to"}], "text": "@raulnogales @ycombinator The ROI is huge, 6x generally at least", "url": "https://x.com/igmarinelli/status/2118405615160881621"}, {"author_id": "963737004847652864", "created_at": "2026-11-05T18:10:11.000Z", "edit_history_tweet_ids": ["2118405533149573261"], "id": "2118405533149573261", "in_reply_to_user_id": "206720696", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118394808532382100", "type": "replied_to"}], "text": "@cheneypiano @ycombinator They intrinsically get it", "url": "https://x.com/igmarinelli/status/2118405533149573261"}, {"author_id": "46498861", "created_at": "2026-11-05T18:09:29.000Z", "edit_history_tweet_ids": ["2118405356972077423"], "id": "2118405356972077423", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 30, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator Industrial AI has a clear scoreboard: downtime avoided. That is why it pays for itself faster than office AI, where the benefit is harder to measure and easier to dispute.", "url": "https://x.com/raulnogales/status/2118405356972077423"}, {"author_id": "253562419", "created_at": "2026-11-05T18:08:49.000Z", "edit_history_tweet_ids": ["2118405188822372480"], "id": "2118405188822372480", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator The Gulf could be a big market for this. The UAE aims to lift industry's contribution to GDP to AED 300 billion by 2031, and plants there run through summer days above 45°C. Heat ages bearings and insulation faster, so early warning pays more there than in a mild climate.", "url": "https://x.com/kashifim/status/2118405188822372480"}, {"author_id": "2031662129720557568", "created_at": "2026-11-05T18:01:45.000Z", "edit_history_tweet_ids": ["2118403408428445717"], "id": "2118403408428445717", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator This is a great example of AI solving real industrial problems. Predicting equipment failures before they happen can save companies significant time, money, and downtime", "url": "https://x.com/craftos_team/status/2118403408428445717"}, {"author_id": "2107470915994865664", "created_at": "2026-11-05T17:44:54.000Z", "edit_history_tweet_ids": ["2118399167014035746"], "id": "2118399167014035746", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator This is the AI wave that matters for construction too — sensors and prediction on physical assets, not just chatbots. Downtime on a site or in a plant costs real money. Glad YC is backing the high-stakes side of physical AI.", "url": "https://x.com/LewisValeLV/status/2118399167014035746"}, {"author_id": "206720696", "created_at": "2026-11-05T17:27:34.000Z", "edit_history_tweet_ids": ["2118394808532382100"], "id": "2118394808532382100", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 41, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator Catching a failure before the line stops is the kind of AI a plant manager buys without needing a pitch.", "url": "https://x.com/cheneypiano/status/2118394808532382100"}, {"author_id": "2056758408414433280", "created_at": "2026-11-05T17:25:24.000Z", "edit_history_tweet_ids": ["2118394262169747772"], "id": "2118394262169747772", "in_reply_to_user_id": "963737004847652864", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118393918333305108", "type": "replied_to"}], "text": "@igmarinelli @ycombinator a factory floor converts better than any landing page", "url": "https://x.com/ElectraOnSol/status/2118394262169747772"}, {"author_id": "963737004847652864", "created_at": "2026-11-05T17:24:02.000Z", "edit_history_tweet_ids": ["2118393918333305108"], "id": "2118393918333305108", "in_reply_to_user_id": "2056758408414433280", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380787125067836", "type": "replied_to"}], "text": "@ElectraOnSol @ycombinator Nobody... and I still say this is cheaper than Google Ads, but nobody wants to do it", "url": "https://x.com/igmarinelli/status/2118393918333305108"}, {"author_id": "963737004847652864", "created_at": "2026-11-05T17:23:34.000Z", "edit_history_tweet_ids": ["2118393800901185725"], "id": "2118393800901185725", "in_reply_to_user_id": "1765407801445167104", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118384348152144079", "type": "replied_to"}], "text": "@jstnsinon @ycombinator It required a lot of boots on the ground. Up until the 88th we were still not sure about the actual PMF and were afraid if we committed to the first customer and built the product based on that pain we would have been considered a 'consulting' company of some sort", "url": "https://x.com/igmarinelli/status/2118393800901185725"}, {"author_id": "220178026", "created_at": "2026-11-05T17:22:34.000Z", "edit_history_tweet_ids": ["2118393547967934742"], "id": "2118393547967934742", "in_reply_to_user_id": "113130846", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118380319711625442", "type": "replied_to"}], "text": "@ycombinator @igmarinelli thinks different and has the grit to make impossível thinks happen.", "url": "https://x.com/Dukaneko/status/2118393547967934742"}, {"author_id": "963737004847652864", "created_at": "2026-11-05T17:22:11.000Z", "edit_history_tweet_ids": ["2118393451905466731"], "id": "2118393451905466731", "in_reply_to_user_id": "1235217928439705602", "public_metrics": {"bookmark_count": 0, "impression_count": 21, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382537005576212", "type": "replied_to"}], "text": "@Cristu @ycombinator Exactly right, when you sell for those who have the problem directly, you don't need to pitch on why is this a problem", "url": "https://x.com/igmarinelli/status/2118393451905466731"}], "includes": {"users": [{"id": "134144896", "name": "˗ˏˋ DC ˎˊ˗", "username": "dcsan"}, {"id"