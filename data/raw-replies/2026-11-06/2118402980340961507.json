nt_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2118402567994834944/vid/avc1/3840x1968/4lIc60giWuVg5aNT.mp4"}, {"bit_rate": 2176000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2118402567994834944/vid/avc1/1404x720/BFuuPiJ_x0eHfizN.mp4"}, {"bit_rate": 10368000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2118402567994834944/vid/avc1/2106x1080/ln5VSMF7My-BSAr1.mp4"}], "width": 3840}, {"height": 471, "media_key": "3_2118456660436164609", "type": "photo", "url": "https://pbs.twimg.com/media/HWZFG81boAEF-56.jpg", "width": 600}], "tweets": [{"attachments": {"media_keys": ["13_2118402567994834944"]}, "author_id": "1369348853414178822", "conversation_id": "2118402980340961507", "created_at": "2026-11-05T18:00:03.000Z", "edit_history_tweet_ids": ["2118402980340961507"], "entities": {"urls": [{"display_url": "pic.x.com/QwJivoY9Jq", "end": 283, "expanded_url": "https://x.com/AlexFinn/status/2118402980340961507/video/1", "media_key": "13_2118402567994834944", "start": 260, "url": "https://t.co/QwJivoY9Jq"}]}, "id": "2118402980340961507", "public_metrics": {"bookmark_count": 674, "impression_count": 38914, "like_count": 551, "quote_count": 10, "reply_count": 94, "retweet_count": 28}, "text": "Grok Bot is easily the best AI agent on planet Earth right now\n\nThe issue is, people want MORE tokens\n\nGood news: I figured out 7 ways to get WAY more usage out of grok Bot\n\nIn this video I cover all 7 tricks so you can 10x the amount you get out of Grok Bot: https://t.co/QwJivoY9Jq"}, {"author_id": "1699883504262377472", "conversation_id": "2118402980340961507", "created_at": "2026-11-05T23:55:14.000Z", "edit_history_tweet_ids": ["2118492367754051938"], "entities": {"mentions": [{"end": 9, "id": "1369348853414178822", "start": 0, "username": "AlexFinn"}, {"end": 19, "id": "1369348853414178822", "start": 10, "username": "AlexFinn"}]}, "id": "2118492367754051938", "note_tweet": {"entities": {"mentions": [{"end": 9, "id": "1369348853414178822", "start": 0, "username": "AlexFinn"}]}, "text": "@AlexFinn, great video.\n\nI’m planning to try installing Hermes Agent on the Grok Bot’s virtual computer so the bot mainly acts as a coordinator while Hermes handles the actual work and calls out to different models.\n\nIf you’ve already tried something like this and it didn’t work well, I’d really appreciate a heads-up before I go down that path."}, "public_metrics": {"bookmark_count": 0, "impression_count": 31, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118402980340961507", "type": "replied_to"}], "text": "@AlexFinn @AlexFinn, great video.\n\nI’m planning to try installing Hermes Agent on the Grok Bot’s virtual computer so the bot mainly acts as a coordinator while Hermes handles the actual work and calls out to different models.\n\nIf you’ve already tried something like this and it didn’t work"}, {"author_id": "1709987537618341888", "conversation_id": "2118402980340961507", "created_at": "2026-11-05T21:20:41.000Z", "edit_history_tweet_ids": ["2118453473712693268"], "entities": {"mentions": [{"end": 9, "id": "1264659188", "start": 0, "username": "AuzyMale"}, {"end": 20, "id": "771317869", "start": 10, "username": "Vantekai_"}, {"end": 30, "id": "1369348853414178822", "start": 21, "username": "AlexFinn"}]}, "id": "2118453473712693268", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118430450679214196", "type": "replied_to"}], "text": "@AuzyMale @Vantekai_ @AlexFinn I am stealing this idea 😁 thanks!"}, {"author_id": "1264659188", "conversation_id": "2118402980340961507", "created_at": "2026-11-05T19:49:12.000Z", "edit_history_tweet_ids": ["2118430450679214196"], "entities": {"mentions": [{"end": 10, "id": "771317869", "start": 0, "username": "Vantekai_"}, {"end": 20, "id": "1369348853414178822", "start": 11, "username": "AlexFinn"}]}, "id": "2118430450679214196", "note_tweet": {"text": "What do you use your computer for? What do you do on your computer that you hate doing, but need to do?\n\nOrganize and sort docs? Go through your emails… My wife loves to file every bit of paper, but I can never find what I need without asking her. So I scanned everything we had straight into Google Drive. Then I had my bot sort it all. I didn’t bother naming the files or separating the scans — I just scanned as many pages as I could and told the bot to separate, label, and sort them into my Drive. Now I can literally ask it about an operation I had, or a tax question like how many child sick days my health insurance paid out last year, and it can answer me and directly link me to the relevant docs, or just print them for me.\n\nThat’s a start, and once you’re doing more stuff like that, the ideas just start flowing in. Have fun 🤩"}, "public_metrics": {"bookmark_count": 0, "impression_count": 11, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118408152630636604", "type": "replied_to"}], "text": "@Vantekai_ @AlexFinn What do you use your computer for? What do you do on your computer that you hate doing, but need to do?\n\nOrganize and sort docs? Go through your emails… My wife loves to file every bit of paper, but I can never find what I need without asking her. So I scanned everything we had"}], "users": [{"id": "1519325143679799296", "name": "Opurbo", "profile_image_url": "https://pbs.twimg.com/profile_images/2112351549934694401/JrkXC-ZC_normal.jpg", "public_metrics": {"followers_count": 308, "following_count": 3018, "like_count": 327, "listed_count": 2, "media_count": 2554, "tweet_count": 7218}, "username": "stropurbo", "verified": false}, {"id": "17065524", "name": "Stan_Timek", "profile_image_url": "https://pbs.twimg.com/profile_images/1533946097860845568/keGqFGHR_normal.jpg", "public_metrics": {"followers_count":