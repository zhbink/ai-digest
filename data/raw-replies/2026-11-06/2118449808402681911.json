"}]}, "id": "2118476133314514954", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118449808402681911", "type": "replied_to"}], "text": "@dwarkesh_sp Social deception might be the most honest benchmark out there. Hard to overfit to a game where every other player is trying to fool you.", "url": "https://x.com/erveisi/status/2118476133314514954"}, {"author_id": "2109162623237566464", "conversation_id": "2118449808402681911", "created_at": "2026-11-05T22:48:32.000Z", "edit_history_tweet_ids": ["2118475579951640702"], "entities": {"mentions": [{"end": 12, "id": "1209960539390201864", "start": 0, "username": "dwarkesh_sp"}]}, "id": "2118475579951640702", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118449808402681911", "type": "replied_to"}], "text": "@dwarkesh_sp the sheer amount of money spent on digital chaos is so real 💸", "url": "https://x.com/vioinabox/status/2118475579951640702"}, {"author_id": "612135517", "conversation_id": "2118449808402681911", "created_at": "2026-11-05T22:47:37.000Z", "edit_history_tweet_ids": ["2118475348568400181"], "entities": {"mentions": [{"end": 13, "id": "1087957969915006976", "start": 0, "username": "Madisonkanna"}, {"end": 26, "id": "1209960539390201864", "start": 14, "username": "dwarkesh_sp"}]}, "id": "2118475348568400181", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118461465472782520", "type": "replied_to"}], "text": "@Madisonkanna @dwarkesh_sp it costs 20k to play", "url": "https://x.com/TradeTexasBig/status/2118475348568400181"}, {"author_id": "1508051347094003717", "conversation_id": "2118449808402681911", "created_at": "2026-11-05T22:40:05.000Z", "edit_history_twe