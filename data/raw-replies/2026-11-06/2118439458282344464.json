": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus Will Anthropic be able to serve any of these models publicly? Is Fable 5.5 even servable?", "url": "https://x.com/erikrcarlson/status/2118453912072019978"}, {"author_id": "1559972849900785803", "created_at": "2026-11-05T21:16:28.000Z", "edit_history_tweet_ids": ["2118452412851630121"], "id": "2118452412851630121", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 270, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus Must be fun being a research engineer and work on these internal models", "url": "https://x.com/Ales_is_offline/status/2118452412851630121"}, {"author_id": "2015724555881287680", "created_at": "2026-11-05T21:15:07.000Z", "edit_history_tweet_ids": ["2118452072790270401"], "id": "2118452072790270401", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 152, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus Of course it does - METR donors are among Anthropic owners ... follow the money ... 😉 So everything for the IPO ...", "url": "https://x.com/AgiMan_WCL/status/2118452072790270401"}, {"author_id": "1658060999079936000", "created_at": "2026-11-05T21:14:44.000Z", "edit_history_tweet_ids": ["2118451977197641740"], "id": "2118451977197641740", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 49, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus 1.7x to 1.9x just from adding unreleased models says the models you can use sit a step behind what the labs measure. I'd judge tools on what ships, the METR number is a preview of next year", "url": "https://x.com/Novlyx/status/2118451977197641740"}, {"author_id": "1836707525099425793", "created_at": "2026-11-05T21:14:32.000Z", "edit_history_tweet_ids": ["2118451926534668704"], "id": "2118451926534668704", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus They have a lot of unreleased models", "url": "https://x.com/HamidoFx1/status/2118451926534668704"}, {"author_id": "1727000155075883008", "created_at": "2026-11-05T21:12:51.000Z", "edit_history_tweet_ids": ["2118451503161843932"], "id": "2118451503161843932", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus Faster models won't fix a broken fallback. What breaks at 3am when the API times out?", "url": "https://x.com/kadenc4_s/status/2118451503161843932"}, {"author_id": "2045518207159525376", "created_at": "2026-11-05T21:09:38.000Z", "edit_history_tweet_ids": ["2118450690628739109"], "id": "2118450690628739109", "in_reply_to_user_id": "1582956433288544256", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118445489293324655", "type": "replied_to"}], "text": "@JamesMalsawm @kimmonismus At that pace, reviewing all the code becomes the bottleneck 😅", "url": "https://x.com/i_mika_el/status/2118450690628739109"}, {"author_id": "1723220685734981632", "created_at": "2026-11-05T21:07:32.000Z", "edit_history_tweet_ids": ["2118450163379552417"], "id": "2118450163379552417", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus Does 1.9x actually show up in real jobs, or just benchmarks?", "url": "https://x.com/finley_f18/status/2118450163379552417"}, {"author_id": "2110684860989779968", "created_at": "2026-11-05T20:57:45.000Z", "edit_history_tweet_ids": ["2118447702854013328"], "id": "2118447702854013328", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 338, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus https://t.co/3WF43W8MGt", "url": "https://x.com/Frelzu/status/2118447702854013328"}, {"author_id": "1701689703626412032", "created_at": "2026-11-05T20:57:19.000Z", "edit_history_tweet_ids": ["2118447592606744949"], "id": "2118447592606744949", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 197, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus Exciting and a little scary at the same time", "url": "https://x.com/MichaelKaiserAI/status/2118447592606744949"}, {"author_id": "2105442250822168576", "created_at": "2026-11-05T20:55:00.000Z", "edit_history_tweet_ids": ["2118447008516084122"], "id": "2118447008516084122", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 78, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus so the models nobody can use yet are moving the number? 1.7x to 1.9x is a big jump", "url": "https://x.com/SINewsBriefing/status/2118447008516084122"}, {"author_id": "33941515", "created_at": "2026-11-05T20:54:25.000Z", "edit_history_tweet_ids": ["2118446861854048397"], "id": "2118446861854048397", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 76, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus How do you trust a system card when unnamed internal models drove the curve?", "url": "https://x.com/lotar_vk/status/2118446861854048397"}, {"author_id": "1687581653168963585", "created_at": "2026-11-05T20:53:53.000Z", "edit_history_tweet_ids": ["2118446726596157798"], "id": "2118446726596157798", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 106, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus So annoying they are keeping the best AI from us. Actually, not just annoying, but killing people from delaying medical research and keeping people in poor countries destitute for longer than necessary.", "url": "https://x.com/uxtigersdotcom/status/2118446726596157798"}, {"author_id": "1029681885864112129", "created_at": "2026-11-05T20:50:50.000Z", "edit_history_tweet_ids": ["2118445961768800341"], "id": "2118445961768800341", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 115, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus AI2027 is on track again. They expected 2X by Dec 2026. https://t.co/mRRkVvv83I", "url": "https://x.com/Tony54381404/status/2118445961768800341"}, {"author_id": "1582956433288544256", "created_at": "2026-11-05T20:48:58.000Z", "edit_history_tweet_ids": ["2118445489293324655"], "id": "2118445489293324655", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 167, "like_count": 2, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus you can feel that speed every week building with claude code", "url": "https://x.com/JamesMalsawm/status/2118445489293324655"}, {"author_id": "225100450", "created_at": "2026-11-05T20:42:11.000Z", "edit_history_tweet_ids": ["2118443781913801072"], "id": "2118443781913801072", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 79, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus Progress rose from 1.7x to 1.9x after including models you can't complain about.", "url": "https://x.com/ExiledonMoon/status/2118443781913801072"}, {"author_id": "1747912101409030144", "created_at": "2026-11-05T20:34:38.000Z", "edit_history_tweet_ids": ["2118441885090124168"], "id": "2118441885090124168", "in_reply_to_user_id": "1573399256836309009", "public_metrics": {"bookmark_count": 0, "impression_count": 92, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118439458282344464", "type": "replied_to"}], "text": "@kimmonismus The 95% interval on that estimate is 1.5x to2.8x. Even the low end means the progress speed up, but 1.9x vs 1.7 sits well inside the noise", "url": "https://x.com/ai_plainly/status/2118441885090124168"}, {"author_id": "2081555588547502080", "created_at": "2026-11-05T20:34:13.000Z", "edit_history_tweet_ids": ["2118441779619881253"], "id": "2118441779619881253", "i