{"data": [{"author_id": "2813056513", "created_at": "2026-11-05T21:25:17.000Z", "edit_history_tweet_ids": ["2118454628689891753"], "id": "2118454628689891753", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "@LumaLabsAI Changing the brief is a familiar pain. I think creators marketers follow could introduce Luma's workflow. Creator search, campaign planning, briefs and proposals are free on Chals Channel. Happy to plan your first campaign around your buyer persona", "url": "https://x.com/Ignaciosolere/status/2118454628689891753"}, {"author_id": "1587673526177144832", "created_at": "2026-11-05T20:58:40.000Z", "edit_history_tweet_ids": ["2118447932705812534"], "id": "2118447932705812534", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "@LumaLabsAI 这个流程正好对上我们卖家的痛点：同一张产品图要出多角度、多场景、多优惠版本，过去靠人工改提示词又慢又不稳。如果MCP能把预设工作流直接接进Claude，我能在对话里批量跑20条不同场景的素材。想问预设工作流支持自定义品牌模板和固定产品外观吗？", "url": "https://x.com/clyve2022/status/2118447932705812534"}, {"author_id": "1958082451416473600", "created_at": "2026-11-05T19:34:55.000Z", "edit_history_tweet_ids": ["2118426854394896442"], "id": "2118426854394896442", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "@LumaLabsAI Briefing in chat and revising from a product photo feels like the right direction — the brief always changes mid-week anyway. When the angles and scene change after the first pass, does the product itself stay locked, or does each revision risk drifting the hero shot?", "url": "https://x.com/Arxlankhana/status/2118426854394896442"}, {"author_id": "2084245314643599360", "created_at": "2026-11-05T18:12:48.000Z", "edit_history_tweet_ids": ["2118406188362768811"], "id": "2118406188362768811", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 0, "impression_count": 11, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "@LumaLabsAI Putting preset product workflows inside Claude and ChatGPT is the useful move. Briefs change weekly in Q4, so the bottleneck is not image quality. It is how fast you can re-angle, re-scene, and slap the offer on without leaving the chat.", "url": "https://x.com/NickyLi42/status/2118406188362768811"}, {"author_id": "2111019157638578176", "created_at": "2026-11-05T18:05:19.000Z", "edit_history_tweet_ids": ["2118404307339067617"], "id": "2118404307339067617", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "@LumaLabsAI Bringing Luma's pre-set workflows into Claude and ChatGPT through MCP cuts a lot of copy-paste between tools. Do the finished creatives stay editable in Luma, or do they export as flat files?", "url": "https://x.com/aigoodpick/status/2118404307339067617"}, {"author_id": "1763220993865342977", "created_at": "2026-11-05T16:30:56.000Z", "edit_history_tweet_ids": ["2118380556211949584"], "id": "2118380556211949584", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "@LumaLabsAI Brief changed again but creative keeps up weekly now easily", "url": "https://x.com/ElenaAiExpert/status/2118380556211949584"}, {"author_id": "923953886754308096", "created_at": "2026-11-05T16:13:05.000Z", "edit_history_tweet_ids": ["2118376063399342457"], "id": "2118376063399342457", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "@LumaLabsAI This is where AI creativity gets really practical. Turning a single product photo into a complete campaign workflow without breaking the creative momentum. Faster iterations, more possibilities, better execution.", "url": "https://x.com/Naiknelofar788/status/2118376063399342457"}, {"author_id": "1449572891956166657", "created_at": "2026-11-05T16:00:00.000Z", "edit_history_tweet_ids": ["2118372770954313898"], "id": "2118372770954313898", "in_reply_to_user_id": "1449572891956166657", "public_metrics": {"bookmark_count": 1, "impression_count": 980, "like_count": 4, "quote_count": 0, "reply_count": 0, "retweet_count": 1}, "referenced_tweets": [{"id": "2118372770547487117", "type": "replied_to"}], "text": "Try it → https://t.co/ZmesgyeHDl", "url": "https://x.com/LumaLabsAI/status/2118372770954313898"}], "includes": {"users": [{"id": "2813056513", "name": "Nacho | Scale with X creators | Chals Channel", "username": "Ignaciosolere"}, {"id": "1587673526177144832", "name": "clyve2022", "username": "clyve2022"}, {"id": "1958082451416473600", "name": "Arxlan Khan", "username": "Arxlankhana"}, {"id": "2084245314643599360", "name": "Nicky_42", "username": "NickyLi42"}, {"id": "2111019157638578176", "name": "AI Good Pick", "username": "aigoodpick"}, {"id": "1763220993865342977", "name": "Elena AI", "username": "ElenaAiExpert"}, {"id": "923953886754308096", "name": "simeon-sanai", "username"