{"data": [{"author_id": "1523776932017438721", "created_at": "2026-11-05T22:54:48.000Z", "edit_history_tweet_ids": ["2118477157035028585"], "id": "2118477157035028585", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 29, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai have you switched from conductor to capy?", "url": "https://x.com/gibraninc/status/2118477157035028585"}, {"author_id": "1525906981", "created_at": "2026-11-05T22:20:32.000Z", "edit_history_tweet_ids": ["2118468535525744738"], "id": "2118468535525744738", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai curious how the captains handle flaky tests in CI", "url": "https://x.com/leslieMen/status/2118468535525744738"}, {"author_id": "1856564058763472896", "created_at": "2026-11-05T22:18:02.000Z", "edit_history_tweet_ids": ["2118467905377747441"], "id": "2118467905377747441", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 14, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai 643 PRs is headline, revert rates on those would tell you sth and if that stayed flat at 13x volume there's an actual proof", "url": "https://x.com/aimanrc_/status/2118467905377747441"}, {"author_id": "1367216960", "created_at": "2026-11-05T21:07:25.000Z", "edit_history_tweet_ids": ["2118450132681376232"], "id": "2118450132681376232", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Once agents manage the merge queue and CI, the bottleneck moves from writing code to reviewing it.", "url": "https://x.com/kevindorfer/status/2118450132681376232"}, {"author_id": "18185124", "created_at": "2026-11-05T20:11:34.000Z", "edit_history_tweet_ids": ["2118436078910886240"], "id": "2118436078910886240", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 29, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai The number that jumps out to a non-coder: your own output up 13x, everyone else's up 13%.\nThat's the one-person company in a single table. At 69 I'm building an AI startup with a tiny team, and that gap is the whole bet.", "url": "https://x.com/jeffbullas/status/2118436078910886240"}, {"author_id": "11768582", "created_at": "2026-11-05T20:01:54.000Z", "edit_history_tweet_ids": ["2118433644234891736"], "id": "2118433644234891736", "in_reply_to_user_id": "1588935512135720961", "public_metrics": {"bookmark_count": 0, "impression_count": 253, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118408331924844922", "type": "replied_to"}], "text": "@johnroodepic @capydotai I explicitly tell them to coordinate and they do\n\nI have zero problems", "url": "https://x.com/garrytan/status/2118433644234891736"}, {"author_id": "1825556649723240448", "created_at": "2026-11-05T20:00:31.000Z", "edit_history_tweet_ids": ["2118433296917094471"], "id": "2118433296917094471", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai 49 to 643 PRs is the number that sells it — the merge queue and CI part is where most of these setups usually fall apart.", "url": "https://x.com/JMkernt/status/2118433296917094471"}, {"author_id": "39880039", "created_at": "2026-11-05T19:52:26.000Z", "edit_history_tweet_ids": ["2118431265216921769"], "id": "2118431265216921769", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 26, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai how do you experience this being different from e.g. Claude Code Projects with subthreads, subagents, etc?", "url": "https://x.com/Carlemilva/status/2118431265216921769"}, {"author_id": "1947153112609042433", "created_at": "2026-11-05T19:52:24.000Z", "edit_history_tweet_ids": ["2118431253510938989"], "id": "2118431253510938989", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 41, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai My sales bots already have a manager bot and a checker bot over them. Captains is a better name for it", "url": "https://x.com/prestonboling/status/2118431253510938989"}, {"author_id": "2078676366052999168", "created_at": "2026-11-05T19:51:34.000Z", "edit_history_tweet_ids": ["2118431043778908606"], "id": "2118431043778908606", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai agents coordinating agents and managing merge queues. my codebase is about to have more meetings than my calendar.", "url": "https://x.com/therealhacker97/status/2118431043778908606"}, {"author_id": "1449314517607981062", "created_at": "2026-11-05T19:45:29.000Z", "edit_history_tweet_ids": ["2118429516032884969"], "id": "2118429516032884969", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 21, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai yeah i run like 8 bots that talk to each other through routines. cool until usage hits 70% by wednesday and you have to kill the ones that only ping noise", "url": "https://x.com/boy_that_lives/status/2118429516032884969"}, {"author_id": "1474934602544259073", "created_at": "2026-11-05T19:38:03.000Z", "edit_history_tweet_ids": ["2118427642882097200"], "id": "2118427642882097200", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Subagents that can talk to each other is the underrated part. Curious how much of the win is coordination vs just not dropping context between steps.", "url": "https://x.com/kylemissionai/status/2118427642882097200"}, {"author_id": "2103451468657483776", "created_at": "2026-11-05T19:12:33.000Z", "edit_history_tweet_ids": ["2118421228180459675"], "id": "2118421228180459675", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai the coordination is the impressive part and the risky part. agents talking to agents move instructions at machine speed, so a bad instruction suddenly has a blast radius", "url": "https://x.com/LuggyBag/status/2118421228180459675"}, {"author_id": "1949121156470247424", "created_at": "2026-11-05T19:05:20.000Z", "edit_history_tweet_ids": ["2118419410860024193"], "id": "2118419410860024193", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 24, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai meanwhile my two agents still fight over one variable name", "url": "https://x.com/khuxsal/status/2118419410860024193"}, {"author_id": "729785986104840192", "created_at": "2026-11-05T18:59:41.000Z", "edit_history_tweet_ids": ["2118417987728458206"], "id": "2118417987728458206", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai the Polaris effect\n\n3,379 PRs merged in a month\n\nhttps://t.co/Bw3F11ECYV https://t.co/5soS2WmvZx", "url": "https://x.com/andyasprou/status/2118417987728458206"}, {"author_id": "2106492587544629248", "created_at": "2026-11-05T18:57:36.000Z", "edit_history_tweet_ids": ["2118417465059475639"], "id": "2118417465059475639", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Subagents in the merge queue sounds great until ten of them fight over the same file. Who resolves that?", "url": "https://x.com/MITUnicorn/status/2118417465059475639"}, {"author_id": "372924189", "created_at": "2026-11-05T18:57:19.000Z", "edit_history_tweet_ids": ["2118417392611299620"], "id": "2118417392611299620", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 29, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Coordination is the product. Not the model.\n\n10 agents that can't see each other's branches just make 10x the merge conflicts.\n\nCaptains owning the merge queue and CI is the part everyone skipped- ORCHESTRATION is where swarms win or die.", "url": "https://x.com/wittypritesh/status/2118417392611299620"}, {"author_id": "1773596441602113536", "created_at": "2026-11-05T18:53:41.000Z", "edit_history_tweet_ids": ["2118416477305094602"], "id": "2118416477305094602", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai agents managing merge queues", "url": "https://x.com/mianoedwin_/status/2118416477305094602"}, {"author_id": "29677918", "created_at": "2026-11-05T18:53:17.000Z", "edit_history_tweet_ids": ["2118416376834797801"], "id": "2118416376834797801", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 12, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Subagents talking to each other is when tooling stops being a toy.", "url": "https://x.com/hotmob/status/2118416376834797801"}, {"author_id": "1881298669", "created_at": "2026-11-05T18:45:42.000Z", "edit_history_tweet_ids": ["2118414470158389267"], "id": "2118414470158389267", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 88, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Watching two captains politely rebase each other into oblivion is the new compile time.", "url": "https://x.com/AnwarTimilla/status/2118414470158389267"}, {"author_id": "206720696", "created_at": "2026-11-05T18:40:49.000Z", "edit_history_tweet_ids": ["2118413240401322197"], "id": "2118413240401322197", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Subagents that can talk to each other is the piece that turns a pile of bots into an actual team.", "url": "https://x.com/cheneypiano/status/2118413240401322197"}, {"author_id": "1094317114826076165", "created_at": "2026-11-05T18:39:59.000Z", "edit_history_tweet_ids": ["2118413032715874761"], "id": "2118413032715874761", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 80, "like_count": 3, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Subagents talking to each other is nice. A merge queue and CI nobody has to babysit though, that's useful", "url": "https://x.com/luca_iaconelli/status/2118413032715874761"}, {"author_id": "1483051266", "created_at": "2026-11-05T18:39:52.000Z", "edit_history_tweet_ids": ["2118413003658055857"], "id": "2118413003658055857", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai My engineers would thank me if agents took over the merge queue", "url": "https://x.com/TheElliottSmith/status/2118413003658055857"}, {"author_id": "2043198868662157312", "created_at": "2026-11-05T18:37:48.000Z", "edit_history_tweet_ids": ["2118412481953497543"], "id": "2118412481953497543", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 23, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai Subagents with subthreads that coordinate and argue over the merge queue. We automated the standup before we automated the work.", "url": "https://x.com/minicaai/status/2118412481953497543"}, {"author_id": "1744695775651577856", "created_at": "2026-11-05T18:35:28.000Z", "edit_history_tweet_ids": ["2118411894470152318"], "id": "2118411894470152318", "in_reply_to_user_id": "11768582", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118400594113429931", "type": "replied_to"}], "text": "@garrytan @capydotai yeah. captains on the merge queue are neat. curious what actually blocks a merge for you though. green ci alone still let bad ones through for me.", "url": "https://x.com/ilmAI_/status/2118411894470152318"}], "includes": {"users": [{"id": "1523776932017438721", "name": "Gibran Rubio", "username": "gibraninc"}, {"id": "1525906981", "name": "Hải Ly", "username": "leslieMen"}, {"id": "1856564058763472896", "name": "Aiman Reza", "username": "aimanrc_"}, {"id": "1367216960", "name": "Kevin Dorfer", "username": "kevindorfer"}, {"id": "18185124", "name": "Jeff Bullas", "username": "jeffbullas"}, {"id": "11768582", "name": "Garry Tan", "username": "garrytan"}, {"id": "1825556649723240448", "name": "jimerrors", "username": "JMkernt"}, {"id": "39880039", "name": "Carl-Emil von Arenstorff", "username": "Carlemilva"}, {"id": "1947153112609042433", "name": "preston", "username": "prestonboling"}, {"id": "2078676366052999168", "name": "hacker97", "username": "therealhacker97"}, {"id": "1449314517607981062", "name": "Gunars Mie", "username": "boy_that_lives"}, {"id": "1474934602544259073", "name": "Kyle G", "username": "kylemissionai"}, {"id": "2103451468657483776", "name": "Luggy", "username": "LuggyBag"}, {"id": "1949121156470247424", "name": "Khushal", "username": "khuxsal"}, {"id": "729785986104840192", "name": "Andreas Asprou", "username": "andyasprou"}, {"id": "2106492587544629248", "name": "Unicorn", "username": "MITUnicorn"}, {"id": "372924189", "name": "Pritesh Kumar", "username": "wittypritesh"}, {"id": "1773596441602113536", "name": "Miano", "username": "mianoedwin_"}, {"id": "29677918", "name": "Mob · AI & Robots", "username": "hotmob"}, {"id": "1881298669", "name": "Timilla", "username": "AnwarTimilla"}, {"id": "206720696", "name": "Jon Cheney", "username": "cheneypiano"}, {"id": "1094317114826076165", "name": "Luca Iaconelli", "username": "luca_iaconelli"}, {"id": "1483051266", "name": "Elliott Michael Smith", "username": "TheElliottSmith"}, {"id": "2043198868662157312", "name": "minicaai", "username": "minicaai"}, {"id": "1744695775651577856", "name": "ilmAI", "username": "ilmAI_"}]}, "meta": {"newest_id": "2118477157035028585", "next_token": "b26v89c19zqg8o3juzlyxj6wv2nxa28d0rfmq644lyovx", "oldest_id": "2118411894470152318", "result_count": 25}}