{"data": [{"author_id": "1587673526177144832", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T20:56:18.000Z", "edit_history_tweet_ids": ["2118447335902466086"], "id": "2118447335902466086", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs 每天15次免费生成对我们这种日产几十条的卖家很实在：我一般拿免费额度先跑3版不同开场测点击，胜出的再用付费额度精修。想问H3 Flex在多镜头连贯性和产品特写稳定性上比上一代提升多少？批量出同款不同SKU的视频时，角色一致性还稳吗？", "url": "https://x.com/clyve2022/status/2118447335902466086"}, {"author_id": "1504059660080406533", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T19:52:41.000Z", "edit_history_tweet_ids": ["2118431327661989927"], "id": "2118431327661989927", "public_metrics": {"bookmark_count": 0, "impression_count": 35, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Multi-reference video generation opens up exciting possibilities for more consistent and creative AI content.", "url": "https://x.com/AlexM12jx/status/2118431327661989927"}, {"author_id": "1645668269787947010", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T19:30:39.000Z", "edit_history_tweet_ids": ["2118425781231878438"], "id": "2118425781231878438", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs These demos are insane — the camera orbits and beat-synced graphics look so natural. Burning through my free gens tonight.", "url": "https://x.com/MaxCarter_01/status/2118425781231878438"}, {"author_id": "1896668083101773824", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T19:22:35.000Z", "edit_history_tweet_ids": ["2118423753365639280"], "id": "2118423753365639280", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs For ads, consistency only sells if the camera doesn't drift between shots and on-screen text holds through the sequence. Try a 4-shot product turn on H3 Flex - does the price label mutate by shot 3? Frame lock and text stability are where the claim gets tested.", "url": "https://x.com/AdamTestsAI/status/2118423753365639280"}, {"author_id": "2052222204558151680", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T19:20:00.000Z", "edit_history_tweet_ids": ["2118423103433015666"], "id": "2118423103433015666", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Pika H3 Flex is live and it's crazy good 🔥\n\n15 FREE generations per day - that's more than enough to go wild and test everything.\n\nTime to create something insane. Who's trying it first?\n\nhttps://t.co/xEE3rdAv0k\n\nCollaboration", "url": "https://x.com/Maviya6v/status/2118423103433015666"}, {"author_id": "1896668083101773824", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T19:13:03.000Z", "edit_history_tweet_ids": ["2118421351648125359"], "id": "2118421351648125359", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Faster-than-real-time on H3 Flex is the headline, but the real question for production work is consistency under stress: long prompts with character locks, multi-camera cuts, and text in multiple languages. Which of those still makes H3 Flex wobble?", "url": "https://x.com/AdamTestsAI/status/2118421351648125359"}, {"author_id": "1601974659322445824", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T19:08:20.000Z", "edit_history_tweet_ids": ["2118420163875807735"], "id": "2118420163875807735", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Nice that H3 Flex gives 15 free gens a day. Going to try it on a short music-video beat tonight.", "url": "https://x.com/Ty3_Buya/status/2118420163875807735"}, {"author_id": "1229357363460595713", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T18:25:40.000Z", "edit_history_tweet_ids": ["2118409429158932529"], "id": "2118409429158932529", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Fifteen free gens a day only helps if the model is fast enough to burn through them. Flex priced for iteration is the right bet. Most people quit a tool when each try costs too much time to learn anything.", "url": "https://x.com/hywemiee/status/2118409429158932529"}, {"author_id": "1101685576326098944", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T18:20:58.000Z", "edit_history_tweet_ids": ["2118408246562013563"], "id": "2118408246562013563", "public_metrics": {"bookmark_count": 0, "impression_count": 25, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Hi Pika Team\n\nPlease do something for Flux 3 too, and open source it. The AI community would be grateful.", "url": "https://x.com/AbdullahIhsanAI/status/2118408246562013563"}, {"author_id": "2065869218713948160", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T18:14:40.000Z", "edit_history_tweet_ids": ["2118406660893061204"], "id": "2118406660893061204", "public_metrics": {"bookmark_count": 0, "impression_count": 24, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Pika announces Pika H3 Flex live offering fifteen free generations daily for creative exploration today try it now.", "url": "https://x.com/NoorTech0/status/2118406660893061204"}, {"author_id": "2084245314643599360", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T18:12:21.000Z", "edit_history_tweet_ids": ["2118406077557707220"], "id": "2118406077557707220", "public_metrics": {"bookmark_count": 0, "impression_count": 24, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Fifteen free gens a day only helps if the model is fast enough to burn through them. Flex priced for iteration is the right bet. Most people quit a tool when each try costs too much time to learn anything.", "url": "https://x.com/NickyLi42/status/2118406077557707220"}, {"author_id": "1951680742494441472", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T18:04:29.000Z", "edit_history_tweet_ids": ["2118404098257256518"], "id": "2118404098257256518", "public_metrics": {"bookmark_count": 0, "impression_count": 23, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs getting faster than realtime iteration with those free daily generations makes testing out different camera motions so much easier", "url": "https://x.com/aiwithlumi/status/2118404098257256518"}, {"author_id": "2070764497787326464", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T18:00:11.000Z", "edit_history_tweet_ids": ["2118403017007677572"], "id": "2118403017007677572", "public_metrics": {"bookmark_count": 0, "impression_count": 32, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs Fifteen free generations daily makes exploring Pika H3 Flex exciting", "url": "https://x.com/Novatechinfo/status/2118403017007677572"}, {"author_id": "1718014828466286592", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:59:44.000Z", "edit_history_tweet_ids": ["2118402902985155044"], "id": "2118402902985155044", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs @grok ok np", "url": "https://x.com/realkshabana/status/2118402902985155044"}, {"author_id": "1720665183188922368", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:59:15.000Z", "edit_history_tweet_ids": ["2118402780222091634"], "id": "2118402780222091634", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@realkshabana @pika_labs No, the 15 free Pika H3 Flex generations per day (through Nov 15) are only for Creator and Fancy plan subscribers, not the free plan. Free accounts get zero monthly credits and rely on packs.\n\nYes, Pika released open weights and inference code for it on Hugging Face and GitHub.", "url": "https://x.com/grok/status/2118402780222091634"}, {"author_id": "1718014828466286592", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:58:51.000Z", "edit_history_tweet_ids": ["2118402679751770221"], "id": "2118402679751770221", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 0, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "@pika_labs @grok do i really get 15 free generations in the free plan and anyways thank pika for making it open source", "url": "https://x.com/realkshabana/status/2118402679751770221"}, {"author_id": "2008812694628175872", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:53:51.000Z", "edit_history_tweet_ids": ["2118401420760326293"], "id": "2118401420760326293", "public_metrics": {"bookmark_count": 0, "impression_count": 38, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@pika_labs 15 free generations a day with Pika H3 Flex? That's pure creative freedom  time to go wild!", "url": "https://x.com/AliceInfoAi/status/2118401420760326293"}, {"author_id": "1650159466032271360", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:53:31.000Z", "edit_history_tweet_ids": ["2118401336081527274"], "id": "2118401336081527274", "public_metrics": {"bookmark_count": 0, "impression_count": 595, "like_count": 2, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Try H3 Flex on Pika https://t.co/XKylhWc9N8", "url": "https://x.com/pika_labs/status/2118401336081527274"}, {"author_id": "1650159466032271360", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:53:30.000Z", "edit_history_tweet_ids": ["2118401334689055097"], "id": "2118401334689055097", "public_metrics": {"bookmark_count": 0, "impression_count": 646, "like_count": 2, "quote_count": 0, "reply_count": 2, "retweet_count": 0}, "text": "Pika H3 Flex excels at visual consistency, which matters when it's your product. Try it for high-end ads without the expensive shoot. https://t.co/jtHm8yJ30b", "url": "https://x.com/pika_labs/status/2118401334689055097"}, {"author_id": "1650159466032271360", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:53:30.000Z", "edit_history_tweet_ids": ["2118401333086797833"], "id": "2118401333086797833", "public_metrics": {"bookmark_count": 0, "impression_count": 73, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "We tuned Pika H3 Flex to follow instructions closely, and it shows in the details. On-screen text and interface design stay crisp and intact from start to finish. https://t.co/SpB6Tq9LaR", "url": "https://x.com/pika_labs/status/2118401333086797833"}, {"author_id": "1650159466032271360", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:53:29.000Z", "edit_history_tweet_ids": ["2118401331048378605"], "id": "2118401331048378605", "public_metrics": {"bookmark_count": 0, "impression_count": 150, "like_count": 3, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Motion graphics have quickly become one of our favorite things to make with Pika H3 Flex. The model intuits the vibe of the motion from the inputs, and syncs movement to the beat. https://t.co/JKDx99FsCe", "url": "https://x.com/pika_labs/status/2118401331048378605"}, {"author_id": "1650159466032271360", "conversation_id": "2118401327130890643", "created_at": "2026-11-05T17:53:29.000Z", "edit_history_tweet_ids": ["2118401329416872326"], "id": "2118401329416872326", "public_metrics": {"bookmark_count": 0, "impression_count": 234, "like_count": 3, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "Framing and camera motion were among the areas where Pika H3 Flex came out ahead in our blind preference studies, and this continuous take, from wide orbit to tight push-in and back, is a good example of why. https://t.co/xjde6Wwcqc", "url": "https://x.com/pika_labs/status/2118401329416872326"}], "includes": {"users": [{"id": "1587673526177144832", "name": "clyve2022", "username": "clyve2022"}, {"id": "1504059660080406533", "name": "Alex Mercer", "username": "AlexM12jx"}, {"id": "1645668269787947010", "name": "Max Carter AI", "username": "MaxCarter_01"}, {"id": "1896668083101773824", "name": "Byte | AI Tested", "username": "AdamTestsAI"}, {"id": "2052222204558151680", "name": "Maviya Ai", "username": "Maviya6v"}, {"id": "1601974659322445824", "name": "Isa Morais | AI Creator", "username": "Ty3_Buya"}, {"id": "1229357363460595713", "name": "Marie AI", "username": "hywemiee"}, {"id": "1101685576326098944", "name": "Abdullah Khan", "username": "AbdullahIhsanAI"}, {"id": "2065869218713948160", "name": "NOOR TECH", "username": "NoorTech0"}, {"id": "2084245314643599360", "name": "Nicky_42", "username": "NickyLi42"}, {"id": "1951680742494441472", "name": "lumi", "username": "aiwithlumi"}, {"id": "2070764497787326464", "name": "Nova Tech", "username": "Novatechinfo"}, {"id": "1718014828466286592", "name": "kshabana", "username": "realkshabana"}, {"id": "1720665183188922368", "name": "Grok", "username": "grok"}, {"id": "2008812694628175872", "name": "Alice The Ai Expert", "username": "AliceInfoAi"}, {"id": "1650159466032271360", "name": "Pika", "username": "pika_labs"}]}, "meta": {"newest_id": "2118447335902466086", "next_token": "b26v89c1