{"data": [{"author_id": "1892450036388417537", "created_at": "2026-11-06T01:10:42.000Z", "edit_history_tweet_ids": ["2118511359965229363"], "id": "2118511359965229363", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 中文转写和导出这两处确实烦啊，你是直接拿开源用，还是自己改？", "url": "https://x.com/yuntian9999/status/2118511359965229363"}, {"author_id": "2047489959184187392", "created_at": "2026-11-06T00:59:24.000Z", "edit_history_tweet_ids": ["2118508513186267365"], "id": "2118508513186267365", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 现在这种收费软件是真的越来越不好做了，有 AI 有开源，实在不行还有 REA", "url": "https://x.com/ai_super_niko/status/2118508513186267365"}, {"author_id": "1927693584142360576", "created_at": "2026-11-06T00:39:13.000Z", "edit_history_tweet_ids": ["2118503435800891830"], "id": "2118503435800891830", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 20, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 我用的神烦老狗做的录屏软件，感觉大差不差吧，只要录屏完合成的时候别太卡顿就行，之前用过几个开源的，就很卡顿，不知道为啥", "url": "https://x.com/cfyofjackie/status/2118503435800891830"}, {"author_id": "1716669697452560385", "created_at": "2026-11-06T00:17:57.000Z", "edit_history_tweet_ids": ["2118498081725726829"], "id": "2118498081725726829", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 49, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 订阅一年后动手改开源，这条决策路径太真实了。工具 80 分够用时续费最省事；一旦卡在「导出慢 / 中文弱」这种每天都碰到的点，自己改反而更划算。想问下改造 Cap 时，中文字幕是接了现成 ASR，还是继续让本地模型硬扛？", "url": "https://x.com/randy102488/status/2118498081725726829"}, {"author_id": "1977011546942586883", "created_at": "2026-11-05T23:36:00.000Z", "edit_history_tweet_ids": ["2118487525480186080"], "id": "2118487525480186080", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 68, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 Cap 开源能改转写和倍速，这点 ScreenStudio 续不起。你们换啥引擎了？", "url": "https://x.com/xielaoban_67/status/2118487525480186080"}, {"author_id": "14430631", "created_at": "2026-11-05T23:16:37.000Z", "edit_history_tweet_ids": ["2118482649052479896"], "id": "2118482649052479896", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 39, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118482500473467016", "type": "replied_to"}], "text": "@vista8 无耻！等你的了", "url": "https://x.com/Linkc/status/2118482649052479896"}, {"author_id": "6690032", "created_at": "2026-11-05T23:16:02.000Z", "edit_history_tweet_ids": ["2118482500473467016"], "id": "2118482500473467016", "in_reply_to_user_id": "14430631", "public_metrics": {"bookmark_count": 0, "impression_count": 156, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118481042202144921", "type": "replied_to"}], "text": "@Linkc 不订阅不更新", "url": "https://x.com/vista8/status/2118482500473467016"}, {"author_id": "14430631", "created_at": "2026-11-05T23:10:14.000Z", "edit_history_tweet_ids": ["2118481042202144921"], "id": "2118481042202144921", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 167, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 ScreenStudio不是买断制的么，不过从24年开始我那个就不升级了，除非再交一分钱。", "url": "https://x.com/Linkc/status/2118481042202144921"}, {"author_id": "978328689170513921", "created_at": "2026-11-05T19:12:30.000Z", "edit_history_tweet_ids": ["2118421213379006731"], "id": "2118421213379006731", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 132, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 中文转写你打算换成什么？这块最费劲，我猜你最后会先留个英文版用着", "url": "https://x.com/cunlegetu/status/2118421213379006731"}, {"author_id": "1920566829384413185", "created_at": "2026-11-05T18:13:36.000Z", "edit_history_tweet_ids": ["2118406391216173086"], "id": "2118406391216173086", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 137, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 订阅一年才发现短板，这学费交得还算值😂 开源改着玩最爽的是字幕和导出能按自己习惯改，不用等官方排期。改完记得把常用快捷键和导出预设先固定下来，不然过两周又变回边用边改", "url": "https://x.com/santuoai/status/2118406391216173086"}, {"author_id": "2095722313744601088", "created_at": "2026-11-05T17:09:34.000Z", "edit_history_tweet_ids": ["2118390278696636728"], "id": "2118390278696636728", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 153, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 导出、字幕、倍速，想改的都是很具体的使用细节。能按自己的习惯改，继续续费的吸引力确实就小了。", "url": "https://x.com/Rennix7t/status/2118390278696636728"}, {"author_id": "2114733813662142464", "created_at": "2026-11-05T16:47:58.000Z", "edit_history_tweet_ids": ["2118384839367741901"], "id": "2118384839367741901", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 135, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "@vista8 录屏年年续费，中文字幕和倍速还差点意思，不如把 Cap 拉过来自己改一版。", "url": "https://x.com/maiai_fun/status/2118384839367741901"}, {"author_id": "6690032", "created_at": "2026-11-05T16:47:38.000Z", "edit_history_tweet_ids": ["2118384756140421449"], "id": "2118384756140421449", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 0, "impression_count": 1135, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "本地编译完成，启动还有音乐，这么花俏吗！ https://t.co/AndqHOvrDQ", "url": "https://x.com/vista8/status/2118384756140421449"}, {"author_id": "6690032", "created_at": "2026-11-05T16:38:43.000Z", "edit_history_tweet_ids": ["2118382511877468430"], "id": "2118382511877468430", "in_reply_to_user_id": "6690032", "public_metrics": {"bookmark_count": 21, "impression_count": 1036, "like_count": 8, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118382278065999994", "type": "replied_to"}], "text": "Cap 开源录屏软件，24k Star：\nhttps://t.co/10j0XZzSg0", "url": "https://x.com/vista8/status/2118382511877468430"}], "includes": {"users": [{"id": "1892450036388417537", "name": "Nitor｜AI 工具站出海", "username": "yuntian9999"}, {"id": "2047489959184187392", "name": "Niko爱学习", "username": "ai_super_niko"}, {"id": "1927693584142360576", "name": "穿风衣的Jackie", "username": "cfyofjackie"}, {"id": "1716669697452560385", "name": "Randy｜大白话讲 AI", "username": "randy102488"}, {"id": "1977011546942586883", "name": "蟹老板", "username": "xielaoban_67"}, {"id": "14430631", "name": "陈言Linkc-Chen /只是一个AI使用者", "username": "Linkc"}, {"id": "6690032", "name": "向阳乔木", "username": "vista8"}, {"id": "978328689170513921", "name": "板蓝根", "username": "cunlegetu"}, {"id": "1920566829384413185", "name": "三坨AI搞钱", "username": "santuoai"}, {"id": "2095722313744601088", "name": "三分钟懂行", "username": "Rennix7t"}, {"id": "2114733813662142464", "name": "格 Boss", "username": "maiai_fun"}]}, "meta": {"newest_id": "2118511359965229363", "next_token": "b26v89c19zqg8o3juzlyxh4aa8ax4h9jjyuygfn1vtcvx", "oldest_id": "2118382511877468430", "result_count": 14}}