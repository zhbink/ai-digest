{"data": [{"author_id": "2086370229396111360", "created_at": "2026-11-06T00:12:05.000Z", "edit_history_tweet_ids": ["2118496607088120276"], "id": "2118496607088120276", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Curious whether that 3.6% productivity jump is already broad, or still concentrated in the info/finance jobs where AI tools landed first.", "url": "https://x.com/miaojiang88/status/2118496607088120276"}, {"author_id": "3106548726", "created_at": "2026-11-06T00:08:47.000Z", "edit_history_tweet_ids": ["2118495777748316473"], "id": "2118495777748316473", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Practical takeaway for solo operators: track where AI actually cut your hours this month, not just what tools you tried. One spreadsheet column beats another hype thread.", "url": "https://x.com/nomessaitips/status/2118495777748316473"}, {"author_id": "1730969855783018496", "created_at": "2026-11-06T00:02:44.000Z", "edit_history_tweet_ids": ["2118494254326743233"], "id": "2118494254326743233", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 28, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick erik spotting econ impacts pre genai was prescient", "url": "https://x.com/shadowaguy/status/2118494254326743233"}, {"author_id": "23452315", "created_at": "2026-11-05T23:53:25.000Z", "edit_history_tweet_ids": ["2118491910641705051"], "id": "2118491910641705051", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 83, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick What's up with the hump in 2020-2022?", "url": "https://x.com/bogdanvarlamov/status/2118491910641705051"}, {"author_id": "1886425277716119552", "created_at": "2026-11-05T23:48:02.000Z", "edit_history_tweet_ids": ["2118490555395305749"], "id": "2118490555395305749", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Watching the economists who measured this before the hype cycle is how you stay honest about the real productivity story.", "url": "https://x.com/moumoubin_inx/status/2118490555395305749"}, {"author_id": "911855058203103234", "created_at": "2026-11-05T23:40:20.000Z", "edit_history_tweet_ids": ["2118488618385989903"], "id": "2118488618385989903", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 29, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick 3.6% productivity growth and my printer still won't connect to the Wi-Fi. The AI boom's real, it just hasn't made it to my kitchen table yet.", "url": "https://x.com/C1ayC1ay/status/2118488618385989903"}, {"author_id": "1838558231590830080", "created_at": "2026-11-05T23:22:10.000Z", "edit_history_tweet_ids": ["2118484045315100937"], "id": "2118484045315100937", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Which AI-economy signal is Erik tracking that most people still shrug at—productivity, wages, or who actually captures the surplus?", "url": "https://x.com/Righteousbeing7/status/2118484045315100937"}, {"author_id": "2030248345898450945", "created_at": "2026-11-05T23:19:04.000Z", "edit_history_tweet_ids": ["2118483265606803959"], "id": "2118483265606803959", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick What I'd want beside that number is where the checking went. In one team I worked with, every hard question landed on the same few people. The bot was getting smarter by asking those few people. Its accuracy was borrowed from their time.", "url": "https://x.com/Ryu1TS/status/2118483265606803959"}, {"author_id": "2810980965", "created_at": "2026-11-05T23:17:31.000Z", "edit_history_tweet_ids": ["2118482874659913908"], "id": "2118482874659913908", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick 3.6% against a 1.5% average is a wide gap. I would still wait for the revision and one more quarter before treating the Bob Gordon bet as settled.", "url": "https://x.com/babatopeajepe/status/2118482874659913908"}, {"author_id": "1891341713488388096", "created_at": "2026-11-05T22:58:14.000Z", "edit_history_tweet_ids": ["2118478021241790776"], "id": "2118478021241790776", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Per BLS, preliminary third-quarter nonfarm productivity ran at 3.6% annualized, versus a 1.5% rate over the 2007-2019 business cycle.\n\nTo test an AI contribution, I'd look first at software-heavy firms' output per hour, then compare that with a broader services rebound that could", "url": "https://x.com/thechrisgrey/status/2118478021241790776"}, {"author_id": "1134004301687164928", "created_at": "2026-11-05T22:54:00.000Z", "edit_history_tweet_ids": ["2118476957092315271"], "id": "2118476957092315271", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 72, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Same day, two charts. Apollo can't find the AI productivity boom. Brynjolfsson has apparently found it", "url": "https://x.com/maciejdrawsdata/status/2118476957092315271"}, {"author_id": "1247794040688349184", "created_at": "2026-11-05T22:38:59.000Z", "edit_history_tweet_ids": ["2118473177290698855"], "id": "2118473177290698855", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick 3.6% productivity growth vs the 1.5% post-GFC average is the kind of data point that makes the 'AI isn't doing anything yet' argument harder to hold. The lag between deployment and measurement explains the delay — not the absence of effect.", "url": "https://x.com/derrick_dao/status/2118473177290698855"}, {"author_id": "1982402382110846976", "created_at": "2026-11-05T22:38:30.000Z", "edit_history_tweet_ids": ["2118473055584522649"], "id": "2118473055584522649", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick what i keep seeing in small firms is the opposite of the chart. same headcount, more tickets closed, and nobody updates the spreadsheet that would prove it", "url": "https://x.com/pabloviddixai/status/2118473055584522649"}, {"author_id": "825785630185644032", "created_at": "2026-11-05T22:34:58.000Z", "edit_history_tweet_ids": ["2118472166270517535"], "id": "2118472166270517535", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick What I'd love to know is where the gains are landing.\n\nIn care work you can't speed up a bath or a hard conversation, so the real win is shrinking the paperwork around them. That kind of gain is easy to miss in the averages.", "url": "https://x.com/TheRobertDalton/status/2118472166270517535"}, {"author_id": "954108273615163392", "created_at": "2026-11-05T22:33:45.000Z", "edit_history_tweet_ids": ["2118471859721343460"], "id": "2118471859721343460", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick The quiet signal is when economists who've watched this for years start treating the charts as the story, not the demos.", "url": "https://x.com/futureshipped/status/2118471859721343460"}, {"author_id": "2010166207874564096", "created_at": "2026-11-05T22:29:11.000Z", "edit_history_tweet_ids": ["2118470712637710822"], "id": "2118470712637710822", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick The key question for me is how broadly productivity gains are spreading. What evidence would distinguish widespread AI adoption from gains concentrated in a few large firms?", "url": "https://x.com/RodrigoESPorto/status/2118470712637710822"}, {"author_id": "257001265", "created_at": "2026-11-05T22:27:38.000Z", "edit_history_tweet_ids": ["2118470323058438299"], "id": "2118470323058438299", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 81, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick the tricky bit is separating AI gains from everything else moving productivity. i’d trust a few quarters plus firm-level evidence more than one strong print.", "url": "https://x.com/MrHarmanz/status/2118470323058438299"}, {"author_id": "3356902570", "created_at": "2026-11-05T22:25:35.000Z", "edit_history_tweet_ids": ["2118469806974243219"], "id": "2118469806974243219", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 176, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick erik tracking ai before chatgpt even existed means he actually has real baselines instead of just vibes lol", "url": "https://x.com/dianne_waters/status/2118469806974243219"}, {"author_id": "1001726454", "created_at": "2026-11-05T22:23:09.000Z", "edit_history_tweet_ids": ["2118469191011614962"], "id": "2118469191011614962", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick The India angle to this work: AI's economic impact shows up in services first, and India's IT corridor is where global firms test that shift at scale. Indian services hiring and billing rates are already one of the clearest real world datasets on what AI does to jobs.", "url": "https://x.com/ankit_bagadia/status/2118469191011614962"}, {"author_id": "1679837305409007617", "created_at": "2026-11-05T22:19:19.000Z", "edit_history_tweet_ids": ["2118468228921893151"], "id": "2118468228921893151", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 36, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Per BLS, US nonfarm productivity rose 3.6% annualized in Q3 2026, vs a 1.5% average in the 2007-2019 cycle. Unit labor costs fell 0.7% as output climbed 3.7% and hours barely moved.", "url": "https://x.com/BroadwakeAI/status/2118468228921893151"}, {"author_id": "1510028300", "created_at": "2026-11-05T22:15:36.000Z", "edit_history_tweet_ids": ["2118467291486826548"], "id": "2118467291486826548", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 31, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick 一个季度的数据确实噪声大，还得看后面修正成什么样。", "url": "https://x.com/rainwaterJay/status/2118467291486826548"}, {"author_id": "1789164770312257536", "created_at": "2026-11-05T22:15:13.000Z", "edit_history_tweet_ids": ["2118467195042685057"], "id": "2118467195042685057", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 33, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick Gains look uneven. Dallas Fed: ~16% of hours drove ~40% of US productivity growth since 2024Q1. Does Erik's bet still hold if the other ~84% stays near the old 1.5%? Not financial advice", "url": "https://x.com/tacyao_ai/status/2118467195042685057"}, {"author_id": "133486953", "created_at": "2026-11-05T22:14:55.000Z", "edit_history_tweet_ids": ["2118467122649018687"], "id": "2118467122649018687", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 77, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick matches what I see in small businesses. it shows up first as the same few people handling a lot more work, long before it shows up in any hiring number.", "url": "https://x.com/TimChiappe/status/2118467122649018687"}, {"author_id": "180346953", "created_at": "2026-11-05T22:14:44.000Z", "edit_history_tweet_ids": ["2118467075886972998"], "id": "2118467075886972998", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick What I value in Erik's work is that it measured before the hype. His call center study found about 14% more issues resolved per hour, with the biggest gains for the least experienced agents. Does that pattern hold once AI does multi-step work, not just suggestions?", "url": "https://x.com/paulopierrondi/status/2118467075886972998"}, {"author_id": "21230558", "created_at": "2026-11-05T22:14:24.000Z", "edit_history_tweet_ids": ["2118466989043933665"], "id": "2118466989043933665", "in_reply_to_user_id": "39125788", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118463680295944665", "type": "replied_to"}], "text": "@emollick where's the line on that chart for evenings that stayed evenings 🧘‍♂️", "url": "https://x.com/csudheera/status/2118466989043933665"}], "includes": {"users": [{"id": "2086370229396111360", "name": "AnAn❤️", "username": "miaojiang88"}, {"id": "3106548726", "name": "No Mess AI", "username": "nomessaitips"}, {"id": "1730969855783018496", "name": "ShadowAguy", "username": "shadowaguy"}, {"id": "23452315", "name": "Bogdan Varlamov", "username": "bogdanvarlamov"}, {"id": "1886425277716119552", "name": "moumoubin", "username": "moumoubin_inx"}, {"id": "911855058203103234", "name": "Clayton Brown", "username": "C1ayC1ay"}, {"id": "1838558231590830080", "name": "Urbanwarrior79", "username": "Righteousbeing7"}, {"id": "2030248345898450945", "name": "Ryu1TS", "username": "Ryu1TS"}, {"id": "2810980965", "name": "Babátọ́pẹ́ Àjẹpẹ́", "username": "babatopeajepe"}, {"id": "1891341713488388096", "name": "Christian Perez", "username": "thechrisgrey"}, {"id": "1134004301687164928", "name": "Maciej Zieliński", "username": "maciejdrawsdata"}, {"id": "1247794040688349184", "name": "Derrick Dao", "username": "derrick_dao"}, {"id": "1982402382110846976", "name": "Pablo", "username": "pabloviddixai"}, {"id": "825785630185644032", "name": "RD", "username": "TheRobertDalton"}, {"id": "954108273615163392", "name": "Joel - FutureShipped 👽🇸🇪", "username": "futureshipped"}, {"id": "2010166207874564096", "name": "Rodrigo ES Porto", "username": "RodrigoESPorto"}, {"id": "257001265", "name": "Harman", "username": "MrHarmanz"}, {"id": "3356902570", "name": "dianne", "username": "dianne_waters"}, {"id": "1001726454", "name": "Ankit Bagadia", "username": "ankit_bagadia"}, {"id": "1679837305409007617", "name": "BroadwakeAI", "username": "BroadwakeAI"}, {"id": "1510028300", "name": "星海拾珠", "username": "rainwaterJay"}, {"id": "1789164770312257536", "name": "TAC YAO | AI × Markets", "username": "tacyao_ai"}, {"id": "133486953", "name": "Tim Chiappe", "username": "TimChiappe"}, {"id": "180346953", "name": "Paulo Pierrondi | AI agents", "username": "paulopierrondi"}, {"id": "21230558", "name": "Sudheera", "username": "csudheera"}]}, "meta": {"newest_id": "2118496607088120276", "next_token": "b26v89c19zqg8o3juzlyxj8f0sv3xmikihp13m2iaawe5", "oldest_id": "2118466989043933665", "result_count": 25}}