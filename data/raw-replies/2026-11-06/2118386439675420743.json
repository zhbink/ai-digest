{"data": [{"author_id": "1420171076", "created_at": "2026-11-06T00:53:11.000Z", "edit_history_tweet_ids": ["2118506949360947585"], "id": "2118506949360947585", "in_reply_to_user_id": "1420171076", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118446771747819908", "type": "replied_to"}], "text": "@OpenAIDevs Open❣️❣️❣️\nTriforce▲▽✨", "url": "https://x.com/TomokunTT/status/2118506949360947585"}, {"author_id": "1181303386576019456", "created_at": "2026-11-05T21:46:44.000Z", "edit_history_tweet_ids": ["2118460028621648282"], "id": "2118460028621648282", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs Some Hi Tech Shadow Robots are flying in the sky of San Francisco for about 4 months. The Hi Tech Shadow Robots can watch the people to know the thinking of the people.\nhttps://t.co/VHgRGR7elf", "url": "https://x.com/Patrick17664373/status/2118460028621648282"}, {"author_id": "1457141796140617734", "created_at": "2026-11-05T21:29:37.000Z", "edit_history_tweet_ids": ["2118455719796375680"], "id": "2118455719796375680", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs that sounds cool", "url": "https://x.com/Yap452/status/2118455719796375680"}, {"author_id": "1420171076", "created_at": "2026-11-05T20:54:03.000Z", "edit_history_tweet_ids": ["2118446771747819908"], "id": "2118446771747819908", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 18, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs The door to a safe future: Recovery was the only way.\nPrivacy. Security.\nFor years, we continued to demand that it be opened. Now is the time to open it.", "url": "https://x.com/TomokunTT/status/2118446771747819908"}, {"author_id": "1009046018581827585", "created_at": "2026-11-05T20:51:02.000Z", "edit_history_tweet_ids": ["2118446009315733881"], "id": "2118446009315733881", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs Ok but what actually leaves my environment when the safety agent flags something? Just a verdict, or a snippet of the request too?", "url": "https://x.com/realtatendazhou/status/2118446009315733881"}, {"author_id": "1940127311619399680", "created_at": "2026-11-05T19:27:09.000Z", "edit_history_tweet_ids": ["2118424901803774108"], "id": "2118424901803774108", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs Setup gotcha from the PSP guide: it's enabled per project and then covers all API traffic in that project. Want plain ZDR for some models? The guide says route them through a separate project. And your storage must keep the encrypted records at least 30 days.", "url": "https://x.com/411apt/status/2118424901803774108"}, {"author_id": "1476313860395175939", "created_at": "2026-11-05T19:24:06.000Z", "edit_history_tweet_ids": ["2118424133453205932"], "id": "2118424133453205932", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs https://t.co/XJp4hYtUWt", "url": "https://x.com/geizy25_l/status/2118424133453205932"}, {"author_id": "2036299031195033601", "created_at": "2026-11-05T19:15:00.000Z", "edit_history_tweet_ids": ["2118421845439647744"], "id": "2118421845439647744", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs Keeping the records in your own environment is the right call", "url": "https://x.com/Marcellhazzard/status/2118421845439647744"}, {"author_id": "19610743", "created_at": "2026-11-05T19:03:16.000Z", "edit_history_tweet_ids": ["2118418889529033093"], "id": "2118418889529033093", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs \"without retaining\" doing a lot of work in that sentence", "url": "https://x.com/sklyarov/status/2118418889529033093"}, {"author_id": "2102318912625094656", "created_at": "2026-11-05T18:58:39.000Z", "edit_history_tweet_ids": ["2118417729732698122"], "id": "2118417729732698122", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 0, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs This clears the biggest hurdle for teams under strict compliance like HIPAA. Curious what the compute footprint looks like for running that safety agent locally.", "url": "https://x.com/JohnKocdr/status/2118417729732698122"}, {"author_id": "2106828559897460736", "created_at": "2026-11-05T18:56:50.000Z", "edit_history_tweet_ids": ["2118417272289014150"], "id": "2118417272289014150", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 1, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs Keeping records in the customer environment is the detail that matters. Question: can the automated safety agent escalate without ever exposing the prompt to a human?", "url": "https://x.com/TheLateBuild/status/2118417272289014150"}, {"author_id": "1888409028453416960", "created_at": "2026-11-05T18:39:33.000Z", "edit_history_tweet_ids": ["2118412920715624594"], "id": "2118412920715624594", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 71, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs wait so with psp i'm the one storing the records for 30 days?", "url": "https://x.com/ShubhamMal72313/status/2118412920715624594"}, {"author_id": "46498861", "created_at": "2026-11-05T18:22:17.000Z", "edit_history_tweet_ids": ["2118408578499534901"], "id": "2118408578499534901", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs Privacy in this model depends on the promise that records never leave the environment. The question is how that promise is audited, because trust in safety processing will come from verification, not from a video.", "url": "https://x.com/raulnogales/status/2118408578499534901"}, {"author_id": "1032195487", "created_at": "2026-11-05T18:08:49.000Z", "edit_history_tweet_ids": ["2118405185940725983"], "id": "2118405185940725983", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs the clue was here all along", "url": "https://x.com/knowixbuilds/status/2118405185940725983"}, {"author_id": "162624081", "created_at": "2026-11-05T18:04:42.000Z", "edit_history_tweet_ids": ["2118404150274998364"], "id": "2118404150274998364", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 41, "like_count": 6, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs So the logs OpenAI doesn't want to hold now live in my infra, with my retention policy and my name on the breach report. Privacy feature or liability transfer?", "url": "https://x.com/pggalaviz/status/2118404150274998364"}, {"author_id": "1690574518903840768", "created_at": "2026-11-05T17:52:39.000Z", "edit_history_tweet_ids": ["2118401119005384754"], "id": "2118401119005384754", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 24, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs does that agent actually run on your box or just on encrypted blobs they host", "url": "https://x.com/atomicbyte_/status/2118401119005384754"}, {"author_id": "2108719648577581057", "created_at": "2026-11-05T17:47:00.000Z", "edit_history_tweet_ids": ["2118399697207607455"], "id": "2118399697207607455", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs No-retention safety review is a big deal for teams handling sensitive prompts — the question is which requests get flagged for review and whether customers get any signal when it happens. Any detail on the selection criteria?", "url": "https://x.com/knightleijun/status/2118399697207607455"}, {"author_id": "1661276982573690880", "created_at": "2026-11-05T17:43:53.000Z", "edit_history_tweet_ids": ["2118398911786398155"], "id": "2118398911786398155", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs 坐等astra发布", "url": "https://x.com/meow2149/status/2118398911786398155"}, {"author_id": "2688209729", "created_at": "2026-11-05T17:43:34.000Z", "edit_history_tweet_ids": ["2118398831524241674"], "id": "2118398831524241674", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs Can PSP storage read/write failures trigger a webhook? The guide says a runtime failure may leave the status at “validated”; that seems important for alerting.", "url": "https://x.com/ara_que/status/2118398831524241674"}, {"author_id": "1817651920531775488", "created_at": "2026-11-05T17:40:19.000Z", "edit_history_tweet_ids": ["2118398014528397559"], "id": "2118398014528397559", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 16, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs keeping the records in your own environment is a nice touch.", "url": "https://x.com/jdn1el/status/2118398014528397559"}, {"author_id": "2085749917918826496", "created_at": "2026-11-05T17:35:42.000Z", "edit_history_tweet_ids": ["2118396855688081684"], "id": "2118396855688081684", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 9, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs the part where your own agent quarantines the bad ones and nobody at openai ever sees the prompt is the kind of default that takes five years of customer tickets to arrive at", "url": "https://x.com/TheRawMechanics/status/2118396855688081684"}, {"author_id": "1529990445241192458", "created_at": "2026-11-05T17:35:30.000Z", "edit_history_tweet_ids": ["2118396805209825351"], "id": "2118396805209825351", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 23, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs private safety processing is the quiet one. safety agent reviews encrypted records in your environment, openai people never see the prompts. zero data retention shops finally get a path that isn't \"trust us\"", "url": "https://x.com/YousseFathallaX/status/2118396805209825351"}, {"author_id": "1247530902554472452", "created_at": "2026-11-05T17:31:39.000Z", "edit_history_tweet_ids": ["2118395835881042395"], "id": "2118395835881042395", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 18, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs With no OpenAI staff able to read the content, a false positive has no human to appeal to. That's the part enterprise legal teams will poke at first.", "url": "https://x.com/jimmyyangrz/status/2118395835881042395"}, {"author_id": "2117505169097474049", "created_at": "2026-11-05T17:30:58.000Z", "edit_history_tweet_ids": ["2118395661842624631"], "id": "2118395661842624631", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs so the safety agent runs inside the customer's own environment. when it flags something, does openai see the flagged request or just a verdict? that's the part that decides whether this is really zero retention.", "url": "https://x.com/kashish_patel95/status/2118395661842624631"}, {"author_id": "1322477401", "created_at": "2026-11-05T17:28:35.000Z", "edit_history_tweet_ids": ["2118395062065455116"], "id": "2118395062065455116", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"bookmark_count": 0, "impression_count": 5, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "referenced_tweets": [{"id": "2118386439675420743", "type": "replied_to"}], "text": "@OpenAIDevs For teams setting this up, I’d put the 30-day customer-storage requirement right beside “ZDR.” Someone still owns the bucket lifecycle and key permissions, even though OpenAI isn’t retaining a copy.", "url": "https://x.com/progerallworld/status/2118395062065455116"}], "includes": {"tweets": [{"author_id": "1420171076", "created_at": "2026-11-05T20:54:03.000Z", "edit_history_tweet_ids": ["2118446771747819908"], "id": "2118446771747819908", "in_reply_to_user_id": "1633874951508721686", "public_metrics": {"