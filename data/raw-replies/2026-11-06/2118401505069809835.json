{"data": [{"author_id": "2112272940951654402", "conversation_id": "2118401505069809835", "created_at": "2026-11-06T01:10:50.000Z", "edit_history_tweet_ids": ["2118511392453996633"], "id": "2118511392453996633", "public_metrics": {"bookmark_count": 0, "impression_count": 8, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml \"Refine your scene without starting over\" is the dubbing-booth dream. Fixing one line without re-recording the whole take is where most of the real hours go, in voice and in video.", "url": "https://x.com/pablogimenezz/status/2118511392453996633"}, {"author_id": "870951755965661184", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T21:37:15.000Z", "edit_history_tweet_ids": ["2118457640900763898"], "id": "2118457640900763898", "public_metrics": {"bookmark_count": 0, "impression_count": 11, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Giving more people the ability to bring their game ideas to life is what makes tools like this exciting.", "url": "https://x.com/Nely_Brooks/status/2118457640900763898"}, {"author_id": "1372212747883184132", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T21:32:44.000Z", "edit_history_tweet_ids": ["2118456505305587977"], "id": "2118456505305587977", "public_metrics": {"bookmark_count": 0, "impression_count": 17, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml 15 seconds of consistency before latent space collapse hits production", "url": "https://x.com/OPuzanov/status/2118456505305587977"}, {"author_id": "1805186799754485760", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T21:04:37.000Z", "edit_history_tweet_ids": ["2118449427702551015"], "id": "2118449427702551015", "public_metrics": {"bookmark_count": 0, "impression_count": 15, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml We benchmarked its capabilities on camera control. It ranks #1 on this benchmark that has 900K+ human judgements. Check out the results on: https://t.co/9If5sgJ9zi https://t.co/CGBvuPxgwO", "url": "https://x.com/RapidataAI/status/2118449427702551015"}, {"author_id": "2058054796100210689", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T20:42:24.000Z", "edit_history_tweet_ids": ["2118443836708147489"], "id": "2118443836708147489", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml https://t.co/bmJXFmlg7f", "url": "https://x.com/impactfactoryai/status/2118443836708147489"}, {"author_id": "2052222204558151680", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T20:24:14.000Z", "edit_history_tweet_ids": ["2118439266485436836"], "id": "2118439266485436836", "public_metrics": {"bookmark_count": 1, "impression_count": 36, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Gemini Omni 1.2 Flash is now in Runway 🔥\n\nCreate + edit videos up to 15s, with more natural dialogue and stronger consistency across shots.\n\nRefine your scene without starting over, then upscale straight to 4K.\n\nThis workflow just got 10x smoother.", "url": "https://x.com/Maviya6v/status/2118439266485436836"}, {"author_id": "1983929501773131776", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T20:23:13.000Z", "edit_history_tweet_ids": ["2118439012411298120"], "id": "2118439012411298120", "public_metrics": {"bookmark_count": 0, "impression_count": 25, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Could you please explain how the music here was created and added to the project so that the video clip aligns with it? How can this be done in practice using Google Omni?", "url": "https://x.com/caspsont/status/2118439012411298120"}, {"author_id": "1817798430007468032", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T19:37:55.000Z", "edit_history_tweet_ids": ["2118427610938245544"], "id": "2118427610938245544", "public_metrics": {"bookmark_count": 0, "impression_count": 13, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml 15-second edits with stronger dialogue consistency and a 4K path, all inside Runway. Editors are going to lean on this hard", "url": "https://x.com/QwenAIFans/status/2118427610938245544"}, {"author_id": "2001348654544846848", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T19:35:54.000Z", "edit_history_tweet_ids": ["2118427101418442989"], "id": "2118427101418442989", "public_metrics": {"bookmark_count": 0, "impression_count": 2, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Busy weekend ahead 🎉", "url": "https://x.com/Elizaveta_ai/status/2118427101418442989"}, {"author_id": "1958082451416473600", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T19:32:24.000Z", "edit_history_tweet_ids": ["2118426223139565937"], "id": "2118426223139565937", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Dialogue and cross-shot consistency in one edit pass is the part that matters for filmmakers — re-rolling a whole scene to fix one line is the old pain. Does Omni hold lip sync steady when you refine a scene without starting over, or does the dialogue drift with each pass?", "url": "https://x.com/Arxlankhana/status/2118426223139565937"}, {"author_id": "2103130442073616384", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T19:26:24.000Z", "edit_history_tweet_ids": ["2118424710241476746"], "id": "2118424710241476746", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml The 'refine without starting over' part matters more than the 15 seconds — iterative editing is where video tools usually fall apart. Does an edit keep the same character and voice locked across shots, or does each pass re-render and drift? That's the real test for usable scenes.", "url": "https://x.com/BMTestsAI/status/2118424710241476746"}, {"author_id": "1601974659322445824", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T19:07:39.000Z", "edit_history_tweet_ids": ["2118419993956335630"], "id": "2118419993956335630", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Being able to refine a shot by chatting instead of regenerating is huge. Curious how Omni holds consistency across multi-shot brand sequences.", "url": "https://x.com/Ty3_Buya/status/2118419993956335630"}, {"author_id": "1896668083101773824", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T18:33:46.000Z", "edit_history_tweet_ids": ["2118411465271210068"], "id": "2118411465271210068", "public_metrics": {"bookmark_count": 0, "impression_count": 6, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml 'Refine your scene without starting over' is the line that matters. When you edit one shot, does the dialogue timing and character look hold for the rest of the 15 seconds?", "url": "https://x.com/AdamTestsAI/status/2118411465271210068"}, {"author_id": "90957937", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T18:24:38.000Z", "edit_history_tweet_ids": ["2118409169086627869"], "id": "2118409169086627869", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Google's pricing is $0.07 a second, so a 15-second clip costs about a dollar — cheap enough to re-roll a product demo five times without thinking about render cost. I still can't tell whether an edit in Runway holds the rest of the scene steady or drifts the shots I liked. Which", "url": "https://x.com/sagivo/status/2118409169086627869"}, {"author_id": "2060363423171416068", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T18:18:05.000Z", "edit_history_tweet_ids": ["2118407517789167674"], "id": "2118407517789167674", "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Refining a scene without starting over from zero is the exact bridge between an AI toy and an actual commercial production workflow, testing the 15-second consistency tonight.", "url": "https://x.com/Mary_kreyn/status/2118407517789167674"}, {"author_id": "2084245314643599360", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T18:11:52.000Z", "edit_history_tweet_ids": ["2118405955528577383"], "id": "2118405955528577383", "public_metrics": {"bookmark_count": 0, "impression_count": 19, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml In-place edit without restarting the clip is the part that actually changes workflows. Consistency and dialogue matter less if every tweak forces a full regen from scratch.", "url": "https://x.com/NickyLi42/status/2118405955528577383"}, {"author_id": "1461585538532708356", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T18:04:54.000Z", "edit_history_tweet_ids": ["2118404203928236265"], "id": "2118404203928236265", "public_metrics": {"bookmark_count": 0, "impression_count": 76, "like_count": 1, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml I'm on this today", "url": "https://x.com/PryZmRuleZZ/status/2118404203928236265"}, {"author_id": "2093212147014938624", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T18:03:36.000Z", "edit_history_tweet_ids": ["2118403876277871028"], "id": "2118403876277871028", "public_metrics": {"bookmark_count": 0, "impression_count": 108, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml the screen glow in the right lens holds up in this close-up", "url": "https://x.com/Reelflow_AI/status/2118403876277871028"}, {"author_id": "2018991920173785088", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T17:59:15.000Z", "edit_history_tweet_ids": ["2118402780498899029"], "id": "2118402780498899029", "public_metrics": {"bookmark_count": 0, "impression_count": 4, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml The no-restart edit is the bit worth testing; 15 seconds keeps the demo honest", "url": "https://x.com/violetainsights/status/2118402780498899029"}, {"author_id": "1632565931976294401", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T17:55:24.000Z", "edit_history_tweet_ids": ["2118401812046749807"], "id": "2118401812046749807", "public_metrics": {"bookmark_count": 0, "impression_count": 144, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "@runwayml Excellent", "url": "https://x.com/CaptainHaHaa/status/2118401812046749807"}, {"author_id": "1001114465692200960", "conversation_id": "2118401505069809835", "created_at": "2026-11-05T17:54:11.000Z", "edit_history_tweet_ids": ["2118401507305590858"], "id": "2118401507305590858", "public_metrics": {"bookmark_count": 0, "impression_count": 1754, "like_count": 2, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Try it now: https://t.co/8SmJnj6nTS", "url": "https://x.com/runwayml/status/2118401507305590858"}], "includes": {"users": [{"id": "2112272940951654402", "name": "Pablo Giménez", "username": "pablogimenezz"}, {"id": "870951755965661184", "name": "Mr. Brooks Whale", "username": "Nely_Brooks"}, {"id": "1372212747883184132", "name": "Alex Puzanov ❤️ AI Factory", "username": "OPuzanov