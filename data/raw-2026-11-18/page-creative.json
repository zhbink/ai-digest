{"data": [{"author_id": "1504221988814049289", "conversation_id": "2122850281193148625", "created_at": "2026-11-18T00:32:02.000Z", "edit_history_tweet_ids": ["2122850281193148625"], "entities": {"urls": [{"description": "Microdramas made about $11 billion in 2025. How the format works, how the apps make money, what AI did to production costs, and where you can post your own.", "display_url": "krea.ai/blog/the-rise-…", "end": 237, "expanded_url": "https://www.krea.ai/blog/the-rise-of-microdramas", "images": [{"height": 1536, "url": "https://pbs.twimg.com/news_img/2122850289091022848/mmWbo6oa?format=jpg&name=orig", "width": 2736}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2122850289091022848/mmWbo6oa?format=jpg&name=150x150", "width": 150}], "start": 214, "status": 200, "title": "The Rise of Microdramas: Minute-Long Episodes Are Making Billions", "unwound_url": "https://www.krea.ai/blog/the-rise-of-microdramas", "url": "https://t.co/iLs5jW6lFP"}]}, "id": "2122850281193148625", "lang": "en", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 9, "impression_count": 763, "like_count": 13, "quote_count": 1, "reply_count": 1, "retweet_count": 2}, "text": "microdramas made about $11 billion last year.\n\nwith AI, series that used to cost $200K can now be created with 100x lower budgets and in just a few days.\n\nwe built a tool to explore this new format, learn more 👇 \n\nhttps://t.co/iLs5jW6lFP", "url": "https://x.com/krea_ai/status/2122850281193148625"}, {"attachments": {"media_keys": ["7_2122797805169197056"]}, "author_id": "39622874", "conversation_id": "2122797825410904576", "created_at": "2026-11-17T21:03:35.000Z", "edit_history_tweet_ids": ["2122797825410904576"], "entities": {"mentions": [{"end": 55, "id": "885220904761933824", "start": 43, "username": "MicrosoftAI"}], "urls": [{"display_url": "pic.x.com/ct5W6wO4Nq", "end": 291, "expanded_url": "https://x.com/fal/status/2122797825410904576/video/1", "media_key": "7_2122797805169197056", "