e": 2176000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122352040081063936/vid/avc1/1280x720/9k26171ROGZNhztG.mp4?tag=16"}, {"bit_rate": 288000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122352040081063936/vid/avc1/480x270/oKwAzfLfKXiXAwGs.mp4?tag=16"}], "width": 1920}], "tweets": [{"author_id": "1618975370488999936", "created_at": "2026-11-17T05:03:34.000Z", "edit_history_tweet_ids": ["2122556227486154882"], "id": "2122556227486154882", "public_metrics": {"bookmark_count": 4, "impression_count": 3014, "like_count": 20, "quote_count": 1, "reply_count": 8, "retweet_count": 0}, "text": "New edition of AI Compass is live 🧭 (Nov 16)\n\n- Qwen launches 2.4T Qwen4-Max MoE model at $1.5 and $4.5 per million\n- Perplexity launches Monitor API for scheduled web and page webhooks\n- Google rolls out interactive sites from sources in Gemini Notebook\n- California Department"}, {"attachments": {"media_keys": ["13_2122713568458276864"]}, "author_id": "750760186265083905", "created_at": "2026-11-17T15:29:57.000Z", "edit_history_tweet_ids": ["2122713860973150622"], "id": "2122713860973150622", "public_metrics": {"bookmark_count": 664, "impression_count": 361292, "like_count": 1120, "quote_count": 149, "reply_count": 573, "retweet_count": 79}, "text": "We are going to kill Venmo. To start, we’re giving you $100 to send to your friends with AI.\n\nVersine lets your AI send and receive money for you.\n\nWorks with ChatGPT, Claude, Muse, Instinct, or any AI you use.\n\nRecipients don’t need a Versine account - they can cash out straight https://t.co/Xzf4gM4PCy"}, {"attachments": {"media_keys": ["13_2122704491929808896"]}, "author_id": "1870923516675289088", "created_at": "2026-11-17T14:55:26.000Z", "edit_history_tweet_ids": ["2122705177203642485"], "entities": {"urls": [{"end": 329, "start": 306, "url": "https://t.co/En7mImniPl"}]}, "id": "2122705177203642485", "public_metrics": {"bookmark_count": 122, "impression_count": 19093, "like_count": 474, "quote_count": 3, "reply_count": 27, "retweet_count": 15}, "referenced_tweets": [{"id": "2121885449509851415", "type": "quoted"}], "text": "Gemini 4 Carbon , i mean the more i use it the more i think we are not using this model at 100%\n\nPrompt : convert this 2d to 3d so it did make my pelican 3d with swarms of hydrogen model \n\n&gt; carbon is best model to talk to\n&gt; understand my intent like fable\n&gt; have these 3d https://t.co/OqXiL2TMcU https://t.co/En7mImniPl"}, {"attachments": {"media_keys": ["13_2122315414076268544"]}, "author_id": "1187188692890333184", "created_at": "2026-11-16T13:17:04.000Z", "edit_history_tweet_ids": ["2122318031162647001"], "id": "2122318031162647001", "public_metrics": {"bookmark_count": 171, "impression_count": 482389, "like_count": 294, "quote_count": 105, "reply_count": 160, "retweet_count": 133}, "text": "Picking the next tool shouldn’t take a paragraph. \n\nWe built Karpo Decision. A family of six open-weight models, from 0.8B to 31B.Give it the context, a question, and the options. It returns a probability for each option in one forward pass. \n\nKarpo Decision 31B\n🏆 73.9 on https://t.co/ZyAT2sPaxF"}, {"attachments": {"media_keys": ["13_2122679795196518400"]}, "author_id": "1893653481858433024", "created_at": "2026-11-17T13:14:45.000Z", "edit_history_tweet_ids": ["2122679837131186372"], "id": "2122679837131186372", "public_metrics": {"bookmark_count": 571, "impression_count": 90767, "like_count": 369, "quote_count": 51, "reply_count": 82, "retweet_count": 27}, "text": "🚨 Introducing the world’s first High-Intent Lead Database.\n\n800M+ leads. Unique data points. One prompt.\n\nYour AI agents find the right people, uncover signals that matter, and identify the right moment to reach out.\n\nAvailable now via MCP or API. and within Gojiberry.\n\nWhile https://t.co/9xT6methQH"}, {"attachments": {"media_keys": ["13_2122659185003302913"]}, "author_id": "3363946175", "created_at": "2026-11-17T11:53:5