_metrics": {"bookmark_count": 1025, "impression_count": 575872, "like_count": 2513, "quote_count": 338, "reply_count": 234, "retweet_count": 261}, "text": "Meet Devin Bots.\n\nFrom writing firmware to merging thousands of PRs a week, a Devin Bot leads a team of agents to get the job done. https://t.co/MWfo3Csr6O"}, {"attachments": {"media_keys": ["13_2122757416714752000"]}, "author_id": "2072364740135841792", "created_at": "2026-11-17T18:23:11.000Z", "edit_history_tweet_ids": ["2122757457101681075"], "id": "2122757457101681075", "public_metrics": {"bookmark_count": 432, "impression_count": 76471, "like_count": 607, "quote_count": 41, "reply_count": 14, "retweet_count": 53}, "text": "eve is generally available with v1.0.\n\n•  Build agents on your own harness\n•  Ship multi-tenant, multiplayer agents\n•  Govern &amp; trace sessions with Agent Runs\n•  Render agent UIs via Next.js, Nuxt &amp; more\n\nRead the blog → https://t.co/z9FFQrpN8H https://t.co/sFcOIIdWAf"}, {"attachments": {"media_keys": ["13_2122754015175864320"]}, "author_id": "166138615", "created_at": "2026-11-17T18:11:11.000Z", "edit_history_tweet_ids": ["2122754439886905593"], "id": "2122754439886905593", "public_metrics": {"bookmark_count": 361, "impression_count": 78087, "like_count": 638, "quote_count": 40, "reply_count": 97, "retweet_count": 71}, "text": "LLMs have gotten more autonomous recently but when you give them a goal they often misunderstand you, work aimlessly, and waste your tokens.\n\nToday, we’re introducing Missions—the world’s first agentic swarm harness that can accomplish any goal you give them within set budget. https://t.co/IBx3kn1Jhx"}], "users": [{"id": "1965856473084473347", "name": "Google Antigravity", "profile_image_url": "https://pbs.twimg.com/profile_images/1990585614279049216/-Zz6T2nk_normal.png", "public_metrics": {"followers_count": 216370, "following_count": 20, "like_count": 144, "listed_count": 1531, "media_count": 231, "tweet_count": 463}, "username": "antigravity",