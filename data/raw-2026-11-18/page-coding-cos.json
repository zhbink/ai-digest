{"data": [{"attachments": {"media_keys": ["13_2122848582684270594"]}, "author_id": "1965856473084473347", "created_at": "2026-11-18T00:25:45.000Z", "edit_history_tweet_ids": ["2122848700233925006"], "id": "2122848700233925006", "public_metrics": {"bookmark_count": 23, "impression_count": 3781, "like_count": 65, "quote_count": 1, "reply_count": 5, "retweet_count": 2}, "text": "The Google AI Edge Gallery team built a 100% offline language learning app with Antigravity. They combined ASR, Gemma 4, and TTS SDKs, used Figma MCP to map designs to real code, and started it all with a drawing on paper. Watch how they went from idea to working app. https://t.co/TNpNyQQowS", "url": "https://x.com/antigravity/status/2122848700233925006"}, {"attachments": {"media_keys": ["13_2122796092068958208"]}, "author_id": "366289783", "created_at": "2026-11-17T20:57:19.000Z", "edit_history_tweet_ids": ["2122796245316149493"], "entities": {"mentions": [{"end": 262, "id": "74286565", "start": 252, "username": "Microsoft"}]}, "id": "2122796245316149493", "public_metrics": {"bookmark_count": 9, "impression_count": 5105, "like_count": 43, "quote_count": 7, "reply_count": 4, "retweet_count": 7}, "text": "With Replit Desktop, Agent can work with files in folders you share, build useful tools, and help turn local data into reports you can share through Replit’s cloud.\n\nAgent builds and runs apps locally, and each build runs in its own sandbox powered by @Microsoft Execution https://t.co/njKaUIogtX", "url": "https://x.com/Replit/status/2122796245316149493"}, {"attachments": {"media_keys": ["13_2122782095185686528"]}, "author_id": "1751810001751183361", "created_at": "2026-11-17T20:04:28.000Z", "edit_history_tweet_ids": ["2122782948453908927"], "entities": {"mentions": [{"end": 81, "id": "17468569", "start": 67, "username": "bryan_johnson"}], "urls": [{"end": 217, "start": 194, "url": "https://t.co/Z3GOEXx2jR"}]}, "id": "2122782948453908927", "public_metrics": {"bookmark_count": 72, "impression_count": 24126, "like_count": 284, "quote_count": 7, "reply_count": 21, "retweet_count": 24}, "referenced_tweets": [{"id": "2122737511684587551", "type": "quoted"}], "text": "\"This is like a weather app, and the weather is me.\"  \n\nHere’s how @bryan_johnson uses Devin Bots to ingest billions of data points into one synthesis of how he’s doing. https://t.co/ufIeTynfLZ https://t.co/Z3GOEXx2jR", "url": "https://x.com/cognition/status/2122782948453908927"}, {"attachments": {"media_keys": ["13_2122758542809526273"]}, "author_id": "366289783", "created_at": "2026-11-17T18:30:01.000Z", "edit_history_tweet_ids": ["2122759176288190724"], "id": "2122759176288190724", "public_metrics": {"bookmark_count": 221, "impression_count": 61555, "like_count": 198, "quote_count": 17, "reply_count": 19, "retweet_count": 25}, "text": "The leading observability platform wants $83,700/yr just to monitor your app and catch issues.\n\nSo Replit Missions built DataCat: https://t.co/u3AmCbhzff\n\n100% free.\n\nThis isn't a prototype. Agent swarms explored thousands of workflows in the leading observability platform and https://t.co/ECMa8WLdwu", "url": "https://x.com/Replit/status/2122759176288190724"}, {"author_id": "4686835494", "created_at": "2026-11-17T18:25:51.000Z", "edit_history_tweet_ids": ["2122758127968027108"], "entities": {"urls": [{"end": 69, "start": 46, "url": "https://t.co/UJy14cC8mt"}]}, "id": "2122758127968027108", "public_metrics": {"bookmark_count": 477, "impression_count": 80471, "like_count": 702, "quote_count": 6, "reply_count": 25, "retweet_count": 37}, "referenced_tweets": [{"id": "2122757457101681075", "type": "quoted"}], "text": "Introducing eve 1.0\n\nBuild production agents. https://t.co/UJy14cC8mt", "url": "https://x.com/vercel/status/2122758127968027108"}, {"author_id": "366289783", "created_at": "2026-11-17T18:13:09.000Z", "edit_history_tweet_ids": ["2122754933367955951"], "entities": {"urls": [{"end": 299, "start": 276, "url": "https://t.co/249aM33dMJ"}]}, "id": "2122754933367955951", "public_metrics": {"bookmark_count": 9, "impression_count": 4183, "like_count": 49, "quote_count": 5, "reply_count": 3, "retweet_count": 5}, "referenced_tweets": [{"id": "2122754439886905593", "type": "quoted"}], "text": "In 2024, Replit released the first generally available Agent. By 2025, it could work autonomously for over 200 minutes.\n\nToday, we’re pushing the frontier further with Replit Missions: an agent swarm harness that turns ambitious objectives into outcomes, working autonomously https://t.co/249aM33dMJ", "url": "https://x.com/Replit/status/2122754933367955951"}, {"attachments": {"media_keys": ["13_2122747282093453314"]}, "author_id": "1778383739925520384", "created_at": "2026-11-17T17:49:22.000Z", "edit_history_tweet_ids": ["2122748946561011720"], "id": "2122748946561011720", "public_metrics": {"bookmark_count": 6, "impression_count": 4311, "like_count": 38, "quote_count": 0, "reply_count": 7, "retweet_count": 2}, "text": "Playing around with drafts… https://t.co/5xmvTX21Zc", "url": "https://x.com/Lovable/status/2122748946561011720"}, {"attachments": {"media_keys": ["13_2122736117183344641"]}, "author_id": "1751810001751183361", "created_at": "2026-11-17T17:03:55.000Z", "edit_history_tweet_ids": ["2122737511684587551"], "id": "2122737511684587551", "public_metrics": {"bookmark_count": 1025, "impression_count": 575872, "like_count": 2513, "quote_count": 338, "reply_count": 234, "retweet_count": 261}, "text": "Meet Devin Bots.\n\nFrom writing firmware to merging thousands of PRs a week, a Devin Bot leads a team of agents to get the job done. https://t.co/MWfo3Csr6O", "url": "https://x.com/cognition/status/2122737511684587551"}, {"attachments": {"media_keys": ["13_2122514539291783168"]}, "author_id": "1965856473084473347", "created_at": "2026-11-17T02:18:11.000Z", "edit_history_tweet_ids": ["2122514607726043205"], "id": "2122514607726043205", "public_metrics": {"bookmark_count": 635, "impression_count": 224112, "like_count": 2399, "quote_count": 69, "reply_count": 281, "retweet_count": 116}, "text": "Seeing the love for the new Antigravity UI has been incredible, so we wanted to break down the full redesign. We rebuilt the interface from the ground up as a surface made for orchestrating multiple agents in parallel, giving you immediate visibility and complete control. https://t.co/5Ec3HSkRnA", "url": "https://x.com/antigravity/status/2122514607726043205"}], "includes": {"media": [{"duration_ms": 182869, "height": 2160, "media_key": "13_2122848582684270594", "preview_image_url": "https://pbs.twimg.com/amplify_video_thumb/2122848582684270594/img/Pcusy_qGXi8QSvjQ.jpg", "type": "video", "variants": [{"bit_rate": 288000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122848582684270594/vid/avc1/480x270/kOI4DiAPk0B6llPJ.mp4?tag=16"}, {"content_type": "application/x-mpegURL", "url": "https://video.twimg.com/amplify_video/2122848582684270594/pl/pUH5xlHz37PaysDY.m3u8?tag=16"}, {"bit_rate": 2176000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122848582684270594/vid/avc1/1280x720/4dA3OLiqgdL-A8EM.mp4?tag=16"}, {"bit_rate": 10368000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122848582684270594/vid/avc1/1920x1080/jBMIAbIH-FAVzDaL.mp4?tag=16"}, {"bit_rate": 832000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122848582684270594/vid/avc1/640x360/iVWnSoUFKU-DyQLO.mp4?tag=16"}], "width": 3840}, {"duration_ms": 40000, "height": 1080, "media_key": "13_2122796092068958208", "preview_image_url": "https://pbs.twimg.com/amplify_video_thumb/2122796092068958208/img/oEcKchURM6KS1vyP.jpg", "type": "video", "variants": [{"bit_rate": 256000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122796092068958208/vid/avc1/480x270/bg7GTlrsEBjVWNmb.mp4"}, {"bit_rate": 2176000, "content_type": "video/mp4", "url": "https://video.twimg.com/amplify_video/2122796092068958208/vid/av