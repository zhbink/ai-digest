55840", "type": "photo", "url": "https://pbs.twimg.com/media/HXTo-FkaAAAFfr5.png", "width": 1440}, {"height": 1080, "media_key": "3_2122517835251638272", "type": "photo", "url": "https://pbs.twimg.com/media/HXSyub-a4AA3uFy.png", "width": 1920}], "tweets": [{"attachments": {"media_keys": ["13_2122711002571792385"]}, "author_id": "2102654676168847360", "conversation_id": "2122713676511867009", "created_at": "2026-11-17T15:29:13.000Z", "edit_history_tweet_ids": ["2122713676511867009"], "entities": {"urls": [{"display_url": "pic.x.com/Ow5liGPduA", "end": 303, "expanded_url": "https://x.com/TokenWaveai/status/2122713676511867009/video/1", "media_key": "13_2122711002571792385", "start": 280, "url": "https://t.co/Ow5liGPduA"}]}, "id": "2122713676511867009", "lang": "en", "note_tweet": {"entities": {"urls": [{"display_url": "tokenwave-ai.github.io/swe-cowork-pag…", "end": 833, "expanded_url": "https://tokenwave-ai.github.io/swe-cowork-page/", "start": 810, "url": "https://t.co/vyddiAIGDE"}, {"display_url": "arxiv.org/abs/2611.20218", "end": 866, "expanded_url": "https://arxiv.org/abs/2611.20218", "start": 843, "url": "https://t.co/EPBQ5RjlGy"}, {"display_url": "github.com/TokenWave-AI/s…", "end": 898, "expanded_url": "https://github.com/TokenWave-AI/swe-cowork-bench", "start": 875, "url": "https://t.co/zU8wPB0Wir"}, {"display_url": "huggingface.co/papers/2611.20…", "end": 951, "expanded_url": "https://huggingface.co/papers/2611.20218", "start": 928, "url": "https://t.co/tAbAQZ4pKR"}]}, "text": "Can a coding agent take over a teammate’s work in progress?\n\nIntroducing SWE-CoWork, a benchmark for coding agents working as digital employees on long-horizon software engineering tasks.\n\nEach assignment starts with a short handoff in a simulated workplace modeled on real-world engineering workflows. Agents search task boards and versioned docs, ask teammates for missing details, and revise their code when a reply changes what needs to be built.\n\nOpen questions and confirmed requirements can both be lost before the agent hands the work back. SWE-CoWork lets us trace them through the conversation, the patch, and the tests.\n\n101 assignments across 101 real open-source repositories.\n26 simulated teammates per workplace.\n11 programming languages.\n12 application domains.\n17 workplace tools.\n\n🌐 Website: https://t.co/vyddiAIGDE\n📄 Paper: https://t.co/EPBQ5RjlGy\n💻 Code: https://t.co/zU8wPB0Wir\n🤗 Hugging Face Daily Papers: https://t.co/tAbAQZ4pKR (If you find it useful, we’d appreciate an upvote!)"}, "possibly_sensitive": false, "public_metrics": {"bookmark_count": 26, "impression_count": 20664, "like_count": 53, "quote_count": 16, "reply_count": 26, "retweet_count": 10}, "text": "Can a coding agent take over a teammate’s work in progress?\n\nIntroducing SWE-CoWork, a benchmark for coding agents working as digital employees on long-horizon software engineering tasks.\n\nEach assignment starts with a short handoff in a simulated workplace modeled on real-world https://t.co/Ow5liGPduA"}], "users": [{"id": "1315639147248246785", "name": "GitHub Projects Community", "profile_image_url": "https://pbs.twimg.com/profile_images/1679831765744259073/hoVtsOZ9_normal.jpg", "public_metrics": {"followers_count": 349265, "following_count": 67, "like_count": 23922, "listed_count": 1623, "media_count": 5585, "tweet_count": 14033}, "username": "GithubProjects", "verified": false}]}, "meta": {"newest_id": "2122796961267060872", "next_token": "b26v89c19zqg8o3juzow6jp6te6yv5qb3z9ailkcf28vx", "oldest_id": "2122517837927616949", "result_count": 10}}