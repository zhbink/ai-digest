{"data": [{"author_id": "162124540", "conversation_id": "2122825442021572838", "created_at": "2026-11-17T22:53:20.000Z", "edit_history_tweet_ids": ["2122825442021572838"], "entities": {"urls": [{"display_url": "x.com/chatgpt/status…", "end": 53, "expanded_url": "https://twitter.com/chatgpt/status/2122818162995634504", "start": 30, "url": "https://t.co/pmNfp0r1DQ"}]}, "id": "2122825442021572838", "lang": "en", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 202, "impression_count": 63669, "like_count": 450, "quote_count": 4, "reply_count": 42, "retweet_count": 20}, "referenced_tweets": [{"id": "2122818162995634504", "type": "quoted"}], "text": "ChatGPT for all things sales: https://t.co/pmNfp0r1DQ", "url": "https://x.com/gdb/status/2122825442021572838"}, {"author_id": "162124540", "conversation_id": "2122819528858161322", "created_at": "2026-11-17T22:29:50.000Z", "edit_history_tweet_ids": ["2122819528858161322"], "entities": {"urls": [{"description": "The discovery by security company Calif shows A.I.’s ability to find gaping security holes in popular software. The Java flaw could affect systems used by nearly all Fortune 500 companies.", "display_url": "nytimes.com/2026/11/17/us/…", "end": 173, "expanded_url": "https://www.nytimes.com/2026/11/17/us/politics/ai-security-bug-java.html", "images": [{"height": 1688, "url": "https://pbs.twimg.com/news_img/2122802281603301377/TrVLLTQM?format=jpg&name=orig", "width": 3000}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2122802281603301377/TrVLLTQM?format=jpg&name=150x150", "width": 150}], "start": 150, "status": 200, "title": "A.I. Helps Find Major Security Bug in Java, a Software Platform Vital to the Internet", "unwound_url": "https://www.nytimes.com/2026/11/17/us/politics/ai-security-bug-java.html", "url": "https://t.co/DtMftfZTp7"}]}, "id": "2122819528858161322", "lang": "en", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 28, "impression_count": 21210, "like_count": 275, "quote_count": 4, "reply_count": 45, "retweet_count": 29}, "text": "GPT-6 Cyber for helping further secure the internet, with a major security flaw in Java found by Calif, as part of our Patch the Planet initiative:   https://t.co/DtMftfZTp7", "url": "https://x.com/gdb/status/2122819528858161322"}, {"attachments": {"media_keys": ["13_2122818275163930624"]}, "author_id": "284333988", "conversation_id": "2122818500763009273", "created_at": "2026-11-17T22:25:45.000Z", "edit_history_tweet_ids": ["2122818500763009273"], "entities": {"mentions": [{"end": 19, "id": "1742923424056713217", "start": 4, "username": "GoogleAIStudio"}], "urls": [{"description": "The fastest path from prompt to production with Gemini", "display_url": "ai.studio/build", "end": 275, "expanded_url": "https://ai.studio/build", "images": [{"height": 630, "url": "https://pbs.twimg.com/news_img/2122441048538648576/pFO4p15g?format=jpg&name=orig", "width": 1200}, {"height": 150, "url": "https://pbs.twimg.com/news_img/2122441048538648576/pFO4p15g?format=jpg&name=150x150", "width": 150}], "start": 252, "status": 200, "title": "Google AI Studio", "unwound_url": "https://aistudio.google.com/social_preview/apps", "url": "https://t.co/YfsvnKkdox"}, {"display_url": "pic.x.com/SnwJM63a9Y", "end": 299, "expanded_url": "https://x.com/OfficialLoganK/status/2122818500763009273/video/1", "media_key": "13_2122818275163930624", "start": 276, "url": "https://t.co/SnwJM63a9Y"}]}, "id": "2122818500763009273", "lang": "en", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 180, "impression_count": 38809, "like_count": 805, "quote_count": 15, "reply_count": 88, "retweet_count": 51}, "text": "Big @GoogleAIStudio updates today : ) \n\n- Support for Custom Domains (buy it direct in AI Studio)\n- Build an Android App and download it to your phone through the Google Play store (US only for now)\n- Securely add AI to your Android Apps in AI Studio\n\nhttps://t.co/YfsvnKkdox https://t.co/SnwJM63a9Y", "url": "https://x.com/OfficialLoganK/status/2122818500763009273"}, {"author_id": "1605", "conversation_id": "2122798039899263456", "created_at": "2026-11-17T21:04:27.000Z", "edit_history_tweet_ids": ["2122798039899263456"], "entities": {"urls": [{"display_url": "x.com/thsottiaux/sta…", "end": 244, "expanded_url": "https://twitter.com/thsottiaux/status/2122753991000133943", "start": 221, "url": "https://t.co/KNjtDKRwj7"}]}, "id": "2122798039899263456", "lang": "en", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 338, "impression_count": 362832, "like_count": 5423, "quote_count": 83, "reply_count": 576, "retweet_count": 244}, "referenced_tweets": [{"id": "2122753991000133943", "type": "quoted"}], "text": "6.2 Sol and Astra are out.\n\nThese models can do amazing things and are very token-efficient; we hope people will get great value from them.\n\nIn particular, 6.2 Sol ultrafast is something I think people will really enjoy. https://t.co/KNjtDKRwj7", "url": "https://x.com/sama/status/2122798039899263456"}, {"attachments": {"media_keys": ["3_2122783830473924608"]}, "author_id": "186420551", "conversation_id": "2122784279604383914", "created_at": "2026-11-17T20:09:46.000Z", "edit_history_tweet_ids": ["2122784279604383914"], "entities": {"urls": [{"display_url": "pic.x.com/HhK1nwdOgl", "end": 297, "expanded_url": "https://x.com/ClementDelangue/status/2122784279604383914/photo/1", "media_key": "3_2122783830473924608", "start": 274, "url": "https://t.co/HhK1nwdOgl"}]}, "id": "2122784279604383914", "lang": "en", "note_tweet": {"entities": {"urls": [{"display_url": "huggingface.co/harness-hub/Qw…", "end": 435, "expanded_url": "http://huggingface.co/harness-hub/Qwen3.8-27B-pi-adapted", "start": 412, "url": "https://t.co/aH4cl2qnED"}, {"display_url": "huggingface.co/blog/harness-h…", "end": 472, "expanded_url": "https://huggingface.co/blog/harness-hub/harness-adapters", "start": 449, "url": "https://t.co/avSfF93K4V"}]}, "text": "Introducing Qwen3.8-27B-pi-adapted 🤗\n\nWe adapted Qwen's model specifically for the pi coding agent using reinforcement learning and a LoRA adapter.\n\nThe results, measured as pass@1:\n🚀 SWE-bench Pro (Hard 51): 29.4% → 62.7%\n💻 Terminal-Bench 2.1: 39.5% → 55.8%\n⚡ 55–62% fewer tool calls per task\n\nThis is the power of open models: you can adapt them to YOUR tools and YOUR use cases. Let’s build! 💛\n\nOpen weights: https://t.co/aH4cl2qnED\nMethodology: https://t.co/avSfF93K4V"}, "possibly_sensitive": false, "public_metrics": {"bookmark_count": 1533, "impression_count": 103581, "like_count": 2383, "quote_count": 48, "reply_count": 124, "retweet_count": 284}, "text": "Introducing Qwen3.8-27B-pi-adapted 🤗\n\nWe adapted Qwen's model specifically for the pi coding agent using reinforcement learning and a LoRA adapter.\n\nThe results, measured as pass@1:\n🚀 SWE-bench Pro (Hard 51): 29.4% → 62.7%\n💻 Terminal-Bench 2.1: 39.5% → 55.8%\n⚡ 55–62% fewer https://t.co/HhK1nwdOgl", "url": "https://x.com/ClementDelangue/status/2122784279604383914"}, {"author_id": "162124540", "conversation_id": "2122752345364935113", "created_at": "2026-11-17T18:02:52.000Z", "edit_history_tweet_ids": ["2122752345364935113"], "entities": {"urls": [{"display_url": "x.com/openai/status/…", "end": 144, "expanded_url": "https://twitter.com/openai/status/2122750124543926515", "start": 121, "url": "https://t.co/vHWUqCR11F"}]}, "id": "2122752345364935113", "lang": "en", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 139, "impression_count": 103407, "like_count": 2240, "quote_count": 13, "reply_count": 128, "retweet_count": 92}, "referenced_tweets": [{"id": "2122750124543926515", "type": "quoted"}], "text": "GPT-6.2 Astra &amp; Sol are here!\n\nIncredible at professional work and scientific research at much lower per-task costs. https://t.co/vHWUqCR11F", "url": "https://x.com/gdb/status/2122752345364935113"}, {"author_id": "162124540", "conversation_id": "2122740752556216515", "created_at": "2026-11-17T17:16:48.000Z", "edit_his