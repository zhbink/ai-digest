1512494080"]}, "author_id": "2010375649903656961", "conversation_id": "2122690574646185999", "created_at": "2026-11-17T13:57:25.000Z", "edit_history_tweet_ids": ["2122690574646185999"], "entities": {"hashtags": [{"end": 80, "start": 75, "tag": "AI视频"}, {"end": 90, "start": 81, "tag": "Seedance"}], "urls": [{"display_url": "pic.x.com/PqF1uIoQXL", "end": 114, "expanded_url": "https://x.com/Shadowell888/status/2122690574646185999/photo/1", "media_key": "3_2122690471512494080", "start": 91, "url": "https://t.co/PqF1uIoQXL"}]}, "id": "2122690574646185999", "lang": "zh", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 0, "impression_count": 3, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "Seedance 2.5 Flash开API：720p约$0.152/秒，官方称比旗舰便宜约34%、速度近2倍。个人推荐批量试镜先它，成片再上2.5。#AI视频 #Seedance https://t.co/PqF1uIoQXL", "url": "https://x.com/Shadowell888/status/2122690574646185999"}, {"author_id": "1789217551651835904", "conversation_id": "2122598110656696685", "created_at": "2026-11-17T07:50:00.000Z", "edit_history_tweet_ids": ["2122598110656696685"], "entities": {"hashtags": [{"end": 98, "start": 93, "tag": "AI视频"}, {"end": 103, "start": 99, "tag": "生视频"}, {"end": 108, "start": 104, "tag": "提示词"}]}, "id": "2122598110656696685", "lang": "zh", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 0, "impression_count": 142, "like_count": 1, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "做 AI 视频时，想让镜头更连贯，可以先把每个镜头的动作写清楚，再单独生成。\n\n比如：镜头1人物站立微笑，镜头2缓慢转身，镜头3看向镜头。\n\n分开生成再拼接，比一次性生成整段更稳定。\n\n#AI视频 #生视频 #提示词", "url": "https://x.com/kuibenge/status/2122598110656696685"}, {"author_id": "1596184218006069249", "conversation_id": "2122646240538382561", "created_at": "2026-11-17T11:01:15.000Z", "edit_history_tweet_ids": ["2122646240538382561"], "id": "2122646240538382561", "lang": "zh", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 0, "impression_count": 10, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "正在写一篇AI视频的审美提升方案的文章。其实目前Seedance 2.5的模型下，场景图的氛围感和一定的电影感前置提示词，决定了出来的质感。场景图尤其重要。", "url": "https://x.com/liangsi_x/status/2122646240538382561"}, {"attachments": {"media_keys": ["13_2122558782781943808"]}, "author_id": "1995806694493097984", "conversation_id": "2122558877560672599", "created_at": "2026-11-17T05:14:06.000Z", "edit_history_tweet_ids": ["2122558877560672599"], "entities": {"urls": [{"display_url": "pic.x.com/8CiEXSKzTO", "end": 135, "expanded_url": "https://x.com/Tiehan127/status/2122558877560672599/video/1", "media_key": "13_2122558782781943808", "start": 112, "url": "https://t.co/8CiEXSKzTO"}]}, "id": "2122558877560672599", "lang": "zh", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 0, "impression_count": 7, "like_count": 0, "quote_count": 0, "reply_count": 0, "retweet_count": 0}, "text": "🎬muse用简单文字就能出氛围感大片\n不用费劲堆大量复杂描述词，仅用极简的文字指令，就能生成极具独特影调的AI视频，效果比传统生视频模型省心太多。\n他应该是这个世界上，最自由最勇敢的人。\n#AI视频#Muse#AI原生影像 https://t.co/8CiEXSKzTO", "url": "https://x.com/Tiehan127/status/2122558877560672599"}, {"author_id": "1789217551651835904", "conversation_id": "2122552308844380593", "created_at": "2026-11-17T04:48:00.000Z", "edit_history_tweet_ids": ["2122552308844380593"], "entities": {"hashtags": [{"end": 102, "start": 97, "tag": "AI视频"}, {"end": 109, "start": 103, "tag": "生视频技巧"}, {"end": 114, "start": 110, "tag": "提示词"}]}, "id": "2122552308844380593", "lang": "zh", "possibly_sensitive": false, "public_metrics": {"bookmark_count": 0, "impression_count": 111, "like_count": 0, "quote_count": 0, "reply_count": 1, "retweet_count": 0}, "text": "最近总结了一个做 AI 视频的小流程：\n\n1. 先用文字把镜头顺序写清楚\n2. 每个镜头单独生成\n3. 最后再统一调光线和色调\n\n一次性生成整段视频目前还是容易崩，分镜生成再拼接反而更可控。\n\n#AI视频 #生视频技巧 #提示词", "url": "https://x.com/kuibenge/status/2122552308844380593"}, {"author_id": "1789217551651835904", "conversation_id": "2122537209395822682", "created_at": "2026-11-17T03:48:00.000Z", "edit_history_tweet_ids": ["2122537209395822682"], "entities": {"h